#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-limiter
# Demonio de alto rendimiento para supervisión y aplicación estricta de cuotas
# concurrentes SSH (OpenSSH) y Dropbear con mitigación escalonada (SIGTERM -> SIGKILL).
# ==============================================================================
set -euo pipefail

# ------------------------------------------------------------------------------
# Configuración y Parámetros del Demonio
# ------------------------------------------------------------------------------
CHECK_INTERVAL="${CHECK_INTERVAL:-3}"     # Segundos entre ciclos de inspección
GRACE_PERIOD="${GRACE_PERIOD:-1.5}"       # Tiempo de gracia entre SIGTERM y SIGKILL
PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
LOG_PREFIX="[ssh-limiter]"

log_msg() {
    local level="$1"
    shift
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "$timestamp $LOG_PREFIX [$level] $*"
}

# ------------------------------------------------------------------------------
# Manejo de señales para apagado limpio del demonio
# ------------------------------------------------------------------------------
RUNNING=true
cleanup() {
    log_msg "INFO" "Recibida señal de terminación. Deteniendo demonio limpiamente..."
    RUNNING=false
}

trap cleanup SIGTERM SIGINT SIGHUP

# ------------------------------------------------------------------------------
# Función para verificar si una cuenta ha expirado (soporta trials y estándar)
# ------------------------------------------------------------------------------
is_account_expired() {
    local user="$1"
    local now_epoch
    now_epoch=$(date +%s)

    # 1. Comprobar si es un trial registrado en trials.db
    local trials_db="/etc/vps-ssh-limiter/trials.db"
    if [[ -f "$trials_db" ]]; then
        local t_line
        t_line=$(grep "^${user}:" "$trials_db" 2>/dev/null | head -n1 || true)
        if [[ -n "$t_line" ]]; then
            local t_exp
            t_exp=$(echo "$t_line" | cut -d: -f2)
            if [[ -n "$t_exp" && "$t_exp" =~ ^[0-9]+$ && "$now_epoch" -ge "$t_exp" ]]; then
                return 0 # Expirado
            fi
        fi
    fi

    # 2. Comprobar mediante chage (cuentas estándar)
    if command -v chage >/dev/null 2>&1; then
        local expiry_raw
        expiry_raw=$(chage -l "$user" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$expiry_raw" && "$expiry_raw" != "never" && "$expiry_raw" != "nunca" ]]; then
            local expiry_epoch
            expiry_epoch=$(date -d "$expiry_raw" +%s 2>/dev/null || true)
            if [[ -n "$expiry_epoch" ]]; then
                if [[ "$now_epoch" -gt "$expiry_epoch" ]]; then
                    return 0 # Expirado
                fi
            fi
        fi
    fi
    return 1 # No expirado
}

# ------------------------------------------------------------------------------
# Limpieza automática de cuentas trial vencidas desde /etc/vps-ssh-limiter/trials.db
# ------------------------------------------------------------------------------
cleanup_expired_trials() {
    local trials_db="/etc/vps-ssh-limiter/trials.db"
    [[ -f "$trials_db" ]] || return 0

    local now_epoch
    now_epoch=$(date +%s)
    local tmp_db
    tmp_db=$(mktemp 2>/dev/null || echo "/tmp/trials.tmp.$$")
    local had_entries=false

    while IFS=: read -r t_user t_exp t_dur || [[ -n "$t_user" ]]; do
        [[ -z "$t_user" || "$t_user" =~ ^# ]] && continue
        had_entries=true
        if [[ -n "$t_exp" && "$t_exp" =~ ^[0-9]+$ && "$now_epoch" -ge "$t_exp" ]]; then
            log_msg "ALERT" "Cuenta trial vencida detectada: '$t_user' (${t_dur:-?}m). Procediendo a eliminación..."
            if [[ -x /usr/local/bin/ssh-userdel ]]; then
                /usr/local/bin/ssh-userdel "$t_user" >/dev/null 2>&1 || true
            else
                pkill -u "$t_user" -9 2>/dev/null || true
                userdel -f -r "$t_user" 2>/dev/null || userdel -f "$t_user" 2>/dev/null || true
            fi
            rm -f "/etc/vps-ssh-limiter/trials/ticket-${t_user}.txt" 2>/dev/null || true
            if [[ -f /etc/vps-ssh-limiter/passwords.db ]]; then
                sed -i "/^${t_user}:/d" /etc/vps-ssh-limiter/passwords.db 2>/dev/null || true
            fi
        else
            echo "${t_user}:${t_exp}:${t_dur}" >> "$tmp_db"
        fi
    done < "$trials_db"

    if [[ "$had_entries" == true && -f "$tmp_db" ]]; then
        mv -f "$tmp_db" "$trials_db" 2>/dev/null || rm -f "$tmp_db"
    else
        rm -f "$tmp_db" 2>/dev/null || true
    fi
}

# ------------------------------------------------------------------------------
# Función de mitigación escalonada para una lista de PIDs excedentes
# ------------------------------------------------------------------------------
terminate_pids_stepped() {
    local user="$1"
    local pids_to_kill=("$@")
    shift # Dejar solo los PIDs en $@ tras extraer el usuario
    local pids=("${@}")

    if [[ ${#pids[@]} -eq 0 ]]; then
        return 0
    fi

    # Paso 1: Enviar SIGTERM (15) para cierre controlado
    local active_targets=()
    for pid in "${pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "WARN" "Usuario '$user': Excedente detectado. Enviando SIGTERM (15) a PID $pid"
            kill -15 "$pid" 2>/dev/null || true
            active_targets+=("$pid")
        fi
    done

    if [[ ${#active_targets[@]} -eq 0 ]]; then
        return 0
    fi

    # Período de gracia pasivo
    sleep "$GRACE_PERIOD"

    # Paso 2: Evaluar si los procesos siguen activos y forzar con SIGKILL (9)
    for pid in "${active_targets[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            log_msg "ALERT" "Usuario '$user': PID $pid no respondió a SIGTERM tras ${GRACE_PERIOD}s. Forzando SIGKILL (9)"
            kill -9 "$pid" 2>/dev/null || true
        else
            log_msg "INFO" "Usuario '$user': PID $pid terminó correctamente con SIGTERM."
        fi
    done
}

# ------------------------------------------------------------------------------
# Contabilidad de Tráfico de Red y Consumo de Datos por Usuario
# ------------------------------------------------------------------------------
TRAFFIC_DB="/etc/vps-ssh-limiter/traffic.db"
STATE_DIR="/run/vps-ssh-limiter/pids"
mkdir -p "$STATE_DIR" "/etc/vps-ssh-limiter"

track_pid_traffic() {
    local user="$1"
    local pid="$2"
    if [[ -r "/proc/$pid/io" ]]; then
        local rb wb cur_total
        rb=$(awk '/rchar:/ {print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
        wb=$(awk '/wchar:/ {print $2}' "/proc/$pid/io" 2>/dev/null || echo 0)
        cur_total=$(( rb + wb ))
        
        local pid_file="${STATE_DIR}/${pid}"
        local last_seen=0
        if [[ -f "$pid_file" ]]; then
            last_seen=$(cat "$pid_file" 2>/dev/null || echo 0)
        fi

        if [[ $cur_total -gt $last_seen ]]; then
            local delta=$(( cur_total - last_seen ))
            echo "$cur_total" > "$pid_file"

            # Actualizar base de datos de tráfico persistente
            local cur_user_bytes=0
            if [[ -f "$TRAFFIC_DB" ]]; then
                local u_line
                u_line=$(grep "^${user}:" "$TRAFFIC_DB" 2>/dev/null | head -n1 || true)
                if [[ -n "$u_line" ]]; then
                    cur_user_bytes=$(echo "$u_line" | cut -d: -f2 || echo 0)
                    sed -i "s|^${user}:.*|${user}:$(( cur_user_bytes + delta )):$(date +%s)|g" "$TRAFFIC_DB"
                else
                    echo "${user}:${delta}:$(date +%s)" >> "$TRAFFIC_DB"
                fi
            else
                echo "${user}:${delta}:$(date +%s)" >> "$TRAFFIC_DB"
            fi
        fi
    fi
}

declare -A USER_ACTIVE_PIDS=()
declare -A USER_SURPLUS_STRIKES=()

load_all_user_connections() {
    USER_ACTIVE_PIDS=()

    # 1. PIDs por UID de usuario (filtrado estricto por proceso sshd o dropbear)
    while IFS=: read -r u _ uid _ _ _ _; do
        [[ $uid -lt 1000 || "$u" == "nobody" || "$u" == "nogroup" ]] && continue
        USER_ACTIVE_PIDS["$u"]=""
        for p in $(pgrep -u "$u" 2>/dev/null || true); do
            [[ -z "$p" || ! "$p" =~ ^[0-9]+$ || ! -d "/proc/$p" ]] && continue
            local comm=""
            [[ -r "/proc/$p/comm" ]] && comm=$(cat "/proc/$p/comm" 2>/dev/null || true)
            # Solo contabilizar procesos de conexión SSH reales (OpenSSH sshd o Dropbear)
            # Ignorar shells (ssh-tunnel-shell, bash), systemd (--user), sd-pam, etc.
            if [[ "$comm" == *"sshd"* ]]; then
                # En OpenSSH cada conexión autenticada crea un proceso unpriv para el usuario (ej: sshd: usuario@notty)
                # Ignorar [net] y [priv] para contabilizar exactamente 1 proceso por conexion real
                local cmdline=""
                [[ -r "/proc/$p/cmdline" ]] && cmdline=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null || true)
                if [[ "$cmdline" == *"[net]"* || "$cmdline" == *"[priv]"* ]]; then
                    continue
                fi
                local cur="${USER_ACTIVE_PIDS["$u"]:-}"
                if [[ ! " $cur " =~ " $p " ]]; then
                    USER_ACTIVE_PIDS["$u"]="${cur} $p"
                fi
            elif [[ "$comm" == *"dropbear"* ]]; then
                local cur="${USER_ACTIVE_PIDS["$u"]:-}"
                if [[ ! " $cur " =~ " $p " ]]; then
                    USER_ACTIVE_PIDS["$u"]="${cur} $p"
                fi
            elif [[ "$comm" == *"ssh-tunnel"* ]]; then
                # Shell de túnel restringido: verificar si su proceso padre es dropbear
                local ppid
                ppid=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 0)
                if [[ -n "$ppid" && "$ppid" -gt 1 && -d "/proc/$ppid" ]]; then
                    local pcomm
                    pcomm=$(cat "/proc/$ppid/comm" 2>/dev/null || true)
                    if [[ "$pcomm" == *"dropbear"* ]]; then
                        local cur="${USER_ACTIVE_PIDS["$u"]:-}"
                        if [[ ! " $cur " =~ " $ppid " && ! " $cur " =~ " $p " ]]; then
                            USER_ACTIVE_PIDS["$u"]="${cur} $ppid"
                        fi
                    fi
                fi
            fi
        done
    done < "$PASSWD_FILE"

    # 2. Conexiones Dropbear en modo túnel/port-forwarding (corren como root)
    local db_active=()
    for p in $(pgrep -x dropbear 2>/dev/null || true); do
        [[ -n "$p" && -d "/proc/$p" ]] && db_active+=("$p")
    done

    if [[ ${#db_active[@]} -gt 0 ]]; then
        local logs=""
        if command -v journalctl >/dev/null 2>&1; then
            logs=$(journalctl -u dropbear -n 500 --no-pager 2>/dev/null || true)
        fi
        if [[ -f /var/log/auth.log ]]; then
            local al
            al=$(tail -n 500 /var/log/auth.log 2>/dev/null | grep -i "dropbear" || true)
            logs="${logs}"$'\n'"${al}"
        fi

        while read -r line; do
            if [[ "$line" =~ dropbear\[([0-9]+)\]:.*auth\ succeeded\ for\ \'([^\']+)\' ]]; then
                local pid="${BASH_REMATCH[1]}"
                local user="${BASH_REMATCH[2]}"
                if [[ -d "/proc/$pid" ]]; then
                    local comm=""
                    [[ -r "/proc/$pid/comm" ]] && comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
                    if [[ "$comm" == *"dropbear"* ]]; then
                        local cur="${USER_ACTIVE_PIDS["$user"]:-}"
                        local already_has_child=false
                        for ep in $cur; do
                            local e_ppid
                            e_ppid=$(awk '{print $4}' "/proc/$ep/stat" 2>/dev/null || echo 0)
                            if [[ "$e_ppid" -eq "$pid" ]]; then
                                already_has_child=true
                                break
                            fi
                        done
                        if [[ "$already_has_child" == false && ! " $cur " =~ " $pid " ]]; then
                            USER_ACTIVE_PIDS["$user"]="${cur} $pid"
                        fi
                    fi
                fi
            fi
        done <<< "$logs"
    fi
}

# ------------------------------------------------------------------------------
# Ciclo Principal de Inspección (Bajo impacto de CPU < 1%)
# ------------------------------------------------------------------------------
log_msg "INFO" "Demonio ssh-limiter iniciado. Intervalo: ${CHECK_INTERVAL}s, Gracia: ${GRACE_PERIOD}s"

LOOP_TICK=0
while $RUNNING; do
    if [[ ! -r "$PASSWD_FILE" ]]; then
        log_msg "ERROR" "No se puede leer $PASSWD_FILE. Reintentando..."
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # Cargar mapa de conexiones universal
    load_all_user_connections

    # Purgar cuentas trial vencidas
    cleanup_expired_trials

    # Leer usuarios administrados con cuota LIM:<N> o UID >= 1000
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Salir inmediatamente si se recibió señal de apagado durante la lectura
        if ! $RUNNING; then break; fi
        [[ -z "$line" || "$line" =~ ^# ]] && continue

        u="${line%%:*}"
        [[ -z "$u" ]] && continue
        rest="${line#*:}"
        rest="${rest#*:}"
        uid="${rest%%:*}"

        limit=""
        if [[ "$line" =~ LIM[:_=-]?([0-9]+) ]]; then
            limit="${BASH_REMATCH[1]}"
        elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]]; then
            if [[ "$u" != "nobody" && "$u" != "nogroup" && "$u" != "ubuntu" && "$u" != "debian" ]]; then
                limit="1"
            fi
        fi

        if [[ -n "$limit" ]]; then
            username="$u"

            # Inspección universal de todos los procesos activos (Dropbear + OpenSSH)
            all_pids=()
            for p in ${USER_ACTIVE_PIDS["$username"]:-}; do
                if [[ -n "$p" && "$p" =~ ^[0-9]+$ && -d "/proc/$p" ]]; then
                    all_pids+=("$p")
                    track_pid_traffic "$username" "$p"
                fi
            done

            total_active=${#all_pids[@]}

            # Si no tiene conexiones activas, continuar al siguiente usuario
            if [[ $total_active -eq 0 ]]; then
                USER_SURPLUS_STRIKES["$username"]=0
                continue
            fi

            # ------------------------------------------------------------------
            # Caso 1: Cuenta expirada -> Desconexión total inmediata
            # ------------------------------------------------------------------
            if is_account_expired "$username"; then
                USER_SURPLUS_STRIKES["$username"]=0
                log_msg "ALERT" "Usuario expirado '$username' tiene $total_active conexión(es) activa(s). Procediendo a cierre total."
                terminate_pids_stepped "$username" "${all_pids[@]}"
                continue
            fi

            # ------------------------------------------------------------------
            # Caso 2: Concurrencia dentro de la cuota permitida
            # ------------------------------------------------------------------
            if [[ $total_active -le $limit ]]; then
                USER_SURPLUS_STRIKES["$username"]=0
                continue
            fi

            # ------------------------------------------------------------------
            # Caso 3: Concurrencia excedida -> Mitigación escalonada con anti-bucle
            # ------------------------------------------------------------------
            surplus_count=$((total_active - limit))

            # Protección contra bucle de reconexión rápida (debouncing):
            # Durante reconexiones en apps móviles (como HTTP Custom), la sesión previa puede
            # tardar 1-2 segundos en terminar de liberarse en el kernel (TCP FIN/WAIT).
            # Conceder 1 ciclo de gracia (3s) para verificar si persiste antes de matar.
            strikes="${USER_SURPLUS_STRIKES["$username"]:-0}"
            if [[ $strikes -eq 0 ]]; then
                USER_SURPLUS_STRIKES["$username"]=1
                log_msg "WARN" "Aviso para '$username': $total_active activas vs $limit permitidas (posible solapamiento de reconexión). Verificando en próximo ciclo..."
                continue
            fi

            USER_SURPLUS_STRIKES["$username"]=0
            log_msg "WARN" "Límite excedido confirmado para usuario '$username': $total_active activas vs $limit permitidas (Excedente: $surplus_count)"

            # Obtener lista de PIDs ordenados por tiempo de vida transcurrido (etimes)
            # ps -o pid=,etimes= -p <pids> --sort=etimes
            # --sort=etimes lista de MENOR a MAYOR tiempo (los más recientes arriba)
            pids_csv=$(IFS=,; echo "${all_pids[*]}")
            
            # Clasificar procesos por etimes ascendente (sesiones vivas recientes primero)
            ranked_pids=()
            while read -r r_pid r_etime; do
                if [[ -n "$r_pid" && "$r_pid" =~ ^[0-9]+$ ]]; then
                    ranked_pids+=("$r_pid")
                fi
            done < <(ps -o pid=,etimes= -p "$pids_csv" --sort=etimes 2>/dev/null || true)

            # Si ps fallara por alguna razón, respaldar con el orden original
            if [[ ${#ranked_pids[@]} -eq 0 ]]; then
                ranked_pids=("${all_pids[@]}")
            fi

            # Preservar las primeras $limit sesiones más RECIENTES (índices 0 a limit-1)
            # Identificar los PIDs excedentes (sesiones antiguas / zombis residuales) desde el índice limit en adelante
            surplus_pids=()
            for (( i=limit; i<${#ranked_pids[@]}; i++ )); do
                surplus_pids+=("${ranked_pids[i]}")
            done

            # Aplicar mitigación escalonada a los procesos excedentes
            if [[ ${#surplus_pids[@]} -gt 0 ]]; then
                terminate_pids_stepped "$username" "${surplus_pids[@]}"
            fi
        fi
    done < "$PASSWD_FILE"

    # Refrescar datos y consumo en banners individuales cada ~60 segundos (20 ciclos x 3s)
    LOOP_TICK=$(( (LOOP_TICK + 1) % 20 ))
    if [[ $LOOP_TICK -eq 0 ]]; then
        if [[ -x /usr/local/bin/ssh-banner ]]; then
            /usr/local/bin/ssh-banner --refresh >/dev/null 2>&1 || true
        elif [[ -x /etc/vps-ssh-limiter/bin/ssh-banner ]]; then
            /etc/vps-ssh-limiter/bin/ssh-banner --refresh >/dev/null 2>&1 || true
        fi
    fi

    # Pausa pasiva para mantener el uso de CPU por debajo del 1%
    sleep "$CHECK_INTERVAL"
done

log_msg "INFO" "Demonio ssh-limiter finalizado."
exit 0
