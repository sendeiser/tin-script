#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-update
# Actualizador automático desde GitHub con preservación de cuentas y configuraciones.
# ==============================================================================
set -euo pipefail

CURRENT_VERSION="2.2.11"
VERSION_FILE="/etc/vps-ssh-limiter/version"
if [[ -f "$VERSION_FILE" ]]; then
    CURRENT_VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
fi

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_MAGENTA="\033[1;35m"
    C_CYAN="\033[1;36m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_MAGENTA=""
    C_CYAN=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

FORCE_UPDATE=false
RELOAD_MENU=false

for arg in "$@"; do
    case "$arg" in
        --force|-f) FORCE_UPDATE=true ;;
        --reload-menu) RELOAD_MENU=true ;;
        -h|--help)
            cat <<EOF
Uso: ssh-update [OPCIONES]

Opciones:
    --force, -f      Fuerza la reinstalación/actualización sin confirmación interactiva.
    --reload-menu    Recarga automáticamente el menú interactivo tras actualizar.
    -h, --help       Muestra esta ayuda.
EOF
            exit 0
            ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Debe ejecutarse con permisos de superusuario: ${C_BOLD}sudo update${C_RESET}" >&2
    exit 1
fi

echo -e "\n${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
echo -e "${C_CYAN}║${C_RESET}   ${C_BOLD}${C_WHITE}★ ACTUALIZADOR VPS-SSH-LIMITER ★${C_RESET}    ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"

echo -e " ${C_BOLD}Versión instalada:${C_RESET} ${C_YELLOW}v${CURRENT_VERSION}${C_RESET}"
echo -e "${C_GRAY} Comprobando última versión en GitHub...${C_RESET}"

REMOTE_VERSION=""
TIMESTAMP=$(date +%s)
REMOTE_VERSION=$(curl -fsSL -m 8 "https://raw.githubusercontent.com/sendeiser/tin-script/main/version?v=${TIMESTAMP}" 2>/dev/null | tr -d '[:space:]' || true)

if [[ ! "$REMOTE_VERSION" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    echo -e "${C_YELLOW}[AVISO]${C_RESET} No se pudo consultar la versión remota (o respuesta inválida)."
    REMOTE_VERSION="$CURRENT_VERSION"
else
    echo -e " ${C_BOLD}Versión en GitHub:${C_RESET}   ${C_GREEN}v${REMOTE_VERSION}${C_RESET}"
fi

if [[ "$CURRENT_VERSION" == "$REMOTE_VERSION" && "$FORCE_UPDATE" != true ]]; then
    echo -e "\n${C_GREEN}✔ Ya cuentas con la versión más reciente (v${CURRENT_VERSION}).${C_RESET}"
    force_ans=""
    read -r -p "¿Deseas forzar la reinstalación de todos modos? [s/N]: " force_ans || true
    if [[ ! "${force_ans:-}" =~ ^[sS]$ ]]; then
        echo -e "${C_GRAY}Operación finalizada sin cambios.${C_RESET}\n"
        exit 0
    fi
elif [[ "$CURRENT_VERSION" != "$REMOTE_VERSION" ]]; then
    echo -e "\n${C_YELLOW}${C_BOLD}★ ¡NUEVA ACTUALIZACIÓN DISPONIBLE: v${REMOTE_VERSION}! ★${C_RESET}"
    if [[ "$FORCE_UPDATE" != true ]]; then
        update_ans=""
        read -r -p "¿Deseas instalar la nueva versión ahora? [S/n]: " update_ans || true
        if [[ "${update_ans:-}" =~ ^[nN]$ ]]; then
            echo -e "${C_YELLOW}Actualización pospuesta por el usuario.${C_RESET}\n"
            exit 0
        fi
    fi
fi

echo -e "\n${C_CYAN}[1/3] Descargando el instalador de la nueva versión...${C_RESET}"
INSTALLER_URL="https://raw.githubusercontent.com/sendeiser/tin-script/main/install.sh?v=${TIMESTAMP}"
TMP_INSTALLER=$(mktemp /tmp/tin_install.XXXXXX.sh)

if ! curl -fsSL "$INSTALLER_URL" -o "$TMP_INSTALLER"; then
    echo -e "${C_RED}[ERROR]${C_RESET} Falló la descarga del instalador desde GitHub." >&2
    rm -f "$TMP_INSTALLER"
    exit 1
fi

chmod +x "$TMP_INSTALLER"

echo -e "${C_CYAN}[2/3] Aplicando actualización en el sistema...${C_RESET}"
bash "$TMP_INSTALLER"

mkdir -p /etc/vps-ssh-limiter
echo "${REMOTE_VERSION:-$CURRENT_VERSION}" > "$VERSION_FILE"
rm -f "$TMP_INSTALLER"

echo -e "\n${C_GREEN}${C_BOLD}✔ ¡VPS-SSH-LIMITER HA SIDO ACTUALIZADO EXITOSAMENTE A LA VERSIÓN v${REMOTE_VERSION:-$CURRENT_VERSION}!${C_RESET}\n"

if [[ "$RELOAD_MENU" == true ]]; then
    echo -e "${C_GRAY}Recargando el menú en 2 segundos...${C_RESET}"
    sleep 2
    exec /usr/local/bin/menu
fi

exit 0
