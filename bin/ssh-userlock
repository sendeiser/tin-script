#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-userlock
# Bloqueo y desbloqueo temporal de cuentas de usuario con expulsión de sesiones.
# ==============================================================================
set -euo pipefail

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BOLD=""
    C_GRAY=""
fi

show_help() {
    cat <<EOF
${C_BOLD}Uso:${C_RESET}
    ssh-userlock <usuario> [ACCION]

${C_BOLD}Acciones:${C_RESET}
    lock       Bloquea la cuenta impidiendo el acceso y cierra de inmediato sus sesiones activas.
    unlock     Desbloquea la cuenta permitiendo nuevas conexiones.
    status     Muestra si la cuenta se encuentra bloqueada o activa.
    -h, --help Muestra esta ayuda.

${C_BOLD}Ejemplo:${C_RESET}
    sudo ssh-userlock juan lock
    sudo ssh-userlock juan unlock
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Este script debe ejecutarse con privilegios de superusuario (root)." >&2
    exit 1
fi

if [[ $# -lt 1 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Debe especificar el nombre de usuario." >&2
    show_help >&2
    exit 1
fi

USERNAME="$1"
ACTION="${2:-status}"

if ! id "$USERNAME" >/dev/null 2>&1; then
    echo -e "${C_RED}[ERROR]${C_RESET} El usuario '$USERNAME' no existe en el sistema." >&2
    exit 1
fi

is_locked() {
    local status_line
    status_line=$(passwd -S "$USERNAME" 2>/dev/null || true)
    if [[ "$status_line" =~ \ L\  ]]; then
        return 0 # Bloqueado
    fi
    return 1 # Desbloqueado
}

case "$ACTION" in
    lock)
        passwd -l "$USERNAME" >/dev/null 2>&1
        # Expulsar de inmediato cualquier conexión en curso
        pkill -u "$USERNAME" -9 2>/dev/null || true
        echo -e "${C_GREEN}✔ Cuenta de '$USERNAME' bloqueada exitosamente.${C_RESET} Conexiones activas cerradas."
        ;;
    unlock)
        passwd -u "$USERNAME" >/dev/null 2>&1
        echo -e "${C_GREEN}✔ Cuenta de '$USERNAME' desbloqueada exitosamente.${C_RESET}"
        ;;
    status)
        if is_locked; then
            echo -e "Estado de '${USERNAME}': ${C_RED}${C_BOLD}[BLOQUEADO]${C_RESET}"
        else
            echo -e "Estado de '${USERNAME}': ${C_GREEN}${C_BOLD}[ACTIVO / DESBLOQUEADO]${C_RESET}"
        fi
        ;;
    *)
        echo -e "${C_RED}[ERROR]${C_RESET} Acción desconocida '$ACTION'. Use 'lock', 'unlock' o 'status'." >&2
        exit 1
        ;;
esac

exit 0
