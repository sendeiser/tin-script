#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-useradd
# Creador de cuentas de usuario restringidas para túneles SSH y Dropbear
# con persistencia de límites en GECOS y fecha de expiración automática.
# ==============================================================================
set -euo pipefail

# ------------------------------------------------------------------------------
# Configuración visual (colores y formato)
# ------------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_CYAN="\033[1;36m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_CYAN=""
    C_BOLD=""
    C_GRAY=""
fi

show_help() {
    cat <<EOF
${C_BOLD}Uso:${C_RESET}
    ssh-useradd <usuario> <contraseña> <días_validez> <límite_conexiones>

${C_BOLD}Descripción:${C_RESET}
    Crea una cuenta restringida en el sistema con shell segura para túneles (ssh-tunnel-shell)
    sin directorio /home (/nonexistent), orientada exclusivamente a túneles SSH y
    Dropbear. Asigna fecha de expiración del sistema y almacena de forma atómica
    la cuota de conexiones simultáneas en el campo GECOS de /etc/passwd (LIM:<N>).

${C_BOLD}Parámetros:${C_RESET}
    <usuario>            Nombre del usuario (alfanumérico, 3 a 32 caracteres).
    <contraseña>         Contraseña de acceso para el usuario.
    <días_validez>       Días de vigencia de la cuenta a partir de hoy (entero >= 1).
    <límite_conexiones>  Máximo de conexiones concurrentes permitidas (entero >= 1).

${C_BOLD}Ejemplo:${C_RESET}
    sudo ssh-useradd juan pass123 30 2
EOF
}

# ------------------------------------------------------------------------------
# Verificaciones previas
# ------------------------------------------------------------------------------
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Este script debe ejecutarse con privilegios de superusuario (root)." >&2
    exit 1
fi

if [[ $# -ne 4 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Argumentos insuficientes o inválidos." >&2
    show_help >&2
    exit 1
fi

USERNAME="$1"
PASSWORD="$2"
DAYS="$3"
LIMIT="$4"

# Validación de nombre de usuario (3 a 32 caracteres, letras, números, guion bajo o medio)
if [[ ! "$USERNAME" =~ ^[a-zA-Z0-9_-]{3,32}$ ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} El nombre de usuario '$USERNAME' es inválido. Debe contener entre 3 y 32 caracteres alfanuméricos." >&2
    exit 1
fi

# Validación de contraseña no vacía
if [[ -z "$PASSWORD" ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} La contraseña no puede estar vacía." >&2
    exit 1
fi

# Validación de días
if [[ ! "$DAYS" =~ ^[0-9]+$ ]] || [[ "$DAYS" -lt 1 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Los días de validez deben ser un número entero mayor o igual a 1." >&2
    exit 1
fi

# Validación de límite de conexiones
if [[ ! "$LIMIT" =~ ^[0-9]+$ ]] || [[ "$LIMIT" -lt 1 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} El límite de conexiones simultáneas debe ser un número entero mayor o igual a 1." >&2
    exit 1
fi

# Comprobar si el usuario ya existe en el sistema
if id "$USERNAME" >/dev/null 2>&1; then
    echo -e "${C_RED}[ERROR]${C_RESET} El usuario '$USERNAME' ya existe en el sistema." >&2
    exit 1
fi

# ------------------------------------------------------------------------------
# Creación de usuario y asignación de parámetros
# ------------------------------------------------------------------------------
# Calcular fecha de expiración en formato ISO (YYYY-MM-DD)
EXPIRY_DATE=$(date -d "+${DAYS} days" +%Y-%m-%d 2>/dev/null || date -v "+${DAYS}d" +%Y-%m-%d)
GECOS_VALUE="LIM:${LIMIT}"
RESTRICTED_SHELL="/usr/local/bin/ssh-tunnel-shell"

# Asegurar que la shell restringida exista en el sistema
if [[ ! -x "$RESTRICTED_SHELL" ]]; then
    if [[ -x "/bin/ssh-tunnel-shell" ]]; then
        RESTRICTED_SHELL="/bin/ssh-tunnel-shell"
    elif [[ -x "/bin/false" ]]; then
        RESTRICTED_SHELL="/bin/false"
    else
        RESTRICTED_SHELL="/usr/sbin/nologin"
    fi
fi

# Asegurar que la shell esté autorizada en /etc/shells para autenticación PAM
if [[ -f /etc/shells ]] && ! grep -Fxq "$RESTRICTED_SHELL" /etc/shells 2>/dev/null; then
    echo "$RESTRICTED_SHELL" >> /etc/shells
fi

# Intentar crear el usuario con el formato solicitado LIM:$LIMIT
# Si la versión de shadow-utils del sistema rechaza ':' por ser delimitador de /etc/passwd,
# se utiliza LIM-$LIMIT como fallback transparente 100% compatible.
GECOS_VALUE="LIM:${LIMIT}"
if useradd \
    --no-create-home \
    --home-dir /nonexistent \
    --shell "$RESTRICTED_SHELL" \
    --expiredate "$EXPIRY_DATE" \
    --comment "$GECOS_VALUE" \
    "$USERNAME" 2>/dev/null; then
    RECORDED_GECOS="$GECOS_VALUE"
else
    RECORDED_GECOS="LIM-${LIMIT}"
    useradd \
        --no-create-home \
        --home-dir /nonexistent \
        --shell "$RESTRICTED_SHELL" \
        --expiredate "$EXPIRY_DATE" \
        --comment "$RECORDED_GECOS" \
        "$USERNAME"
fi

# Asignación segura de contraseña
echo "${USERNAME}:${PASSWORD}" | chpasswd

# Registrar usuario en la base de datos local /etc/vps-ssh-limiter/users.db
mkdir -p /etc/vps-ssh-limiter
sed -i "/^${USERNAME}:/d" /etc/vps-ssh-limiter/users.db 2>/dev/null || true
echo "${USERNAME}:${PASSWORD}:${EXPIRY_DATE}:${LIMIT}:$(date +%Y-%m-%d)" >> /etc/vps-ssh-limiter/users.db
chmod 600 /etc/vps-ssh-limiter/users.db

# ------------------------------------------------------------------------------
# Confirmación de salida formateada
# ------------------------------------------------------------------------------
echo -e "${C_GREEN}✔ Usuario creado exitosamente${C_RESET}"
echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
printf "  ${C_BOLD}%-15s${C_RESET} %s\n" "Usuario:" "$USERNAME"
printf "  ${C_BOLD}%-15s${C_RESET} %s\n" "Límite:" "${LIMIT} conexión(es)"
printf "  ${C_BOLD}%-15s${C_RESET} %s (%s d)\n" "Vencimiento:" "$EXPIRY_DATE" "$DAYS"
printf "  ${C_BOLD}%-15s${C_RESET} %s\n" "Shell:" "$RESTRICTED_SHELL"
printf "  ${C_BOLD}%-15s${C_RESET} %s\n" "Home:" "/nonexistent"
echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"

# Obtener IP pública, dominio y puertos para la ficha de conexión
SERVER_IP=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
            curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
            ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
            hostname -I 2>/dev/null | awk '{print $1}' || echo "IP_VPS")

DOMAIN_FILE="/etc/vps-ssh-limiter/domain"
SERVER_HOST=""
if [[ -f "$DOMAIN_FILE" && -s "$DOMAIN_FILE" ]]; then
    SERVER_HOST=$(tr -d '[:space:]' < "$DOMAIN_FILE")
fi
CONNECT_HOST="${SERVER_HOST:-$SERVER_IP}"

DROP_PORTS="143, 90, 109"
if [[ -f /etc/default/dropbear ]]; then
    main_p=$(grep "^DROPBEAR_PORT=" /etc/default/dropbear | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
    extra_p=$(grep "^DROPBEAR_EXTRA_ARGS=" /etc/default/dropbear | grep -oP '(?<=-p )\d+' | tr '\n' ' ' || true)
    comb="${main_p:-143}"
    if [[ -n "$extra_p" ]]; then
        comb+=", ${extra_p// /, }"
        comb="${comb%, }"
    fi
    DROP_PORTS="$comb"
fi

echo -e "\n${C_BOLD}${C_CYAN}📋 FICHA PARA CLIENTE (HTTP CUSTOM)${C_RESET}"
echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
echo -e "🚀 *DATOS DE CONEXIÓN SSH*"
if [[ -n "$SERVER_HOST" ]]; then
    echo -e "🌐 *Host / Dominio:* \`${SERVER_HOST}\`"
    echo -e "📍 *IP Directa:* \`${SERVER_IP}\`"
else
    echo -e "🌐 *Host / IP:* \`${SERVER_IP}\`"
fi
echo -e "🚪 *Puertos SSH Directo:* \`143, 22\` (Con Banner de Cuenta)"
echo -e "🚪 *Puerto WS Proxy (Payload):* \`80\`"
echo -e "🚪 *Puertos Dropbear:* \`${DROP_PORTS}\`"
echo -e "👤 *Usuario:* \`${USERNAME}\`"
echo -e "🔑 *Contraseña:* \`${PASSWORD}\`"
echo -e "📅 *Vencimiento:* \`${EXPIRY_DATE}\` (${DAYS} días)"
echo -e "📱 *Límite:* \`${LIMIT} conexión(es)\`"
echo -e "📞 *Contacto:* \`3826432180\`"
echo -e ""
echo -e "⚡ *Formato Rápido de Importación en HTTP Custom:*"
echo -e "${C_YELLOW}${CONNECT_HOST}:143@${USERNAME}:${PASSWORD}${C_RESET}"
echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"

# Asignar automáticamente el nuevo usuario a las variables del banner
if command -v /usr/local/bin/ssh-banner >/dev/null 2>&1; then
    /usr/local/bin/ssh-banner --user "$USERNAME" >/dev/null 2>&1 || true
    /usr/local/bin/ssh-banner --apply >/dev/null 2>&1 || true
elif [[ -x "${BASH_SOURCE[0]%/*}/ssh-banner" ]]; then
    bash "${BASH_SOURCE[0]%/*}/ssh-banner" --user "$USERNAME" >/dev/null 2>&1 || true
    bash "${BASH_SOURCE[0]%/*}/ssh-banner" --apply >/dev/null 2>&1 || true
elif [[ -x "/etc/vps-ssh-limiter/bin/ssh-banner" ]]; then
    /etc/vps-ssh-limiter/bin/ssh-banner --user "$USERNAME" >/dev/null 2>&1 || true
    /etc/vps-ssh-limiter/bin/ssh-banner --apply >/dev/null 2>&1 || true
fi

exit 0
