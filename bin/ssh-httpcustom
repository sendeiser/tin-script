#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-httpcustom
# Generador de fichas de conexión, formatos de importación y guía paso a paso
# para configurar la aplicación Android/iOS HTTP Custom con cuentas SSH/Dropbear.
# ==============================================================================
set -euo pipefail

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_BOLD=""
    C_GRAY=""
    C_MAGENTA=""
    C_WHITE=""
fi

get_server_ip() {
    local ip
    ip=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "IP_DE_TU_VPS")
    echo "$ip"
}

get_server_host() {
    local dom_file="/etc/vps-ssh-limiter/domain"
    if [[ -f "$dom_file" && -s "$dom_file" ]]; then
        tr -d '[:space:]' < "$dom_file"
    else
        get_server_ip
    fi
}

get_dropbear_ports() {
    local ports="143, 90, 109"
    if [[ -f /etc/default/dropbear ]]; then
        local main_p extra_p
        main_p=$(grep "^DROPBEAR_PORT=" /etc/default/dropbear | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
        extra_p=$(grep "^DROPBEAR_EXTRA_ARGS=" /etc/default/dropbear | grep -oP '(?<=-p )\d+' | tr '\n' ' ' || true)
        local combined="${main_p:-143}"
        if [[ -n "$extra_p" ]]; then
            combined+=", ${extra_p// /, }"
            combined="${combined%, }"
        fi
        ports="$combined"
    fi
    echo "$ports"
}

# ------------------------------------------------------------------------------
# Generador de Ficha de Cliente para Móvil / Mensajes / Portapapeles
# ------------------------------------------------------------------------------
show_client_card() {
    local user="$1"
    local pass="${2:-********}"
    local ip host_conn drop_ports
    ip=$(get_server_ip)
    host_conn=$(get_server_host)
    drop_ports=$(get_dropbear_ports)

    # Expiración y límite desde el sistema
    local exp_date="Indefinido"
    local days_left="Ilimitado"
    if command -v chage >/dev/null 2>&1; then
        local raw_exp
        raw_exp=$(chage -l "$user" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$raw_exp" && "$raw_exp" != "never" && "$raw_exp" != "nunca" ]]; then
            local exp_epoch now_epoch
            exp_epoch=$(date -d "$raw_exp" +%s 2>/dev/null || true)
            now_epoch=$(date +%s)
            if [[ -n "$exp_epoch" ]]; then
                exp_date=$(date -d "@$exp_epoch" +%Y-%m-%d 2>/dev/null || echo "$raw_exp")
                local diff=$(( (exp_epoch - now_epoch) / 86400 ))
                if [[ $diff -ge 0 ]]; then
                    days_left="${diff} día(s)"
                else
                    days_left="EXPIRADO"
                fi
            fi
        fi
    fi

    local limit_conn="1"
    local gecos_line
    gecos_line=$(grep "^${user}:" /etc/passwd 2>/dev/null || true)
    if [[ "$gecos_line" =~ LIM[:_=-]?([0-9]+) ]]; then
        limit_conn="${BASH_REMATCH[1]}"
    fi

    # Consumo de datos del usuario
    local u_bytes=0
    if [[ -f /etc/vps-ssh-limiter/traffic.db ]]; then
        local t_line
        t_line=$(grep "^${user}:" /etc/vps-ssh-limiter/traffic.db 2>/dev/null | head -n1 || true)
        if [[ -n "$t_line" ]]; then
            u_bytes=$(echo "$t_line" | cut -d: -f2 || echo 0)
        fi
    fi
    local pids
    pids=$(pgrep -u "$user" 2>/dev/null || true)
    for p in $pids; do
        if [[ -r "/proc/$p/io" ]]; then
            local r_b w_b
            r_b=$(awk '/rchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            w_b=$(awk '/wchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            u_bytes=$(( u_bytes + r_b + w_b ))
        fi
    done
    local traffic_str="0 B"
    if [[ $u_bytes -ge 1073741824 ]]; then
        traffic_str=$(awk -v b="$u_bytes" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
    elif [[ $u_bytes -ge 1048576 ]]; then
        traffic_str=$(awk -v b="$u_bytes" 'BEGIN { printf "%.2f MB", b / 1048576 }')
    elif [[ $u_bytes -ge 1024 ]]; then
        traffic_str=$(awk -v b="$u_bytes" 'BEGIN { printf "%.1f KB", b / 1024 }')
    elif [[ $u_bytes -gt 0 ]]; then
        traffic_str="${u_bytes} B"
    fi

    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}★ FICHA CLIENTE HTTP CUSTOM ★${C_RESET}     ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
    echo -e " Copia y envía este mensaje a tu cliente:"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
    echo -e "🚀 *DATOS DE TU CUENTA SSH / HTTP CUSTOM*"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ "$host_conn" != "$ip" ]]; then
        echo -e "🌐 *Dominio / Host:* \`${host_conn}\`"
        echo -e "📍 *IP Directa:* \`${ip}\`"
    else
        echo -e "🌐 *Host / IP:* \`${ip}\`"
    fi
    echo -e "🚪 *Puertos SSH Directo:* \`143, 22\`"
    echo -e "🚪 *Puerto WebSocket Proxy:* \`80\` (Para Payloads / CDN Cloudflare)"
    echo -e "🚪 *Puertos Dropbear:* \`${drop_ports}\`"
    echo -e "👤 *Usuario:* \`${user}\`"
    echo -e "🔑 *Contraseña:* \`${pass}\`"
    echo -e "📅 *Vencimiento:* \`${exp_date}\` (${days_left} restantes)"
    echo -e "📊 *Datos Usados:* \`${traffic_str}\`"
    echo -e "📱 *Límite de Conexiones:* \`${limit_conn} dispositivo(s)\`"
    echo -e "📞 *Contacto / Soporte:* \`3826432180\`"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "⚡ *Formato Rápido de Importación en HTTP Custom:*"
    echo -e "\`${host_conn}:143@${user}:${pass}\`"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
}

