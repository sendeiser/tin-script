    ip=$(get_server_ip)
    local drop_ports
    drop_ports=$(get_dropbear_ports)

    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}★ GUÍA PASO A PASO EN APP ★${C_RESET}       ${C_CYAN}║${C_RESET}"
