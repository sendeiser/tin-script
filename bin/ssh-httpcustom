#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-httpcustom
# Generador de fichas de conexión, formatos de importación y guía paso a paso
# para configurar la aplicación Android/iOS HTTP Custom con cuentas SSH/Dropbear.
# ==============================================================================
set -euo pipefail

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
    C_MAGENTA="\033[1;35m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_BOLD=""
    C_GRAY=""
    C_MAGENTA=""
fi

get_server_ip() {
    local ip
    ip=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "IP_DE_TU_VPS")
    echo "$ip"
}

get_server_host() {
    local dom_file="/etc/vps-ssh-limiter/domain"
    if [[ -f "$dom_file" && -s "$dom_file" ]]; then
        tr -d '[:space:]' < "$dom_file"
    else
        get_server_ip
    fi
}

get_dropbear_ports() {
    local ports="143, 90, 109"
    if [[ -f /etc/default/dropbear ]]; then
        local main_p extra_p
        main_p=$(grep "^DROPBEAR_PORT=" /etc/default/dropbear | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
        extra_p=$(grep "^DROPBEAR_EXTRA_ARGS=" /etc/default/dropbear | grep -oP '(?<=-p )\d+' | tr '\n' ' ' || true)
        local combined="${main_p:-143}"
        if [[ -n "$extra_p" ]]; then
            combined+=", ${extra_p// /, }"
            combined="${combined%, }"
        fi
        ports="$combined"
    fi
    echo "$ports"
}

# ------------------------------------------------------------------------------
# Generador de Ficha de Cliente para WhatsApp / Telegram / Portapapeles
# ------------------------------------------------------------------------------
show_client_card() {
    local user="$1"
    local pass="${2:-********}"
    local ip host_conn drop_ports
    ip=$(get_server_ip)
    host_conn=$(get_server_host)
    drop_ports=$(get_dropbear_ports)

    # Expiración y límite desde el sistema
    local exp_date="Indefinido"
    if command -v chage >/dev/null 2>&1; then
        local raw_exp
        raw_exp=$(chage -l "$user" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$raw_exp" && "$raw_exp" != "never" && "$raw_exp" != "nunca" ]]; then
            exp_date=$(date -d "$raw_exp" +%Y-%m-%d 2>/dev/null || echo "$raw_exp")
        fi
    fi

    local limit_conn="1"
    local gecos_line
    gecos_line=$(grep "^${user}:" /etc/passwd 2>/dev/null || true)
    if [[ "$gecos_line" =~ LIM[:_=-]?([0-9]+) ]]; then
        limit_conn="${BASH_REMATCH[1]}"
    fi

    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}        FICHA DE DATOS PARA CLIENTE (HTTP CUSTOM / VPN)         ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e " Copia y envía este mensaje a tu cliente:"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "🚀 *DATOS DE TU CUENTA SSH / HTTP CUSTOM*"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ "$host_conn" != "$ip" ]]; then
        echo -e "🌐 *Dominio / Host:* \`${host_conn}\`"
        echo -e "📍 *IP Directa:* \`${ip}\`"
    else
        echo -e "🌐 *Host / IP:* \`${ip}\`"
    fi
    echo -e "🚪 *Puertos Dropbear:* \`${drop_ports}\` (Recomendados)"
    echo -e "🚪 *Puerto OpenSSH:* \`22\`"
    echo -e "👤 *Usuario:* \`${user}\`"
    echo -e "🔑 *Contraseña:* \`${pass}\`"
    echo -e "📅 *Vencimiento:* \`${exp_date}\`"
    echo -e "📱 *Límite de Conexiones:* \`${limit_conn} dispositivo(s)\`"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "⚡ *Formato Rápido de Importación en HTTP Custom:*"
    echo -e "\`${host_conn}:143@${user}:${pass}\`"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
}

# ------------------------------------------------------------------------------
# Tutorial y Guía Paso a Paso para la Aplicación HTTP Custom
# ------------------------------------------------------------------------------
show_tutorial() {
    local ip
    ip=$(get_server_ip)
    local drop_ports
    drop_ports=$(get_dropbear_ports)

    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}          GUÍA PASO A PASO: CONEXIÓN EN HTTP CUSTOM             ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_YELLOW}${C_BOLD}► MÉTODO 1: CONFIGURACIÓN MANUAL EN LA APLICACIÓN${C_RESET}"
    echo -e "1. Abre la aplicación ${C_BOLD}HTTP Custom${C_RESET} en tu teléfono Android."
    echo -e "2. En la pantalla principal, marca la casilla ${C_GREEN}✔ SSH${C_RESET}."
    echo -e "3. Pulsa el botón de menú lateral ${C_BOLD}(☰)${C_RESET} en la esquina superior izquierda."
    echo -e "4. Selecciona ${C_BOLD}'SSH Setting'${C_RESET}."
    echo -e "5. Rellena los campos con los datos del servidor:"
    echo -e "   • ${C_BOLD}Server IP / Host:${C_RESET}   ${C_CYAN}${ip}${C_RESET}"
    echo -e "   • ${C_BOLD}Server Port:${C_RESET}        ${C_GREEN}143${C_RESET} (o 90, 109 de Dropbear / 22 de SSH)"
    echo -e "   • ${C_BOLD}Username:${C_RESET}           ${C_YELLOW}tu_usuario${C_RESET}"
    echo -e "   • ${C_BOLD}Password:${C_RESET}           ${C_YELLOW}tu_contraseña${C_RESET}"
    echo -e "6. Regresa a la pantalla de inicio y pulsa el botón grande ${C_GREEN}${C_BOLD}CONNECT${C_RESET}."
    echo -e "7. Revisa la pestaña ${C_BOLD}LOG${C_RESET}; si ves ${C_GREEN}HTTP Custom: Connected${C_RESET}, ¡ya estás navegando!\n"

    echo -e "${C_YELLOW}${C_BOLD}► MÉTODO 2: PEGAR CADENA RÁPIDA (1-CLICK)${C_RESET}"
    echo -e "En HTTP Custom puedes pegar los datos juntos sin llenar campo por campo:"
    echo -e "Formato: ${C_BOLD}IP:PUERTO@USUARIO:CONTRASEÑA${C_RESET}"
    echo -e "Ejemplo: ${C_CYAN}${ip}:143@juan:clave123${C_RESET}\n"

    echo -e "${C_YELLOW}${C_BOLD}► MÉTODOS DE CONEXIÓN (PAYLOADS / SSL / DIRECTO)${C_RESET}"
    echo -e "• ${C_BOLD}Conexión Directa (Direct SSH):${C_RESET}"
    echo -e "  Ideal para navegar seguro o si el proveedor no bloquea SSH estándar."
    echo -e "  No requiere payload. Solo marca 'SSH' y pulsa 'CONNECT'.\n"

    echo -e "• ${C_BOLD}Conexión con Payload (HTTP Proxy):${C_RESET}"
    echo -e "  Se usa para bypass con bugs de operadoras o internet gratuito."
    echo -e "  En el cuadro de texto principal de HTTP Custom, ingresa un payload como:"
    echo -e "  ${C_GRAY}GET / HTTP/1.1[crlf]Host: [host_port][crlf]Upgrade: websocket[crlf]Connection: Keep-Alive[crlf][crlf]${C_RESET}\n"

    echo -e "• ${C_BOLD}Conexión SSL / TLS (SNI / Stunnel):${C_RESET}"
    echo -e "  Marca la casilla ${C_CYAN}'SSL'${C_RESET} o ${C_CYAN}'Payload'${C_RESET} según tu método y escribe el SNI"
    echo -e "  o Bug Host de tu compañía (ej: ${C_GRAY}m.whatsapp.net${C_RESET} o ${C_GRAY}zoom.us${C_RESET}).\n"

    echo -e "${C_YELLOW}${C_BOLD}► RECOMENDACIONES TÉCNICAS (PARA EVITAR DESCONEXIONES)${C_RESET}"
    echo -e "✔ ${C_BOLD}Activar Auto-Ping:${C_RESET} En el menú lateral de HTTP Custom -> activa ${C_CYAN}Auto Ping${C_RESET}"
    echo -e "  con intervalo de 3 a 5 segundos. Esto evita que la conexión se duerma."
    echo -e "✔ ${C_BOLD}Optimización de Batería:${C_RESET} En los ajustes de Android -> Batería -> HTTP Custom"
    echo -e "  -> cambiar a 'Sin restricciones' para que Android no cierre la app en segundo plano."
    echo -e "✔ ${C_BOLD}Respetar Límite Simultáneo:${C_RESET} Si el usuario supera el límite configurado,"
    echo -e "  el demonio ${C_BOLD}ssh-limiter${C_RESET} desconectará la conexión más reciente de forma automática."
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
}

# ------------------------------------------------------------------------------
# Ejemplos de Payloads Populares
# ------------------------------------------------------------------------------
show_payloads() {
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}             EJEMPLOS DE PAYLOADS PARA HTTP CUSTOM              ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_BOLD}1. WebSocket Estándar (Cloudflare / CDN / Direct):${C_RESET}"
    echo -e "${C_GREEN}GET / HTTP/1.1[crlf]Host: [host_port][crlf]Upgrade: websocket[crlf]Connection: Keep-Alive[crlf][crlf]${C_RESET}\n"

    echo -e "${C_BOLD}2. Payload HTTP Proxy con Bug Host (Reemplazar 'bughost.com'):${C_RESET}"
    echo -e "${C_GREEN}GET / HTTP/1.1[crlf]Host: bughost.com[crlf]X-Online-Host: bughost.com[crlf]Connection: Keep-Alive[crlf][crlf]${C_RESET}\n"

    echo -e "${C_BOLD}3. Payload Doble CONNECT:${C_RESET}"
    echo -e "${C_GREEN}CONNECT [host_port] HTTP/1.1[crlf]Host: [host_port][crlf]Proxy-Connection: Keep-Alive[crlf][crlf]${C_RESET}\n"

    echo -e "${C_BOLD}4. Payload POST Buffer Split:${C_RESET}"
    echo -e "${C_GREEN}POST / HTTP/1.1[crlf]Host: [host_port][crlf]Content-Length: 0[crlf]Connection: Keep-Alive[crlf][crlf]${C_RESET}\n"
    echo -e "${C_GRAY}Nota: Recuerda cambiar 'bughost.com' por el dominio con zero-rating de tu operadora móvil.${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
}

# ------------------------------------------------------------------------------
# Manejo de Parámetros CLI o Modo Interactivo
# ------------------------------------------------------------------------------
press_enter() {
    echo -e "\n${C_GRAY}Presione ${C_BOLD}[Enter]${C_RESET}${C_GRAY} para continuar...${C_RESET}"
    read -r _
}

if [[ $# -ge 1 ]]; then
    case "$1" in
        --guide|-g)
            show_tutorial
            exit 0
            ;;
        --payloads|-p)
            show_payloads
            exit 0
            ;;
        -h|--help)
            echo "Uso: ssh-httpcustom [usuario] [contraseña]"
            echo "      ssh-httpcustom --guide"
            echo "      ssh-httpcustom --payloads"
            exit 0
            ;;
        *)
            # Si se pasa un nombre de usuario
            target_user="$1"
            target_pass="${2:-}"
            if [[ -z "$target_pass" ]]; then
                show_client_card "$target_user" "********"
            else
                show_client_card "$target_user" "$target_pass"
            fi
            exit 0
            ;;
    esac
fi

# Modo interactivo
while true; do
    clear
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}           MÓDULO Y GUÍA HTTP CUSTOM / INJECTOR / VPN           ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e "  ${C_YELLOW}[1]${C_RESET} Ver Guía Paso a Paso (Cómo configurar HTTP Custom)"
    echo -e "  ${C_YELLOW}[2]${C_RESET} Generar Ficha de Cliente para un usuario (WhatsApp/Telegram)"
    echo -e "  ${C_YELLOW}[3]${C_RESET} Ejemplos de Payloads recomendados (CDN / WebSocket / Proxy)"
    echo -e "  ${C_RED}[0]${C_RESET} Volver al Menú Principal"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    opt_hc=""
    read -r -p "Seleccione una opción [0-3]: " opt_hc || true

    case "${opt_hc:-}" in
        1)
            clear
            show_tutorial
            press_enter
            ;;
        2)
            echo -e "\n${C_BOLD}${C_CYAN}--- GENERAR FICHA DE DATOS PARA CLIENTE ---${C_RESET}"
            u_name=""
            read -r -p "Usuario: " u_name || true
            if [[ -z "${u_name:-}" ]]; then
                echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
            elif ! id "$u_name" >/dev/null 2>&1; then
                echo -e "${C_RED}[ERROR] El usuario '$u_name' no existe en el sistema.${C_RESET}"
            else
                u_pass=""
                read -r -p "Contraseña (opcional, para incluirla en el texto): " u_pass || true
                clear
                show_client_card "$u_name" "${u_pass:-********}"
            fi
            press_enter
            ;;
        3)
            clear
            show_payloads
            press_enter
            ;;
        0)
            break
            ;;
        *)
            echo -e "${C_RED}Opción inválida.${C_RESET}"
            sleep 1
            ;;
    esac
done
