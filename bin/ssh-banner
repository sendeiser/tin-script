}

# ------------------------------------------------------------------------------
# Aplicar Banner en Dropbear, OpenSSH y MOTD
# ------------------------------------------------------------------------------
apply_banner_system() {
    load_banner_conf

    mkdir -p "$CONFIG_DIR"
    mkdir -p "${CONFIG_DIR}/banners"
    mkdir -p "/etc/dropbear"

    if [[ "$BANNER_ENABLED" == "true" ]]; then
        if [[ "$TEMPLATE_ID" != "5" || ! -f "$BANNER_FILE" || ! -s "$BANNER_FILE" ]]; then
            generate_banner_text "$TEMPLATE_ID" "$SERVER_NAME" "$CONTACT_INFO" "$CUSTOM_RULES" "${BANNER_USER:-auto}" > "$BANNER_FILE"
        fi
        cp -f "$BANNER_FILE" "$ISSUE_FILE" 2>/dev/null || true
        cp -f "$BANNER_FILE" "/etc/dropbear/banner" 2>/dev/null || true
        chmod 644 "$BANNER_FILE" "$ISSUE_FILE" "/etc/dropbear/banner" 2>/dev/null || true

        # Generar banners específicos por cada usuario en /etc/vps-ssh-limiter/banners/<user>.net
        while IFS=: read -r u _ uid _ _ _ _; do
            if [[ $uid -ge 1000 && "$u" != "nobody" ]]; then
                generate_banner_text "$TEMPLATE_ID" "$SERVER_NAME" "$CONTACT_INFO" "$CUSTOM_RULES" "$u" > "${CONFIG_DIR}/banners/${u}.net" 2>/dev/null || true
                chmod 644 "${CONFIG_DIR}/banners/${u}.net" 2>/dev/null || true
            fi
        done < /etc/passwd
    else
        echo -n "" > "$BANNER_FILE"
        echo -n "" > "$ISSUE_FILE"
        rm -f "/etc/dropbear/banner" 2>/dev/null || true
        rm -rf "${CONFIG_DIR}/banners" 2>/dev/null || true
    fi

    # Garantizar shell persistente actualizada para túneles SSH y HTTP Custom
    # Copiar siempre desde el binario instalado para asegurar banner dinámico
    if [[ -f /usr/local/bin/ssh-tunnel-shell ]]; then
        chmod 755 /usr/local/bin/ssh-tunnel-shell
    fi
    ln -sf /usr/local/bin/ssh-tunnel-shell /bin/ssh-tunnel-shell 2>/dev/null || true

    # Registrar shell en /etc/shells si no existe
    if [[ -f /etc/shells ]]; then
        for s in "/usr/local/bin/ssh-tunnel-shell" "/bin/ssh-tunnel-shell"; do
            if ! grep -Fxq "$s" /etc/shells 2>/dev/null; then
                echo "$s" >> /etc/shells
            fi
        done
    fi

    # Migrar usuarios de túnel con /bin/false o nologin a ssh-tunnel-shell
    while IFS=: read -r mu _ muid _ _ _ msh; do
        if [[ $muid -ge 1000 && "$mu" != "nobody" && "$mu" != "nogroup" ]]; then
            if [[ "$msh" == "/bin/false" || "$msh" == "/usr/sbin/nologin" || "$msh" == *"/nologin" ]]; then
                usermod -s /usr/local/bin/ssh-tunnel-shell "$mu" 2>/dev/null || true
            fi
        fi
    done < /etc/passwd

    # Configurar OpenSSH con banners específicos por usuario (Match User)
    local sshd_cfg="/etc/ssh/sshd_config"
    if [[ -f "$sshd_cfg" ]]; then
        # Asegurar directiva Banner global
        if grep -q "^#\?Banner" "$sshd_cfg"; then
            sed -i "s|^#\?Banner.*|Banner ${BANNER_FILE}|g" "$sshd_cfg"
        else
            sed -i "1s|^|Banner ${BANNER_FILE}\n|" "$sshd_cfg"
        fi

        # Asegurar puertos 22 y 143 para OpenSSH con banners individuales
        if ! grep -E -q "^Port\s+143" "$sshd_cfg"; then
            if grep -E -q "^Port\s+22" "$sshd_cfg"; then
                sed -i "s|^Port\s\+22.*|Port 22\nPort 143|g" "$sshd_cfg"
            elif grep -E -q "^#Port\s+22" "$sshd_cfg"; then
                sed -i "s|^#Port\s\+22.*|Port 22\nPort 143|g" "$sshd_cfg"
            else
                echo "Port 22" >> "$sshd_cfg"
                echo "Port 143" >> "$sshd_cfg"
            fi
        fi

        # Garantizar que OpenSSH acepte contraseñas y reenvío de puertos sin fallos
        sed -i 's|^#\?PasswordAuthentication\s\+no|PasswordAuthentication yes|g' "$sshd_cfg" 2>/dev/null || true
        if grep -q "^#\?PasswordAuthentication" "$sshd_cfg"; then
            sed -i 's|^#\?PasswordAuthentication.*|PasswordAuthentication yes|g' "$sshd_cfg"
        else
            echo "PasswordAuthentication yes" >> "$sshd_cfg"
        fi

        # Anular configuraciones restrictivas de proveedores cloud en /etc/ssh/sshd_config.d/
        mkdir -p /etc/ssh/sshd_config.d
        sed -i 's|^PasswordAuthentication\s\+no|PasswordAuthentication yes|g' /etc/ssh/sshd_config.d/*.conf 2>/dev/null || true
        cat > /etc/ssh/sshd_config.d/01-vps-ssh-limiter.conf <<'EOF_SSHD'
Port 22
Port 143
PasswordAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes
PermitEmptyPasswords no
AllowTcpForwarding yes
GatewayPorts yes
TCPKeepAlive yes
ClientAliveInterval 30
ClientAliveCountMax 3
EOF_SSHD

        # Limpiar bloques Match User previos de vps-ssh-limiter
        if grep -q "# BEGIN VPS-SSH-LIMITER USER BANNERS" "$sshd_cfg"; then
            sed -i '/# BEGIN VPS-SSH-LIMITER USER BANNERS/,/# END VPS-SSH-LIMITER USER BANNERS/d' "$sshd_cfg"
        fi

        # Si el banner está activado, añadir bloques Match User al final del archivo
        if [[ "$BANNER_ENABLED" == "true" ]]; then
            local match_blocks=""
            match_blocks+="# BEGIN VPS-SSH-LIMITER USER BANNERS\n"
            while IFS=: read -r u _ uid _ _ _ _; do
                if [[ $uid -ge 1000 && "$u" != "nobody" && -f "${CONFIG_DIR}/banners/${u}.net" ]]; then
                    match_blocks+="Match User ${u}\n    Banner ${CONFIG_DIR}/banners/${u}.net\n    PasswordAuthentication yes\n    AllowTcpForwarding yes\n    TCPKeepAlive yes\n    ClientAliveInterval 30\n    ClientAliveCountMax 3\n"
                fi
            done < /etc/passwd
            match_blocks+="# END VPS-SSH-LIMITER USER BANNERS\n"

            echo -e "\n$match_blocks" >> "$sshd_cfg"
        fi

        # Validar sintaxis con sshd -t antes de recargar
        if command -v sshd >/dev/null 2>&1; then
            if sshd -t 2>/dev/null; then
                systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
            else
                # Si falló la sintaxis, revertir bloque Match
                sed -i '/# BEGIN VPS-SSH-LIMITER USER BANNERS/,/# END VPS-SSH-LIMITER USER BANNERS/d' "$sshd_cfg"
                systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
            fi
        fi
    fi

    # Configurar Dropbear en puertos 90 y 109 para liberar 143 a OpenSSH (para banners de usuario)
    if [[ -f /etc/default/dropbear ]]; then
        sed -i 's|^DROPBEAR_PORT=.*|DROPBEAR_PORT=90|g' /etc/default/dropbear
        if grep -q "^#\?DROPBEAR_BANNER=" /etc/default/dropbear; then
            sed -i "s|^#\?DROPBEAR_BANNER=.*|DROPBEAR_BANNER=\"${BANNER_FILE}\"|g" /etc/default/dropbear
        else
            echo "DROPBEAR_BANNER=\"${BANNER_FILE}\"" >> /etc/default/dropbear
        fi

        local cur_extra="-p 109"
        if [[ "$BANNER_ENABLED" == "true" ]]; then
            cur_extra="${cur_extra} -b ${BANNER_FILE}"
        fi

        sed -i "s|^DROPBEAR_EXTRA_ARGS=.*|DROPBEAR_EXTRA_ARGS=\"${cur_extra}\"|g" /etc/default/dropbear
        systemctl restart dropbear 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
    fi

    # Configurar Banner Dinámico de Usuario en Login (/etc/profile.d/vps-ssh-banner.sh)
    if [[ "$DYNAMIC_LOGIN_BANNER" == "true" ]]; then
        cat > "$PROFILE_BANNER" <<'EOF'
# ==============================================================================
# vps-ssh-limiter: Banner dinámico de sesión de usuario (Optimizado para Móviles)
# ==============================================================================
if [[ -n "$USER" && "$USER" != "root" && -t 1 ]]; then
    _now_epoch=$(date +%s)
    _now_date=$(date '+%d/%m/%Y %H:%M')
    _exp_date="Sin exp."
    _days_left="Ilimitado"
    _limit="1"
    _conns="1"

    if command -v chage >/dev/null 2>&1; then
        _exp_raw=$(chage -l "$USER" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$_exp_raw" && "$_exp_raw" != "never" && "$_exp_raw" != "nunca" ]]; then
            _exp_epoch=$(date -d "$_exp_raw" +%s 2>/dev/null || true)
            if [[ -n "$_exp_epoch" ]]; then
                _exp_date=$(date -d "@$_exp_epoch" +%Y-%m-%d 2>/dev/null || echo "$_exp_raw")
                _diff=$(( (_exp_epoch - _now_epoch) / 86400 ))
                if [[ $_diff -ge 0 ]]; then
                    _days_left="${_diff} día(s)"
                else
                    _days_left="EXPIRADO"
                fi
            fi
        fi
    fi

    # Límite desde /etc/passwd
    _pass_line=$(grep "^${USER}:" /etc/passwd 2>/dev/null | head -n1 || true)
    if [[ "$_pass_line" =~ LIM[:_=-]?([0-9]+) ]]; then
        _limit="${BASH_REMATCH[1]}"
    fi

    # Conexiones activas del usuario
    local -a _active_pids=()
    for p in $(pgrep -u "$USER" 2>/dev/null || true); do
        [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] && _active_pids+=("$p")
    done
    _conns=${#_active_pids[@]}

    # Consumo de datos del usuario
    _u_bytes=0
    if [[ -f /etc/vps-ssh-limiter/traffic.db ]]; then
        _t_line=$(grep "^${USER}:" /etc/vps-ssh-limiter/traffic.db 2>/dev/null | head -n1 || true)
        if [[ -n "$_t_line" ]]; then
            _u_bytes=$(echo "$_t_line" | cut -d: -f2 || echo 0)
        fi
    fi
    for p in "${_active_pids[@]}"; do
        if [[ -r "/proc/$p/io" ]]; then
            _rb=$(awk '/rchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            _wb=$(awk '/wchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            _u_bytes=$(( _u_bytes + _rb + _wb ))
        fi
    done

    _traffic_str="0 B"
    if [[ $_u_bytes -ge 1073741824 ]]; then
        _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
    elif [[ $_u_bytes -ge 1048576 ]]; then
        _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.2f MB", b / 1048576 }')
    elif [[ $_u_bytes -ge 1024 ]]; then
        _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.1f KB", b / 1024 }')
    elif [[ $_u_bytes -gt 0 ]]; then
        _traffic_str="${_u_bytes} B"
    fi

    _sname="SupraVPS"
    _contact="3826432180"
    if [[ -f /etc/vps-ssh-limiter/banner.conf ]]; then
        # shellcheck disable=SC1091
        source /etc/vps-ssh-limiter/banner.conf 2>/dev/null || true
        _sname="${SERVER_NAME:-SupraVPS}"
        _contact="${CONTACT_INFO:-3826432180}"
    fi

    if [[ "${_contact:-}" == *"Telegram"* || "${_contact:-}" == *"@Soporte"* || -z "${_contact:-}" ]]; then
        _contact="3826432180"
    fi

    echo -e "\033[1;36m╔═══════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║\033[0m     \033[1;37m★ INFORMACIÓN DE TU CUENTA ★\033[0m      \033[1;36m║\033[0m"
    echo -e "\033[1;36m╚═══════════════════════════════════════╝\033[0m"
    echo -e "  \033[1;33m● Usuario     :\033[0m \033[1;37m${USER}\033[0m"
    echo -e "  \033[1;33m● Vencimiento :\033[0m \033[1;32m${_exp_date}\033[0m"
    echo -e "  \033[1;33m● Días rest.  :\033[0m \033[1;36m${_days_left}\033[0m"
    echo -e "  \033[1;33m● Datos Usados:\033[0m \033[1;35m${_traffic_str}\033[0m"
    echo -e "  \033[1;33m● Conexiones  :\033[0m \033[1;35m${_conns} de ${_limit} permitidos\033[0m"
    echo -e "  \033[1;33m● Estado      :\033[0m \033[1;32mACTIVO Y OPTIMIZADO\033[0m"
    echo -e "  \033[1;33m● Fecha / Hora:\033[0m \033[1;37m${_now_date}\033[0m"
    echo -e "  \033[1;33m● Contacto    :\033[0m \033[1;37m${_contact}\033[0m"
    echo -e "\033[0;90m─────────────────────────────────────────\033[0m"
    echo -e " \033[1;31m⚠️  Prohibido Torrent, Spam y Multi-Login\033[0m"
    echo -e "\033[0;90m─────────────────────────────────────────\033[0m"
fi
EOF
        chmod 644 "$PROFILE_BANNER"
    else
        rm -f "$PROFILE_BANNER" 2>/dev/null || true
    fi

    save_banner_conf
}

# ------------------------------------------------------------------------------
# Previsualización del Banner en Terminal (Simulación de HTML con ANSI)
# ------------------------------------------------------------------------------
render_simulated_html() {
    local text="$1"
    local sim
    sim=$(echo "$text" | sed \
        -e 's|<center>||g' -e 's|</center>||g' \
        -e 's|<b>|\o033[1m|g' -e 's|</b>|\o033[0m|g' \
        -e 's|<i>|\o033[3m|g' -e 's|</i>|\o033[0m|g' \
        -e 's|<font color="#00E5FF">|\o033[1;36m|g' \
        -e 's|<font color="#00F0FF">|\o033[1;36m|g' \
        -e 's|<font color="#00FFCC">|\o033[1;36m|g' \
        -e 's|<font color="#00ffea">|\o033[1;36m|g' \
        -e 's|<font color="#FFD700">|\o033[1;33m|g' \
        -e 's|<font color="#FFA500">|\o033[1;33m|g' \
        -e 's|<font color="#FFFF00">|\o033[1;33m|g' \
        -e 's|<font color="#39FF14">|\o033[1;32m|g' \
        -e 's|<font color="#00FF00">|\o033[1;32m|g' \
        -e 's|<font color="#FF3366">|\o033[1;31m|g' \
        -e 's|<font color="#FF4444">|\o033[1;31m|g' \
        -e 's|<font color="#FF0055">|\o033[1;31m|g' \
        -e 's|<font color="#FF3333">|\o033[1;31m|g' \
        -e 's|<font color="#FF007F">|\o033[1;35m|g' \
        -e 's|<font color="#FF00FF">|\o033[1;35m|g' \
        -e 's|<font color="#FFFFFF">|\o033[1;37m|g' \
        -e 's|<font color="#888888">|\o033[0;90m|g' \
        -e 's|</font>|\o033[0m|g' \
        -e 's|<br>||g')
    echo -e "$sim"
}

# ------------------------------------------------------------------------------
# Previsualización del Banner
# ------------------------------------------------------------------------------
preview_banner() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}REGISTRO HTTP CUSTOM (HTML)       ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}\n"

    local raw_banner=""
    raw_banner=$(generate_banner_text "$TEMPLATE_ID" "$SERVER_NAME" "$CONTACT_INFO" "$CUSTOM_RULES" "${BANNER_USER:-auto}")

    echo -e "${C_BOLD}${C_YELLOW}📱 VISTA PREVIA (En la app HTTP Custom):${C_RESET}\n"
    render_simulated_html "$raw_banner"
    echo -e "\n${C_GRAY}─────────────────────────────────────────${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}📝 CÓDIGO HTML REGISTRADO EN EL BANNER:${C_RESET}\n"
    echo -e "${C_GRAY}${raw_banner}${C_RESET}"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"

    press_enter
}

# ------------------------------------------------------------------------------
# Selección de Plantilla
# ------------------------------------------------------------------------------
select_template() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}PLANTILLAS PARA HTTP CUSTOM${C_RESET}       ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}\n"

    echo -e "  ${C_YELLOW}[1] ★ Info de Cuenta (HTML Pro - Recomendado)${C_RESET}"
    echo -e "      • Usuario, vencimiento, datos usados y tel. 3826432180."
    echo -e "  ${C_YELLOW}[2] ★ VIP Gold Móvil (HTML Neón Dorado)${C_RESET}"
    echo -e "      • Estrellas doradas VIP y contacto telefónico."
    echo -e "  ${C_YELLOW}[3] 🎮 Gaming & Low-Lag (HTML Gamer Neón)${C_RESET}"
    echo -e "      • Perfil optimizado para juegos y anti-lag."
    echo -e "  ${C_YELLOW}[4] ⚡ Cyberpunk Pro (HTML Rosa/Cyan Neón)${C_RESET}"
    echo -e "      • Estilo tecnológico de alta velocidad."
    echo -e "  ${C_YELLOW}[5] 📱 Texto Plano Móvil (Sin etiquetas HTML)${C_RESET}"
    echo -e "      • Compatible con terminales clásicas."
    echo -e "  ${C_RED}[0] Cancelar${C_RESET}\n"

    local opt_t=""
    read -r -p "Selecciona una plantilla [0-5]: " opt_t || true
    if [[ "$opt_t" =~ ^[1-5]$ ]]; then
        TEMPLATE_ID="$opt_t"
        save_banner_conf
        apply_banner_system
        echo -e "\n${C_GREEN}✔ Plantilla #${TEMPLATE_ID} aplicada exitosamente en OpenSSH y Dropbear.${C_RESET}"
        press_enter
    fi
}

# ------------------------------------------------------------------------------
# Seleccionar Usuario para el Banner
# ------------------------------------------------------------------------------
select_user_for_banner() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}USUARIO EN BANNER HTTP CUSTOM     ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}\n"
    echo -e "Configura qué datos de usuario (nombre, vencimiento"
    echo -e "y consumo de datos del sistema) saldrán en el banner:\n"
    echo -e "  Usuario actual: ${C_CYAN}${BANNER_USER:-auto}${C_RESET}\n"
    echo -e "  ${C_GREEN}[A]${C_RESET} Auto-detectar (Primer cliente activo del VPS)"

    local users=()
    while IFS=: read -r u _ uid _ _ _ _; do
        if [[ $uid -ge 1000 && "$u" != "nobody" ]]; then
            users+=("$u")
        fi
    done < /etc/passwd

    local i=1
    for u in "${users[@]}"; do
        echo -e "  ${C_YELLOW}[$i]${C_RESET} $u"
        ((i++))
    done
    echo -e "  ${C_YELLOW}[M]${C_RESET} Escribir nombre manualmente"
    echo -e "  ${C_RED}[0]${C_RESET} Cancelar\n"

    local sel=""
    read -r -p "Seleccione una opción: " sel || true
    if [[ "$sel" =~ ^[Aa]$ ]]; then
        BANNER_USER="auto"
        save_banner_conf
        apply_banner_system
        echo -e "\n${C_GREEN}✔ Modo auto-detectar activado.${C_RESET}"
        press_enter
    elif [[ "$sel" =~ ^[Mm]$ ]]; then
        local custom_u=""
        read -r -p "Nombre de usuario a mostrar: " custom_u || true
        if [[ -n "$custom_u" ]]; then
            BANNER_USER="$custom_u"
            save_banner_conf
            apply_banner_system
            echo -e "\n${C_GREEN}✔ Usuario '$BANNER_USER' asignado al banner.${C_RESET}"
            press_enter
        fi
    elif [[ "$sel" =~ ^[0-9]+$ && "$sel" -ge 1 && "$sel" -le "${#users[@]}" ]]; then
        local chosen="${users[$((sel-1))]}"
        BANNER_USER="$chosen"
        save_banner_conf
        apply_banner_system
        echo -e "\n${C_GREEN}✔ Banner asignado al usuario '${chosen}'.${C_RESET}"
        press_enter
    fi
}

# ------------------------------------------------------------------------------
# Personalizar Datos del Banner (Servidor, Contacto, Reglas)
# ------------------------------------------------------------------------------
customize_data() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}PERSONALIZAR TEXTOS DEL BANNER${C_RESET}    ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}\n"

    echo -e "Valores actuales:"
    echo -e "  • ${C_BOLD}Nombre del Servidor:${C_RESET} ${C_CYAN}${SERVER_NAME}${C_RESET}"
    echo -e "  • ${C_BOLD}Número de Celular:${C_RESET}   ${C_GREEN}${CONTACT_INFO}${C_RESET}"
    echo -e "  • ${C_BOLD}Reglas de Uso:${C_RESET}       ${C_YELLOW}${CUSTOM_RULES}${C_RESET}\n"
    echo -e "${C_GRAY}(Presiona [Enter] en cualquier campo para mantener el valor actual)${C_RESET}\n"

    local in_name="" in_contact="" in_rules=""
    read -r -p "Nuevo nombre de servidor [${SERVER_NAME}]: " in_name || true
    read -r -p "Número de celular/soporte [${CONTACT_INFO}]: " in_contact || true
    read -r -p "Nuevas reglas de uso [${CUSTOM_RULES}]: " in_rules || true

    if [[ -n "${in_name:-}" ]]; then SERVER_NAME="$in_name"; fi
    if [[ -n "${in_contact:-}" ]]; then CONTACT_INFO="$in_contact"; fi
    if [[ -n "${in_rules:-}" ]]; then CUSTOM_RULES="$in_rules"; fi

    save_banner_conf
    apply_banner_system
    echo -e "\n${C_GREEN}✔ Datos actualizados y aplicados en todos los servicios SSH.${C_RESET}"
    press_enter
}

# ------------------------------------------------------------------------------
# Editar Archivo del Banner Manualmente
# ------------------------------------------------------------------------------
manual_edit_banner() {
    clear
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}      ${C_BOLD}${C_WHITE}EDITOR MANUAL DEL BANNER${C_RESET}         ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Se abrirá el editor de texto para que escribas tu propio banner.${C_RESET}"
    echo -e "${C_GRAY}Al guardar, el texto se aplicará de inmediato en OpenSSH y Dropbear.${C_RESET}\n"
    press_enter

    if command -v nano >/dev/null 2>&1; then
        nano "$BANNER_FILE"
    elif command -v vim >/dev/null 2>&1; then
        vim "$BANNER_FILE"
    else
        echo -e "${C_RED}No se encontró ningún editor de texto (nano/vim).${C_RESET}"
        press_enter
        return 1
    fi

    TEMPLATE_ID="5"
    save_banner_conf
    apply_banner_system
    echo -e "\n${C_GREEN}✔ Banner personalizado guardado y activado.${C_RESET}"
    press_enter
}

# ------------------------------------------------------------------------------
# Alternar Activar/Desactivar Banners
# ------------------------------------------------------------------------------
toggle_banner() {
    load_banner_conf
    if [[ "$BANNER_ENABLED" == "true" ]]; then
        BANNER_ENABLED="false"
        echo -e "\n${C_YELLOW}Banner de conexión (Pre-Auth) DESACTIVADO.${C_RESET}"
    else
        BANNER_ENABLED="true"
        echo -e "\n${C_GREEN}Banner de conexión (Pre-Auth) ACTIVADO.${C_RESET}"
    fi
    save_banner_conf
    apply_banner_system
    press_enter
}

toggle_dynamic_user() {
    load_banner_conf
    if [[ "$DYNAMIC_LOGIN_BANNER" == "true" ]]; then
        DYNAMIC_LOGIN_BANNER="false"
        echo -e "\n${C_YELLOW}Banner dinámico de sesión (Días, Límite y Usuario) DESACTIVADO.${C_RESET}"
    else
        DYNAMIC_LOGIN_BANNER="true"
        echo -e "\n${C_GREEN}Banner dinámico de sesión (Días, Límite y Usuario) ACTIVADO.${C_RESET}"
    fi
    save_banner_conf
    apply_banner_system
    press_enter
}

# ------------------------------------------------------------------------------
# Menú Principal de Banners
# ------------------------------------------------------------------------------
main_banner_menu() {
    while true; do
        load_banner_conf
        clear
        local b_status="${C_GREEN}[ACTIVADO]${C_RESET}"
        if [[ "$BANNER_ENABLED" != "true" ]]; then
            b_status="${C_RED}[DESACTIVADO]${C_RESET}"
        fi

        local d_status="${C_GREEN}[ACTIVADO]${C_RESET}"
        if [[ "$DYNAMIC_LOGIN_BANNER" != "true" ]]; then
            d_status="${C_RED}[DESACTIVADO]${C_RESET}"
        fi

        local t_label="Info de Cuenta (HTML)"
        case "$TEMPLATE_ID" in
            2) t_label="VIP Gold (HTML)" ;;
            3) t_label="Gaming Pro (HTML)" ;;
            4) t_label="Cyberpunk (HTML)" ;;
            5) t_label="Texto Plano" ;;
            6) t_label="Personalizado" ;;
        esac

        local u_disp="${BANNER_USER:-auto}"
        if [[ "$u_disp" == "auto" ]]; then
            get_system_user_info "auto"
            u_disp="Auto (${U_NAME})"
        fi

        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}BANNERS Y REGISTRO HTTP CUSTOM${C_RESET}    ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  • Apps: ${b_status}  ${C_YELLOW}${t_label}${C_RESET}"
        echo -e "  • Usuario: ${C_GREEN}${u_disp}${C_RESET}"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 👁️  Previsualizar banner actual"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🎨  Elegir plantilla prediseñada"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 👤  Asignar usuario del banner"
        echo -e "  ${C_YELLOW}[4]${C_RESET} ✏️  Personalizar textos/contacto"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 📝  Editar archivo manualmente"
        echo -e "  ${C_YELLOW}[6]${C_RESET} ⚡  Activar / Desactivar en Apps"
        echo -e "  ${C_YELLOW}[7]${C_RESET} 👤  Activar / Desactivar Dinámico"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"

        local opt=""
        read -r -p "Seleccione una opción [0-7]: " opt || true

        case "${opt:-}" in
            1) preview_banner ;;
            2) select_template ;;
            3) select_user_for_banner ;;
            4) customize_data ;;
            5) manual_edit_banner ;;
            6) toggle_banner ;;
            7) toggle_dynamic_user ;;
            0) break ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

case "${1:-}" in
    --preview|-p)
        preview_banner
        ;;
    --apply|-a)
        apply_banner_system
        echo -e "${C_GREEN}✔ Banner aplicado correctamente.${C_RESET}"
        ;;
    --template|-t)
        if [[ -n "${2:-}" ]]; then
            load_banner_conf
            TEMPLATE_ID="$2"
            save_banner_conf
            apply_banner_system
            echo -e "${C_GREEN}✔ Plantilla #${2} aplicada.${C_RESET}"
        else
            select_template
        fi
        ;;
    --user|-u)
        if [[ -n "${2:-}" ]]; then
            load_banner_conf
            BANNER_USER="$2"
            save_banner_conf
            apply_banner_system
            echo -e "${C_GREEN}✔ Usuario '$2' asignado al banner.${C_RESET}"
        else
            select_user_for_banner
        fi
        ;;
    --enable)
        load_banner_conf
        BANNER_ENABLED="true"
        save_banner_conf
        apply_banner_system
        echo -e "${C_GREEN}✔ Banner activado.${C_RESET}"
        ;;
    --disable)
        load_banner_conf
        BANNER_ENABLED="false"
        save_banner_conf
        apply_banner_system
        echo -e "${C_YELLOW}✔ Banner desactivado.${C_RESET}"
        ;;
    *)
        main_banner_menu
        ;;
esac
