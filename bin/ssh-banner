#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-banner
# Gestor interactivo y automatizado de Banners de Bienvenida para SSH / Dropbear
# y HTTP Custom / Apps VPN. Soporta plantillas visuales en HTML, variables del sistema
# (usuario, vencimiento, datos usados), previsualización y multiusuario.
# ==============================================================================
set -euo pipefail

CONFIG_DIR="/etc/vps-ssh-limiter"
BANNER_FILE="${CONFIG_DIR}/banner.net"
BANNER_CONF="${CONFIG_DIR}/banner.conf"
ISSUE_FILE="/etc/issue.net"
PROFILE_BANNER="/etc/profile.d/vps-ssh-banner.sh"

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

press_enter() {
    echo ""
    read -r -p "Presione [Enter] para continuar..." _ || true
}

# ------------------------------------------------------------------------------
# Cargar / Guardar Configuración del Banner
# ------------------------------------------------------------------------------
load_banner_conf() {
    BANNER_ENABLED="true"
    SERVER_NAME="SupraVPS"
    CONTACT_INFO="3826432180"
    CUSTOM_RULES="Prohibido Torrent, SPAM, DDoS y Multi-Login no autorizado"
    DYNAMIC_LOGIN_BANNER="true"
    TEMPLATE_ID="1"
    BANNER_USER="auto"

    if [[ -f "$BANNER_CONF" ]]; then
        # shellcheck disable=SC1090
        source "$BANNER_CONF" 2>/dev/null || true
    fi

    # Auto-migrar cualquier valor previo que contenga mención a Telegram o esté vacío
    if [[ "${CONTACT_INFO:-}" == *"Telegram"* || "${CONTACT_INFO:-}" == *"@Soporte"* || -z "${CONTACT_INFO:-}" ]]; then
        CONTACT_INFO="3826432180"
    fi
    if [[ -z "${BANNER_USER:-}" ]]; then
        BANNER_USER="auto"
    fi
}

save_banner_conf() {
    mkdir -p "$CONFIG_DIR"
    cat > "$BANNER_CONF" <<EOF
BANNER_ENABLED="${BANNER_ENABLED}"
SERVER_NAME="${SERVER_NAME}"
CONTACT_INFO="${CONTACT_INFO}"
CUSTOM_RULES="${CUSTOM_RULES}"
DYNAMIC_LOGIN_BANNER="${DYNAMIC_LOGIN_BANNER}"
TEMPLATE_ID="${TEMPLATE_ID}"
BANNER_USER="${BANNER_USER}"
EOF
    chmod 644 "$BANNER_CONF"
}

# ------------------------------------------------------------------------------
# Obtener Variables del Usuario desde el Sistema (chage, passwd, traffic.db, proc)
# ------------------------------------------------------------------------------
get_system_user_info() {
    local req_user="${1:-}"

    U_NAME="cliente_ssh"
    U_EXP="Sin exp."
    U_DAYS="Ilimitado"
    U_TRAFFIC="0 B"
    U_LIMIT="1"
    U_CONNS="1"

    local target=""
    if [[ -n "$req_user" && "$req_user" != "auto" ]] && id "$req_user" >/dev/null 2>&1; then
        target="$req_user"
    elif [[ -n "${BANNER_USER:-}" && "${BANNER_USER}" != "auto" ]] && id "${BANNER_USER}" >/dev/null 2>&1; then
        target="${BANNER_USER}"
    fi

    if [[ -n "$target" ]]; then
        U_NAME="$target"

        # 1. Fecha de vencimiento y días restantes desde chage
        if command -v chage >/dev/null 2>&1; then
            local raw_exp
            raw_exp=$(chage -l "$target" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
            if [[ -n "$raw_exp" && "$raw_exp" != "never" && "$raw_exp" != "nunca" ]]; then
                local exp_epoch now_epoch
                exp_epoch=$(date -d "$raw_exp" +%s 2>/dev/null || true)
                now_epoch=$(date +%s)
                if [[ -n "$exp_epoch" ]]; then
                    U_EXP=$(date -d "@$exp_epoch" +%d/%m/%Y 2>/dev/null || echo "$raw_exp")
                    local diff=$(( (exp_epoch - now_epoch) / 86400 ))
                    if [[ $diff -ge 0 ]]; then
                        U_DAYS="${diff} día(s)"
                    else
                        U_DAYS="EXPIRADO"
                    fi
                fi
            fi
        fi

        # 2. Límite de conexiones desde GECOS en /etc/passwd
        local gecos_line
        gecos_line=$(grep "^${target}:" /etc/passwd 2>/dev/null || true)
        if [[ "$gecos_line" =~ LIM[:_=-]?([0-9]+) ]]; then
            U_LIMIT="${BASH_REMATCH[1]}"
        fi

        # 3. Conexiones activas en tiempo real
        local -a u_active_pids=()
        for p in $(pgrep -u "$target" 2>/dev/null || true); do
            [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] && u_active_pids+=("$p")
        done
        U_CONNS=${#u_active_pids[@]}

        # 4. Consumo de datos usado por el usuario (traffic.db + procesos vivos)
        local u_bytes=0
        if [[ -f /etc/vps-ssh-limiter/traffic.db ]]; then
            local t_line
            t_line=$(grep "^${target}:" /etc/vps-ssh-limiter/traffic.db 2>/dev/null | head -n1 || true)
            if [[ -n "$t_line" ]]; then
                u_bytes=$(echo "$t_line" | cut -d: -f2 || echo 0)
            fi
        fi
        local pids
        pids=$(pgrep -u "$target" 2>/dev/null || true)
        for p in $pids; do
            if [[ -r "/proc/$p/io" ]]; then
                local rb wb
                rb=$(awk '/rchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
                wb=$(awk '/wchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
                u_bytes=$(( u_bytes + rb + wb ))
            fi
        done

        if [[ $u_bytes -ge 1073741824 ]]; then
            U_TRAFFIC=$(awk -v b="$u_bytes" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
        elif [[ $u_bytes -ge 1048576 ]]; then
            U_TRAFFIC=$(awk -v b="$u_bytes" 'BEGIN { printf "%.2f MB", b / 1048576 }')
        elif [[ $u_bytes -ge 1024 ]]; then
            U_TRAFFIC=$(awk -v b="$u_bytes" 'BEGIN { printf "%.1f KB", b / 1024 }')
        elif [[ $u_bytes -gt 0 ]]; then
            U_TRAFFIC="${u_bytes} B"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Generador de Plantillas Pre-Auth (Optimizado para Celulares / HTTP Custom)
# ------------------------------------------------------------------------------
generate_banner_text() {
    local t_id="${1:-$TEMPLATE_ID}"
    local s_name="${2:-$SERVER_NAME}"
    local c_info="${3:-$CONTACT_INFO}"
    local rules="${4:-$CUSTOM_RULES}"
    local target_u="${5:-${BANNER_USER:-auto}}"
    local now_date
    now_date=$(date '+%d/%m/%Y %H:%M')

    get_system_user_info "$target_u"
    local u_name="$U_NAME"
    local u_exp="$U_EXP"
    local u_days="$U_DAYS"
    local u_traffic="$U_TRAFFIC"
    local u_limit="$U_LIMIT"

    case "$t_id" in
        1)
            # Plantilla 1: ★ INFORMACIÓN DE TU CUENTA ★ (HTML Pro HTTP Custom)
            cat <<EOF
<center><font color="#00E5FF"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#FFD700"><b>★ INFORMACIÓN DE TU CUENTA ★</b></font><br>
<font color="#00E5FF"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#39FF14">● <b>Usuario:</b></font> <font color="#FFFFFF">${u_name}</font><br>
<font color="#39FF14">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${u_exp}</b></font> <font color="#00E5FF">(${u_days})</font><br>
<font color="#39FF14">● <b>Datos Usados:</b></font> <font color="#FF00FF"><b>${u_traffic}</b></font><br>
<font color="#39FF14">● <b>Dispositivos:</b></font> <font color="#00E5FF">${u_limit} permitido(s)</font><br>
<font color="#39FF14">● <b>Servidor:</b></font> <font color="#FFFFFF">${s_name} (Alta Velocidad)</font><br>
<font color="#39FF14">● <b>Estado:</b></font> <font color="#39FF14"><b>ACTIVO Y OPTIMIZADO</b></font><br>
<font color="#39FF14">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${now_date}</font><br>
<font color="#39FF14">● <b>Contacto:</b></font> <font color="#FFD700"><b>${c_info}</b></font><br>
<font color="#888888">─────────────────────────────────────</font><br>
<center><font color="#FF3366">⚠️ <b>Prohibido Torrent, SPAM y Multi-Login</b></font><br>
<font color="#00E5FF"><b>★ Conexión Estable y de Alta Calidad ★</b></font></center>
EOF
            ;;
        2)
            # Plantilla 2: ★ VIP GOLD PREMIUM ★ (HTML Neón Dorado)
            cat <<EOF
<center><font color="#FFD700"><b>★ ★ ★ ${s_name} VIP NETWORK ★ ★ ★</b></font><br>
<font color="#FFA500"><b>─────────────────────────────────────</b></font></center><br>
<font color="#FFD700">● <b>Usuario:</b></font> <font color="#FFFFFF">${u_name}</font><br>
<font color="#FFD700">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${u_exp}</b></font> <font color="#FFA500">(${u_days})</font><br>
<font color="#FFD700">● <b>Datos Usados:</b></font> <font color="#39FF14"><b>${u_traffic}</b></font><br>
<font color="#FFD700">● <b>Dispositivos:</b></font> <font color="#FFA500">${u_limit} permitido(s)</font><br>
<font color="#FFD700">● <b>Servidor:</b></font> <font color="#FFFFFF">${s_name} VIP</font><br>
<font color="#FFD700">● <b>Estado:</b></font> <font color="#39FF14"><b>CONECTADO / VIP ULTRA</b></font><br>
<font color="#FFD700">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${now_date}</font><br>
<font color="#FFD700">● <b>Contacto:</b></font> <font color="#00E5FF"><b>${c_info}</b></font><br>
<font color="#FFA500">─────────────────────────────────────</font><br>
<center><font color="#FF4444">⚠️ <b>Prohibido Descargas Torrent y Abusos</b></font><br>
<font color="#FFD700"><b>★ Servicio Exclusivo de Alta Velocidad ★</b></font></center>
EOF
            ;;
        3)
            # Plantilla 3: 🎮 GAMING LOW-PING PRO 🎮 (HTML Gamer)
            cat <<EOF
<center><font color="#39FF14"><b>🎮 ${s_name} GAMING LOW-PING PRO 🎮</b></font><br>
<font color="#00FFCC"><b>─────────────────────────────────────</b></font></center><br>
<font color="#39FF14">● <b>Usuario:</b></font> <font color="#FFFFFF">${u_name}</font><br>
<font color="#39FF14">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${u_exp}</b></font> <font color="#00FFCC">(${u_days})</font><br>
<font color="#39FF14">● <b>Datos Usados:</b></font> <font color="#00FFCC"><b>${u_traffic}</b></font><br>
<font color="#39FF14">● <b>TCP BBR:</b></font> <font color="#39FF14"><b>ACTIVO (Anti-Lag)</b></font><br>
<font color="#39FF14">● <b>Dispositivos:</b></font> <font color="#00E5FF">${u_limit} permitido(s)</font><br>
<font color="#39FF14">● <b>Servidor:</b></font> <font color="#FFFFFF">${s_name} Gaming</font><br>
<font color="#39FF14">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${now_date}</font><br>
<font color="#39FF14">● <b>Contacto:</b></font> <font color="#FFD700"><b>${c_info}</b></font><br>
<font color="#00FFCC">─────────────────────────────────────</font><br>
<center><font color="#FF3333">⚠️ <b>Prohibido Torrent, P2P y Multi-Login</b></font><br>
<font color="#39FF14"><b>★ Máxima Velocidad y Menor Latencia ★</b></font></center>
EOF
            ;;
        4)
            # Plantilla 4: ⚡ CYBERPUNK NEON ⚡ (HTML Neón Rosa/Cyan)
            cat <<EOF
<center><font color="#FF007F"><b>⚡ ${s_name} CYBERPUNK HIGH SPEED ⚡</b></font><br>
<font color="#00F0FF"><b>═════════════════════════════════════</b></font></center><br>
<font color="#00F0FF">► <b>Usuario:</b></font> <font color="#FFFFFF">${u_name}</font><br>
