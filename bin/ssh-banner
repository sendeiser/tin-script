#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-banner
# Gestor interactivo y automatizado de Banners de Bienvenida para SSH / Dropbear
# y HTTP Custom / Apps VPN. Soporta plantillas visuales, previsualización,
# configuración de OpenSSH/Dropbear y banner dinámico con días y límites.
# ==============================================================================
set -euo pipefail

CONFIG_DIR="/etc/vps-ssh-limiter"
BANNER_FILE="${CONFIG_DIR}/banner.net"
BANNER_CONF="${CONFIG_DIR}/banner.conf"
ISSUE_FILE="/etc/issue.net"
PROFILE_BANNER="/etc/profile.d/vps-ssh-banner.sh"

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

press_enter() {
    echo ""
    read -r -p "Presione [Enter] para continuar..." _ || true
}

# ------------------------------------------------------------------------------
# Cargar / Guardar Configuración del Banner
# ------------------------------------------------------------------------------
load_banner_conf() {
    BANNER_ENABLED="true"
    SERVER_NAME="SupraVPS"
    CONTACT_INFO="@Soporte_Telegram"
    CUSTOM_RULES="Prohibido Torrent, SPAM, DDoS y Multi-Login no autorizado"
    DYNAMIC_LOGIN_BANNER="true"
    TEMPLATE_ID="1"

    if [[ -f "$BANNER_CONF" ]]; then
        # shellcheck disable=SC1090
        source "$BANNER_CONF" 2>/dev/null || true
    fi
}

save_banner_conf() {
    mkdir -p "$CONFIG_DIR"
    cat > "$BANNER_CONF" <<EOF
BANNER_ENABLED="${BANNER_ENABLED}"
SERVER_NAME="${SERVER_NAME}"
CONTACT_INFO="${CONTACT_INFO}"
CUSTOM_RULES="${CUSTOM_RULES}"
DYNAMIC_LOGIN_BANNER="${DYNAMIC_LOGIN_BANNER}"
TEMPLATE_ID="${TEMPLATE_ID}"
EOF
    chmod 644 "$BANNER_CONF"
}

# ------------------------------------------------------------------------------
# Generador de Plantillas Pre-Auth (Para HTTP Custom, Dropbear y OpenSSH)
# ------------------------------------------------------------------------------
generate_banner_text() {
    local t_id="${1:-$TEMPLATE_ID}"
    local s_name="${2:-$SERVER_NAME}"
    local c_info="${3:-$CONTACT_INFO}"
    local rules="${4:-$CUSTOM_RULES}"

    case "$t_id" in
        1)
            # Cyberpunk Neon
            cat <<EOF
╔══════════════════════════════════════════════════════════════╗
║               ⚡ ${s_name} - HIGH SPEED SSH ⚡                ║
╚══════════════════════════════════════════════════════════════╝
 ● Servidor:     ${s_name} (CDN WebSocket & Direct SSH)
 ● Estado:       ONLINE ● Conexión Segura y Cifrada
 ● Soporte:      ${c_info}
────────────────────────────────────────────────────────────────
 [ REGLAS OBLIGATORIAS DE USO ]
 ✖ PROHIBIDO TORRENT / P2P / BITTORENT (Bloqueo permanente)
 ✖ PROHIBIDO ATAQUES DDOS / SPAM / CARDING
 ✖ PROHIBIDO EXCEDER EL LÍMITE DE DISPOSITIVOS CONTRATADOS
────────────────────────────────────────────────────────────────
 ★ ¡Gracias por tu preferencia! Conexión Estable y Veloz ★
════════════════════════════════════════════════════════════════
EOF
            ;;
        2)
            # VIP Gold Premium
            cat <<EOF
╔══════════════════════════════════════════════════════════════╗
║            ★ ★ ★ ${s_name} VIP NETWORK ★ ★ ★           ║
╚══════════════════════════════════════════════════════════════╝
 👑 ¡Bienvenido a tu conexión VIP de Ultra Alta Velocidad!
 🌐 Red Premium con Aceleración TCP y Protección Anti-DDoS.

 📌 Soporte y Renovaciones: ${c_info}
 💬 Contacto Oficial:       ${c_info}

 ⚠️ Reglas del Servicio:
    - ${rules}
    - Respetar el límite de conexiones simultáneas.
════════════════════════════════════════════════════════════════
EOF
            ;;
        3)
            # Clean Minimalist
            cat <<EOF
┌──────────────────────────────────────────────────────────────┐
│ ${s_name} :: Secure SSH & WebSocket Tunnel Gateway           │
└──────────────────────────────────────────────────────────────┘
  Status: Online ● Latencia: Ultra-Baja ● CDN Activo
  Soporte: ${c_info}
  Reglas: ${rules}
────────────────────────────────────────────────────────────────
EOF
            ;;
        4)
            # Gaming & Streaming
            cat <<EOF
╔══════════════════════════════════════════════════════════════╗
║           🎮 ${s_name} GAMING & STREAMING PRO 🎮            ║
╚══════════════════════════════════════════════════════════════╝
 ⚡ Optimizado para Free Fire, PUBG, Call of Duty, YouTube 4K.
 🚀 Acelerador TCP BBR Activado (Ping Mínimo y Cero Jitter).
 🎧 Soporte Técnico: ${c_info}
 🚫 Cero tolerancia: ${rules}
════════════════════════════════════════════════════════════════
EOF
            ;;
        *)
            if [[ -f "$BANNER_FILE" ]]; then
                cat "$BANNER_FILE"
            else
                generate_banner_text 1 "$s_name" "$c_info" "$rules"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Aplicar Banner en Dropbear, OpenSSH y MOTD
# ------------------------------------------------------------------------------
apply_banner_system() {
    load_banner_conf

    mkdir -p "$CONFIG_DIR"
    mkdir -p "/etc/dropbear"

    if [[ "$BANNER_ENABLED" == "true" ]]; then
        if [[ "$TEMPLATE_ID" != "5" || ! -f "$BANNER_FILE" || ! -s "$BANNER_FILE" ]]; then
            generate_banner_text "$TEMPLATE_ID" "$SERVER_NAME" "$CONTACT_INFO" "$CUSTOM_RULES" > "$BANNER_FILE"
        fi
        cp -f "$BANNER_FILE" "$ISSUE_FILE" 2>/dev/null || true
        cp -f "$BANNER_FILE" "/etc/dropbear/banner" 2>/dev/null || true
        chmod 644 "$BANNER_FILE" "$ISSUE_FILE" "/etc/dropbear/banner" 2>/dev/null || true
    else
        echo -n "" > "$BANNER_FILE"
        echo -n "" > "$ISSUE_FILE"
        rm -f "/etc/dropbear/banner" 2>/dev/null || true
    fi

    # Configurar OpenSSH
    if [[ -f /etc/ssh/sshd_config ]]; then
        if grep -q "^#\?Banner" /etc/ssh/sshd_config; then
            sed -i "s|^#\?Banner.*|Banner ${BANNER_FILE}|g" /etc/ssh/sshd_config
        else
            echo "Banner ${BANNER_FILE}" >> /etc/ssh/sshd_config
        fi
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    fi

    # Configurar Dropbear
    if [[ -f /etc/default/dropbear ]]; then
        if grep -q "^#\?DROPBEAR_BANNER=" /etc/default/dropbear; then
            sed -i "s|^#\?DROPBEAR_BANNER=.*|DROPBEAR_BANNER=\"${BANNER_FILE}\"|g" /etc/default/dropbear
        else
            echo "DROPBEAR_BANNER=\"${BANNER_FILE}\"" >> /etc/default/dropbear
        fi

        # Asegurar -b flag en DROPBEAR_EXTRA_ARGS (Obligatorio para systemd en Debian/Ubuntu)
        local cur_extra=""
        cur_extra=$(grep "^DROPBEAR_EXTRA_ARGS=" /etc/default/dropbear | cut -d= -f2- | tr -d '"' | tr -d "'" || true)
        cur_extra=$(echo "$cur_extra" | sed -E 's/-b\s+[^ ]+//g' | xargs)
        if [[ -z "$cur_extra" ]]; then
            cur_extra="-p 90 -p 109"
        fi

        if [[ "$BANNER_ENABLED" == "true" ]]; then
            cur_extra="${cur_extra} -b ${BANNER_FILE}"
        fi

        sed -i "s|^DROPBEAR_EXTRA_ARGS=.*|DROPBEAR_EXTRA_ARGS=\"${cur_extra}\"|g" /etc/default/dropbear
        systemctl restart dropbear 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
    fi

    # Configurar Banner Dinámico de Usuario en Login (/etc/profile.d/vps-ssh-banner.sh)
    if [[ "$DYNAMIC_LOGIN_BANNER" == "true" ]]; then
        cat > "$PROFILE_BANNER" <<'EOF'
# ==============================================================================
# vps-ssh-limiter: Banner dinámico de sesión de usuario
# ==============================================================================
if [[ -n "$USER" && "$USER" != "root" && -t 1 ]]; then
    _now_epoch=$(date +%s)
    _exp_date="Sin exp."
    _days_left="Ilimitado"
    _limit="1"
    _conns="1"

    if command -v chage >/dev/null 2>&1; then
        _exp_raw=$(chage -l "$USER" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$_exp_raw" && "$_exp_raw" != "never" && "$_exp_raw" != "nunca" ]]; then
            _exp_epoch=$(date -d "$_exp_raw" +%s 2>/dev/null || true)
            if [[ -n "$_exp_epoch" ]]; then
                _exp_date=$(date -d "@$_exp_epoch" +%Y-%m-%d 2>/dev/null || echo "$_exp_raw")
                _diff=$(( (_exp_epoch - _now_epoch) / 86400 ))
                if [[ $_diff -ge 0 ]]; then
                    _days_left="${_diff} día(s)"
                else
                    _days_left="EXPIRADO"
                fi
            fi
        fi
    fi

    # Límite desde /etc/passwd
    _pass_line=$(grep "^${USER}:" /etc/passwd 2>/dev/null | head -n1 || true)
    if [[ "$_pass_line" =~ LIM[:_=-]?([0-9]+) ]]; then
        _limit="${BASH_REMATCH[1]}"
    fi

    # Conexiones activas del usuario
    _s_pids=$(pgrep -u "$USER" -f "^sshd: $USER@" 2>/dev/null | wc -w || echo 0)
    _d_pids=$(pgrep -u "$USER" -x "dropbear" 2>/dev/null | wc -w || echo 0)
    _conns=$(( _s_pids + _d_pids ))

    _sname="SupraVPS"
    if [[ -f /etc/vps-ssh-limiter/banner.conf ]]; then
        # shellcheck disable=SC1091
        source /etc/vps-ssh-limiter/banner.conf 2>/dev/null || true
        _sname="${SERVER_NAME:-SupraVPS}"
    fi

    echo -e "\033[1;36m╔══════════════════════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║\033[0m \033[1;37m★ BIENVENIDO A ${_sname} - INFORMACIÓN DE TU CUENTA ★\033[0m        \033[1;36m║\033[0m"
    echo -e "\033[1;36m╚══════════════════════════════════════════════════════════════════╝\033[0m"
    echo -e "  \033[1;33m👤 Usuario:\033[0m          \033[1;37m${USER}\033[0m"
    echo -e "  \033[1;33m📅 Vencimiento:\033[0m      \033[1;32m${_exp_date}\033[0m (Restante: \033[1;36m${_days_left}\033[0m)"
    echo -e "  \033[1;33m📱 Dispositivos:\033[0m     \033[1;35m${_conns} de ${_limit} permitidos\033[0m"
    echo -e "  \033[1;33m🚀 Estado:\033[0m           \033[1;32mConectado y Optimizado\033[0m"
    if [[ -n "${CONTACT_INFO:-}" ]]; then
        echo -e "  \033[1;33m📞 Soporte:\033[0m          \033[1;37m${CONTACT_INFO}\033[0m"
    fi
    echo -e "\033[0;90m──────────────────────────────────────────────────────────────────\033[0m"
fi
EOF
        chmod 644 "$PROFILE_BANNER"
    else
        rm -f "$PROFILE_BANNER" 2>/dev/null || true
    fi

    save_banner_conf
}

# ------------------------------------------------------------------------------
# Previsualización del Banner
# ------------------------------------------------------------------------------
preview_banner() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}           PREVISUALIZACIÓN DEL BANNER (VISTA HTTP CUSTOM)            ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_GRAY}Así es exactamente como verán el mensaje tus usuarios en el registro de la app:${C_RESET}\n"
    echo -e "${C_BOLD}${C_WHITE}┌──────────────────────── REGISTRO HTTP CUSTOM ────────────────────────┐${C_RESET}"
    if [[ -f "$BANNER_FILE" && -s "$BANNER_FILE" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            echo -e "│ ${C_YELLOW}${line}${C_RESET}"
        done < "$BANNER_FILE"
    else
        echo -e "│ ${C_GRAY}(El banner se encuentra vacío o desactivado)${C_RESET}"
    fi
    echo -e "${C_BOLD}${C_WHITE}└──────────────────────────────────────────────────────────────────────┘${C_RESET}\n"

    if [[ "$DYNAMIC_LOGIN_BANNER" == "true" ]]; then
        echo -e "${C_BOLD}${C_CYAN}★ Vista Previa del Banner Dinámico de Usuario (Login/Terminal):${C_RESET}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}👤 Usuario:${C_RESET}          ${C_BOLD}cliente_demo${C_RESET}"
        echo -e "  ${C_YELLOW}📅 Vencimiento:${C_RESET}      ${C_GREEN}2026-10-15${C_RESET} (Restante: ${C_CYAN}30 día(s)${C_RESET})"
        echo -e "  ${C_YELLOW}📱 Dispositivos:${C_RESET}     ${C_MAGENTA}1 de 2 permitidos${C_RESET}"
        echo -e "  ${C_YELLOW}🚀 Estado:${C_RESET}           ${C_GREEN}Conectado y Optimizado${C_RESET}"
        echo -e "  ${C_YELLOW}📞 Soporte:${C_RESET}          ${C_WHITE}${CONTACT_INFO}${C_RESET}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
    fi

    press_enter
}

# ------------------------------------------------------------------------------
# Selección de Plantilla
# ------------------------------------------------------------------------------
select_template() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}              SELECCIONAR PLANTILLA DE BANNER                  ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "  ${C_YELLOW}[1] ⚡ Neon Cyberpunk (Hacker Pro)${C_RESET}"
    echo -e "      • Bordes dobles, etiquetas de estado, reglas de bloqueo, Telegram."
    echo -e "  ${C_YELLOW}[2] ★ VIP Gold Premium (Elegante y Comercial)${C_RESET}"
    echo -e "      • Estrellas VIP, mensaje cordial, contacto oficial, alta calidad."
    echo -e "  ${C_YELLOW}[3] 🔹 Clean Minimalist (Moderno y Compacto)${C_RESET}"
    echo -e "      • Diseño súper limpio, sin sobrecargar los logs de la app."
    echo -e "  ${C_YELLOW}[4] 🎮 Gaming & Low Latency (Gamer Pro)${C_RESET}"
    echo -e "      • Enfoque en juegos (Free Fire/PUBG/COD), TCP BBR y anti-lag."
    echo -e "  ${C_RED}[0] Cancelar${C_RESET}\n"

    local opt_t=""
    read -r -p "Selecciona una plantilla [0-4]: " opt_t || true
    if [[ "$opt_t" =~ ^[1-4]$ ]]; then
        TEMPLATE_ID="$opt_t"
        save_banner_conf
        apply_banner_system
        echo -e "\n${C_GREEN}✔ Plantilla #${TEMPLATE_ID} aplicada exitosamente en OpenSSH y Dropbear.${C_RESET}"
        press_enter
    fi
}

# ------------------------------------------------------------------------------
# Personalizar Datos del Banner (Servidor, Contacto, Reglas)
# ------------------------------------------------------------------------------
customize_data() {
    load_banner_conf
    clear
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}           PERSONALIZAR DATOS Y TEXTOS DEL BANNER             ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "Valores actuales:"
    echo -e "  • ${C_BOLD}Nombre del Servidor:${C_RESET} ${C_CYAN}${SERVER_NAME}${C_RESET}"
    echo -e "  • ${C_BOLD}Contacto / Soporte:${C_RESET}  ${C_GREEN}${CONTACT_INFO}${C_RESET}"
    echo -e "  • ${C_BOLD}Reglas de Uso:${C_RESET}       ${C_YELLOW}${CUSTOM_RULES}${C_RESET}\n"
    echo -e "${C_GRAY}(Presiona [Enter] en cualquier campo para mantener el valor actual)${C_RESET}\n"

    local in_name="" in_contact="" in_rules=""
    read -r -p "Nuevo nombre de servidor [${SERVER_NAME}]: " in_name || true
    read -r -p "Nuevo contacto/soporte [${CONTACT_INFO}]: " in_contact || true
    read -r -p "Nuevas reglas de uso [${CUSTOM_RULES}]: " in_rules || true

    if [[ -n "${in_name:-}" ]]; then SERVER_NAME="$in_name"; fi
    if [[ -n "${in_contact:-}" ]]; then CONTACT_INFO="$in_contact"; fi
    if [[ -n "${in_rules:-}" ]]; then CUSTOM_RULES="$in_rules"; fi

    save_banner_conf
    apply_banner_system
    echo -e "\n${C_GREEN}✔ Datos actualizados y aplicados en todos los servicios SSH.${C_RESET}"
    press_enter
}

# ------------------------------------------------------------------------------
# Editar Archivo del Banner Manualmente
# ------------------------------------------------------------------------------
manual_edit_banner() {
    clear
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}           EDITOR MANUAL DEL ARCHIVO DE BANNER                ${C_RESET}${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Se abrirá el editor de texto para que escribas tu propio banner.${C_RESET}"
    echo -e "${C_GRAY}Al guardar, el texto se aplicará de inmediato en OpenSSH y Dropbear.${C_RESET}\n"
    press_enter

    if command -v nano >/dev/null 2>&1; then
        nano "$BANNER_FILE"
    elif command -v vim >/dev/null 2>&1; then
        vim "$BANNER_FILE"
    else
        echo -e "${C_RED}No se encontró ningún editor de texto (nano/vim).${C_RESET}"
        press_enter
        return 1
    fi

    TEMPLATE_ID="5"
    save_banner_conf
    apply_banner_system
    echo -e "\n${C_GREEN}✔ Banner personalizado guardado y activado.${C_RESET}"
    press_enter
}

# ------------------------------------------------------------------------------
# Alternar Activar/Desactivar Banners
# ------------------------------------------------------------------------------
toggle_banner() {
    load_banner_conf
    if [[ "$BANNER_ENABLED" == "true" ]]; then
        BANNER_ENABLED="false"
        echo -e "\n${C_YELLOW}Banner de conexión (Pre-Auth) DESACTIVADO.${C_RESET}"
    else
        BANNER_ENABLED="true"
        echo -e "\n${C_GREEN}Banner de conexión (Pre-Auth) ACTIVADO.${C_RESET}"
    fi
    save_banner_conf
    apply_banner_system
    press_enter
}

toggle_dynamic_user() {
    load_banner_conf
    if [[ "$DYNAMIC_LOGIN_BANNER" == "true" ]]; then
        DYNAMIC_LOGIN_BANNER="false"
        echo -e "\n${C_YELLOW}Banner dinámico de sesión (Días, Límite y Usuario) DESACTIVADO.${C_RESET}"
    else
        DYNAMIC_LOGIN_BANNER="true"
        echo -e "\n${C_GREEN}Banner dinámico de sesión (Días, Límite y Usuario) ACTIVADO.${C_RESET}"
    fi
    save_banner_conf
    apply_banner_system
    press_enter
}

# ------------------------------------------------------------------------------
# Menú Principal de Banners
# ------------------------------------------------------------------------------
main_banner_menu() {
    while true; do
        load_banner_conf
        clear
        local b_status="${C_GREEN}[ACTIVADO]${C_RESET}"
        if [[ "$BANNER_ENABLED" != "true" ]]; then
            b_status="${C_RED}[DESACTIVADO]${C_RESET}"
        fi

        local d_status="${C_GREEN}[ACTIVADO]${C_RESET}"
        if [[ "$DYNAMIC_LOGIN_BANNER" != "true" ]]; then
            d_status="${C_RED}[DESACTIVADO]${C_RESET}"
        fi

        local t_label="Cyberpunk Neon"
        case "$TEMPLATE_ID" in
            2) t_label="VIP Gold Premium" ;;
            3) t_label="Clean Minimalist" ;;
            4) t_label="Gaming Pro" ;;
            5) t_label="Personalizado" ;;
        esac

        echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}        GESTIÓN DE BANNERS Y BIENVENIDA SSH / APPS            ${C_RESET}${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
        echo -e "  • Banner en Apps (HTTP Custom): ${b_status}  Plantilla: ${C_YELLOW}${t_label}${C_RESET}"
        echo -e "  • Info Dinámica de Usuario:     ${d_status}  Servidor:  ${C_CYAN}${SERVER_NAME}${C_RESET}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 👁️  Previsualizar banner actual"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🎨  Elegir plantilla prediseñada (Cyberpunk, VIP, Gamer, Minimal)"
        echo -e "  ${C_YELLOW}[3]${C_RESET} ✏️  Personalizar textos (Nombre de servidor, contacto, reglas)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 📝  Editar archivo de banner manualmente (Editor libre)"
        echo -e "  ${C_YELLOW}[5]${C_RESET} ⚡  Activar / Desactivar Banner en Apps (${b_status})"
        echo -e "  ${C_YELLOW}[6]${C_RESET} 👤  Activar / Desactivar Info Dinámica de Usuario (${d_status})"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"

        local opt=""
        read -r -p "Seleccione una opción [0-6]: " opt || true

        case "${opt:-}" in
            1) preview_banner ;;
            2) select_template ;;
            3) customize_data ;;
            4) manual_edit_banner ;;
            5) toggle_banner ;;
            6) toggle_dynamic_user ;;
            0) break ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

case "${1:-}" in
    --preview|-p)
        preview_banner
        ;;
    --apply|-a)
        apply_banner_system
        echo -e "${C_GREEN}✔ Banner aplicado correctamente.${C_RESET}"
        ;;
    --template|-t)
        if [[ -n "${2:-}" ]]; then
            load_banner_conf
            TEMPLATE_ID="$2"
            save_banner_conf
            apply_banner_system
            echo -e "${C_GREEN}✔ Plantilla #${2} aplicada.${C_RESET}"
        else
            select_template
        fi
        ;;
    --enable)
        load_banner_conf
        BANNER_ENABLED="true"
        save_banner_conf
        apply_banner_system
        echo -e "${C_GREEN}✔ Banner activado.${C_RESET}"
        ;;
    --disable)
        load_banner_conf
        BANNER_ENABLED="false"
        save_banner_conf
        apply_banner_system
        echo -e "${C_YELLOW}✔ Banner desactivado.${C_RESET}"
        ;;
    *)
        main_banner_menu
        ;;
esac
