#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-trial
# Generador de Cuentas Temporales (Trial) para Pruebas de Clientes.
# Auto-expiración garantizada mediante temporizador transitorio de systemd, at y ssh-limiter.
# ==============================================================================
set -euo pipefail

# Configuración de Colores ANSI Minimalista y de Alto Contraste
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_BORDER="\033[0;36m"
    C_TITLE="\033[1;37m"
    C_LABEL="\033[1;36m"
    C_VAL="\033[1;37m"
    C_NUM="\033[1;33m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_WHITE="\033[1;37m"
    C_GRAY="\033[0;36m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_BORDER=""
    C_TITLE=""
    C_LABEL=""
    C_VAL=""
    C_NUM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_WHITE=""
    C_GRAY=""
fi

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Este script debe ejecutarse con privilegios de root (sudo ssh-trial)." >&2
    exit 1
fi

# Parámetros por defecto
DEFAULT_PASS="1"
DEFAULT_LIMIT="1"
DEFAULT_MINUTES="60"

# Obtención de IP pública del servidor
get_server_ip() {
    curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
    curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
    ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
    hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1"
}

# Obtención del dominio configurado
get_server_domain() {
    if [[ -f /etc/vps-ssh-limiter/domain && -s /etc/vps-ssh-limiter/domain ]]; then
        tr -d '[:space:]' < /etc/vps-ssh-limiter/domain
    else
        get_server_ip
    fi
}

# Generación segura de nombre de usuario aleatorio: trial + 4 dígitos (sin riesgo de SIGPIPE)
generate_trial_name() {
    echo "trial$(( 1000 + RANDOM % 9000 ))"
}

clear
echo -e "${C_BORDER}╭════════════════════════════════════════════════════════════╮${C_RESET}"
echo -e "${C_BORDER}│${C_RESET}       ${C_BOLD}${C_WHITE}★ GENERADOR DE CUENTAS TRIAL (TEST / DEMO) ★${C_RESET}        ${C_BORDER}│${C_RESET}"
echo -e "${C_BORDER}╰════════════════════════════════════════════════════════════╯${C_RESET}"
echo -e " ${C_LABEL}Genera accesos temporales para clientes con auto-borrado.${C_RESET}\n"

# 1. Nombre de Usuario
SUGGESTED_USER=$(generate_trial_name)
while id "$SUGGESTED_USER" >/dev/null 2>&1; do
    SUGGESTED_USER=$(generate_trial_name)
done

read -r -p " Nombre de Usuario [$SUGGESTED_USER]: " INPUT_USER || true
USERNAME="${INPUT_USER:-$SUGGESTED_USER}"

# Sanitización de usuario
if [[ ! "$USERNAME" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Nombre de usuario inválido. Use solo caracteres alfanuméricos." >&2
    exit 1
fi

if id "$USERNAME" >/dev/null 2>&1; then
    echo -e "${C_RED}[ERROR]${C_RESET} El usuario '$USERNAME' ya existe en el sistema." >&2
    exit 1
fi

# 2. Contraseña
read -r -p " Contraseña de acceso [$DEFAULT_PASS]: " INPUT_PASS || true
PASSWORD="${INPUT_PASS:-$DEFAULT_PASS}"

# 3. Límite de conexiones simultáneas
read -r -p " Límite de conexiones [$DEFAULT_LIMIT]: " INPUT_LIMIT || true
LIMIT="${INPUT_LIMIT:-$DEFAULT_LIMIT}"
if [[ ! "$LIMIT" =~ ^[0-9]+$ || "$LIMIT" -le 0 ]]; then
    LIMIT=1
fi

# 4. Duración de la cuenta en minutos
echo -e "\n ${C_BOLD}Seleccione la duración del periodo de prueba:${C_RESET}"
echo -e "  ${C_NUM}[1]${C_RESET} 30 Minutos"
echo -e "  ${C_NUM}[2]${C_RESET} 60 Minutos (1 Hora - Recomendado)"
echo -e "  ${C_NUM}[3]${C_RESET} 120 Minutos (2 Horas)"
echo -e "  ${C_NUM}[4]${C_RESET} 24 Horas (1 Día)"
echo -e "  ${C_NUM}[5]${C_RESET} Duración personalizada (en minutos)"
read -r -p " Opción [1-5, por defecto 2]: " TIME_OPT || true

case "${TIME_OPT:-2}" in
    1) DURATION_MIN=30 ;;
    2) DURATION_MIN=60 ;;
    3) DURATION_MIN=120 ;;
    4) DURATION_MIN=1440 ;;
    5)
        read -r -p " Ingrese los minutos de duración: " CUST_MIN || true
        if [[ "$CUST_MIN" =~ ^[0-9]+$ && "$CUST_MIN" -gt 0 ]]; then
            DURATION_MIN="$CUST_MIN"
        else
            DURATION_MIN=60
        fi
        ;;
    *) DURATION_MIN=60 ;;
esac

DURATION_SEC=$(( DURATION_MIN * 60 ))
NOW_EPOCH=$(date +%s)
EXPIRE_EPOCH=$(( NOW_EPOCH + DURATION_SEC ))
EXPIRE_STR=$(date -d "@${EXPIRE_EPOCH}" +"%H:%M:%S (%d/%m/%Y)" 2>/dev/null || date +"%T")
EXPIRY_DATE=$(date -d "@$(( EXPIRE_EPOCH + 86400 ))" +%Y-%m-%d 2>/dev/null || date -d "+1 day" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)

# 5. Selección y Autorización de Shell
RESTRICTED_SHELL="/usr/local/bin/ssh-tunnel-shell"
if [[ ! -x "$RESTRICTED_SHELL" ]]; then
    if [[ -x "/bin/ssh-tunnel-shell" ]]; then
        RESTRICTED_SHELL="/bin/ssh-tunnel-shell"
    elif [[ -x "/bin/false" ]]; then
        RESTRICTED_SHELL="/bin/false"
    else
        RESTRICTED_SHELL="/usr/sbin/nologin"
    fi
fi

# Asegurar que la shell esté autorizada en /etc/shells para autenticación PAM
if [[ -f /etc/shells ]] && ! grep -Fxq "$RESTRICTED_SHELL" /etc/shells 2>/dev/null; then
    echo "$RESTRICTED_SHELL" >> /etc/shells
fi

# 6. Creación del usuario en Linux
# Se utiliza LIM:$LIMIT como estándar de cuota y LIM-$LIMIT como fallback si shadow-utils rechaza ':'
GECOS_VALUE="LIM:${LIMIT}"
if useradd \
    --no-create-home \
    --home-dir /nonexistent \
    --shell "$RESTRICTED_SHELL" \
    --expiredate "$EXPIRY_DATE" \
    --comment "$GECOS_VALUE" \
    "$USERNAME" 2>/dev/null; then
    :
elif useradd \
    --no-create-home \
    --home-dir /nonexistent \
    --shell "$RESTRICTED_SHELL" \
    --expiredate "$EXPIRY_DATE" \
    --comment "LIM-${LIMIT}" \
    "$USERNAME" 2>/dev/null; then
    :
elif useradd -s "$RESTRICTED_SHELL" -c "LIM-${LIMIT}" "$USERNAME" 2>/dev/null; then
    :
else
    useradd -s "$RESTRICTED_SHELL" "$USERNAME" 2>/dev/null || useradd "$USERNAME"
fi

# Asignación segura de contraseña (chpasswd + fallback a passwd estándar)
echo "${USERNAME}:${PASSWORD}" | chpasswd 2>/dev/null || \
echo -e "${PASSWORD}\n${PASSWORD}" | passwd "$USERNAME" 2>/dev/null || true

# 7. Programar borrado automático redundante
# A. Mediante temporizador de systemd-run (unidad única por epoch para evitar colisiones)
if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --unit="trial-${USERNAME}-${NOW_EPOCH}" --on-active="${DURATION_SEC}s" /bin/bash -c "
        if [[ -x /usr/local/bin/ssh-userdel ]]; then
            /usr/local/bin/ssh-userdel '$USERNAME' >/dev/null 2>&1 || true
        else
            /usr/local/bin/ssh-killuser '$USERNAME' 2>/dev/null || pkill -u '$USERNAME' -9 2>/dev/null || true
            userdel -f -r '$USERNAME' 2>/dev/null || userdel -f '$USERNAME' 2>/dev/null || true
        fi
        rm -f '/etc/vps-ssh-limiter/trials/ticket-${USERNAME}.txt' 2>/dev/null || true
        if [[ -f /etc/vps-ssh-limiter/trials.db ]]; then
            sed -i '/^${USERNAME}:/d' /etc/vps-ssh-limiter/trials.db 2>/dev/null || true
        fi
    " >/dev/null 2>&1 || true
fi

# B. Mediante demonio 'at' si está presente
if command -v at >/dev/null 2>&1; then
    echo "if [[ -x /usr/local/bin/ssh-userdel ]]; then /usr/local/bin/ssh-userdel '$USERNAME'; else userdel -f '$USERNAME'; fi; rm -f '/etc/vps-ssh-limiter/trials/ticket-${USERNAME}.txt'" | at now + "${DURATION_MIN}" minutes >/dev/null 2>&1 || true
fi

# C. Registro en base de datos local de trials para supervisión por demonio ssh-limiter
mkdir -p /etc/vps-ssh-limiter/trials
echo "${USERNAME}:${EXPIRE_EPOCH}:${DURATION_MIN}" >> /etc/vps-ssh-limiter/trials.db 2>/dev/null || true

# 8. Obtener datos de red y puertos
SERVER_IP=$(get_server_ip)
SERVER_DOMAIN=$(get_server_domain)

clear
echo -e "${C_BORDER}╭════════════════════════════════════════════════════════════╮${C_RESET}"
echo -e "${C_BORDER}│${C_RESET}            ${C_BOLD}${C_GREEN}✔ CUENTA TRIAL CREADA EXITOSAMENTE ★${C_RESET}            ${C_BORDER}│${C_RESET}"
echo -e "${C_BORDER}╰════════════════════════════════════════════════════════════╯${C_RESET}"
echo -e " ${C_LABEL}Usuario        :${C_RESET} ${C_VAL}${USERNAME}${C_RESET}"
echo -e " ${C_LABEL}Contraseña     :${C_RESET} ${C_VAL}${PASSWORD}${C_RESET}"
echo -e " ${C_LABEL}Límite Disp.   :${C_RESET} ${C_VAL}${LIMIT} Conexión(es)${C_RESET}"
echo -e " ${C_LABEL}Tiempo Activo  :${C_RESET} ${C_GREEN}${DURATION_MIN} Minutos${C_RESET}"
echo -e " ${C_LABEL}Expira a las   :${C_RESET} ${C_RED}${EXPIRE_STR}${C_RESET}"
echo -e "${C_BORDER}──────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_LABEL}Host / Dominio :${C_RESET} ${C_VAL}${SERVER_DOMAIN}${C_RESET}"
echo -e " ${C_LABEL}Dirección IP   :${C_RESET} ${C_VAL}${SERVER_IP}${C_RESET}"
echo -e " ${C_LABEL}Puerto OpenSSH :${C_RESET} ${C_VAL}22, 143${C_RESET}"
echo -e " ${C_LABEL}Puerto Dropbear:${C_RESET} ${C_VAL}90, 109${C_RESET}"
echo -e " ${C_LABEL}WebSocket WS   :${C_RESET} ${C_VAL}80, 8080${C_RESET}"
echo -e " ${C_LABEL}BadVPN UDPGW   :${C_RESET} ${C_GREEN}7300${C_RESET} (Juegos / VoIP)"
echo -e "${C_BORDER}──────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}${C_WHITE}★ FICHA PARA HTTP CUSTOM (Copiar y Pegar):${C_RESET}"
echo -e " ${C_GREEN}${SERVER_DOMAIN}:80@${USERNAME}:${PASSWORD}${C_RESET}"
echo -e ""
echo -e " ${C_BOLD}${C_WHITE}★ PAYLOAD RECOMENDADO (Websocket CDN/Directo):${C_RESET}"
echo -e " ${C_CYAN}GET / HTTP/1.1[crlf]Host: ${SERVER_DOMAIN}[crlf]Upgrade: websocket[crlf][crlf]${C_RESET}"
echo -e "${C_BORDER}╰════════════════════════════════════════════════════════════╯${C_RESET}"

# Guardar copia de ticket para consulta
TICKET_FILE="/etc/vps-ssh-limiter/trials/ticket-${USERNAME}.txt"
cat > "$TICKET_FILE" 2>/dev/null <<EOF || true
==============================================
CUENTA TRIAL TEMPORAL (HTTP CUSTOM / SSH)
==============================================
Usuario        : ${USERNAME}
Contraseña     : ${PASSWORD}
Límite Disp.   : ${LIMIT}
Tiempo Activo  : ${DURATION_MIN} Minutos
Expira a las   : ${EXPIRE_STR}
Host / Dominio : ${SERVER_DOMAIN}
IP Servidor    : ${SERVER_IP}
Puertos SSH    : 22, 143
Puertos Drop   : 90, 109
Puertos WS     : 80, 8080
BadVPN UDPGW   : 7300

Ficha de Conexión HTTP Custom:
${SERVER_DOMAIN}:80@${USERNAME}:${PASSWORD}

Payload WebSocket:
GET / HTTP/1.1[crlf]Host: ${SERVER_DOMAIN}[crlf]Upgrade: websocket[crlf][crlf]
==============================================
EOF

echo ""
read -r -p " Presione [Enter] para continuar..." _ || true
exit 0
