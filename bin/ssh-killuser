#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-killuser
# Cierre forzoso de conexiones activas por usuario o mitigación masiva de excedentes.
# ==============================================================================
set -euo pipefail

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_CYAN="\033[1;36m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_CYAN=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

show_help() {
    cat <<EOF
${C_BOLD}Uso:${C_RESET}
    ssh-killuser <usuario>
    ssh-killuser --all-exceeded

${C_BOLD}Descripción:${C_RESET}
    Desconecta inmediatamente todas las sesiones activas (SSH y Dropbear) de un usuario
    específico sin borrar su cuenta del sistema. Si se invoca con --all-exceeded,
    inspecciona a todos los usuarios y fuerza el cierre de conexiones excedentes.

${C_BOLD}Ejemplos:${C_RESET}
    sudo ssh-killuser juan
    sudo ssh-killuser --all-exceeded
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Este script debe ejecutarse con privilegios de superusuario (root)." >&2
    exit 1
fi

if [[ $# -ne 1 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Argumento requerido." >&2
    show_help >&2
    exit 1
fi

TARGET="$1"

if [[ "$TARGET" == "--all-exceeded" ]]; then
    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}EXPULSIÓN DE SESIONES EXCEDENTES${C_RESET}  ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
    echo -e "${C_GRAY}Escaneando usuarios en el sistema...${C_RESET}\n"
    PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
    KILLED_COUNT=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        IFS=':' read -r u _ uid _ gecos _ shell <<< "$line"

        limit=""
        if [[ "$gecos" =~ LIM[:_=-]?([0-9]+) ]]; then
            limit="${BASH_REMATCH[1]}"
        elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$u" != "nobody" && "$u" != "nogroup" ]]; then
            limit=1
        fi

        [[ -z "$limit" ]] && continue

        all_pids=()
        for p in $(pgrep -u "$u" 2>/dev/null || true); do
            if [[ -n "$p" && "$p" =~ ^[0-9]+$ ]]; then
                all_pids+=("$p")
            fi
        done

        total=${#all_pids[@]}
        if [[ "$total" -gt "$limit" ]]; then
            surplus=$((total - limit))
            echo -e " ${C_YELLOW}● ${u}:${C_RESET} $total activas vs $limit permitidas."
            echo -e "   Expulsando $surplus conexión(es) excedente(s)..."

            pids_csv=$(IFS=,; echo "${all_pids[*]}")
            ranked=()
            while read -r r_pid _; do
                if [[ -n "$r_pid" && "$r_pid" =~ ^[0-9]+$ ]]; then
                    ranked+=("$r_pid")
                fi
            done < <(ps -o pid=,etimes= -p "$pids_csv" --sort=etimes 2>/dev/null || true)

            if [[ ${#ranked[@]} -eq 0 ]]; then
                ranked=("${all_pids[@]}")
            fi

            for (( i=limit; i<${#ranked[@]}; i++ )); do
                kill -9 "${ranked[i]}" 2>/dev/null || true
                KILLED_COUNT=$((KILLED_COUNT + 1))
            done
        fi
    done < "$PASSWD_FILE"

    echo -e "\n${C_GRAY}─────────────────────────────────────────${C_RESET}"
    echo -e "${C_GREEN}✔ Mitigación completada.${C_RESET} Total cerradas: ${C_BOLD}$KILLED_COUNT${C_RESET}"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
    exit 0
fi

# Caso: Usuario individual
USERNAME="$TARGET"
if ! id "$USERNAME" >/dev/null 2>&1; then
    echo -e "${C_RED}[ERROR]${C_RESET} El usuario '$USERNAME' no existe en el sistema." >&2
    exit 1
fi

all_pids=()
for p in $(pgrep -u "$USERNAME" 2>/dev/null || true); do
    if [[ -n "$p" && "$p" =~ ^[0-9]+$ ]]; then
        all_pids+=("$p")
    fi
done
count_before=${#all_pids[@]}

if [[ $count_before -eq 0 ]]; then
    echo -e "${C_YELLOW}[AVISO]${C_RESET} El usuario '$USERNAME' no tiene conexiones activas actualmente."
    exit 0
fi

echo -e "${C_CYAN}Cerrando $count_before conexión(es) activa(s) para '$USERNAME'...${C_RESET}"
for p in "${all_pids[@]}"; do
    kill -9 "$p" 2>/dev/null || true
done
pkill -u "$USERNAME" -9 2>/dev/null || true

echo -e "${C_GREEN}✔ Todas las conexiones del usuario '$USERNAME' fueron cerradas exitosamente.${C_RESET}"
exit 0
