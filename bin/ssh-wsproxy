#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# ==============================================================================
# vps-ssh-limiter: bin/ssh-wsproxy
# Proxy WebSocket / HTTP Injector de alto rendimiento para SSH / Dropbear.
# Soporta payloads con "Upgrade: websocket" (Cloudflare CDN / SNI Bug Host),
# métodos HTTP (GET, GETT, POST, CONNECT) y conexiones directas en puerto 80.
# Compatible con HTTP Custom, HTTP Injector, NapsternetV, eProxy, etc.
# ==============================================================================

import sys
import os
import socket
import select
import threading
import signal
import subprocess
import time
import re
import json
import datetime
import urllib.parse

CONFIG_DIR = "/etc/vps-ssh-limiter"
CONFIG_FILE = os.path.join(CONFIG_DIR, "wsproxy.conf")
DEFAULT_LISTEN_PORT = 80
DEFAULT_TARGET_HOST = "127.0.0.1"
DEFAULT_TARGET_PORT = 22
BUFFER_SIZE = 32768
TIMEOUT = 120

# Respuesta HTTP 101 Switching Protocols para WebSockets
WS_101_RESPONSE = (
    b"HTTP/1.1 101 Switching Protocols\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: Upgrade\r\n\r\n"
)

HTTP_200_RESPONSE = b"HTTP/1.1 200 Connection Established\r\n\r\n"


def load_config():
    listen_port = DEFAULT_LISTEN_PORT
    target_host = DEFAULT_TARGET_HOST
    target_port = DEFAULT_TARGET_PORT

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip().upper()
                        v = v.strip()
                        if k == "LISTEN_PORT":
                            listen_port = int(v)
                        elif k == "TARGET_HOST":
                            target_host = v
                        elif k == "TARGET_PORT":
                            target_port = int(v)
        except Exception:
            pass

    return listen_port, target_host, target_port


def save_config(listen_port, target_host, target_port):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write("# Configuracion de WebSocket Proxy para vps-ssh-limiter\n")
        f.write(f"LISTEN_PORT={listen_port}\n")
        f.write(f"TARGET_HOST={target_host}\n")
        f.write(f"TARGET_PORT={target_port}\n")


def get_user_account_info(username):
    """
    Obtiene la informacion de cuenta de un usuario en el VPS:
    - Validez de la cuenta y dias restantes
    - Minutos restantes (si es cuenta trial)
    - Fecha exacta de expiracion
    - Limite de conexiones concurrentes
    - Conexiones activas en tiempo real
    - Trafico consumido
    - Estado de bloqueo (passwd -S / /etc/shadow)
    """
    username = re.sub(r"[^a-zA-Z0-9_.-]", "", username).strip()
    if not username:
        return {
            "status": "error",
            "exists": False,
            "message": "Nombre de usuario invalido o vacio."
        }

    now_epoch = int(time.time())
    passwd_file = "/etc/passwd"
    shadow_file = "/etc/shadow"
    trials_file = "/etc/vps-ssh-limiter/trials.db"
    traffic_file = "/etc/vps-ssh-limiter/traffic.db"

    # 1. Verificar si existe en /etc/passwd
    user_line = None
    if os.path.exists(passwd_file):
        try:
            with open(passwd_file, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    parts = line.strip().split(":")
                    if len(parts) >= 7 and parts[0] == username:
                        user_line = parts
                        break
        except Exception:
            pass

    if not user_line:
        return {
            "status": "not_found",
            "exists": False,
            "username": username,
            "message": f"El usuario '{username}' no existe en este servidor VPS."
        }

    uid = int(user_line[2]) if user_line[2].isdigit() else 0
    gecos = user_line[4]

    # Extraer limite de conexiones concurrentes de GECOS (ej: LIM:2)
    limit = 1
    m = re.search(r"LIM[:_=-]?([0-9]+)", gecos)
    if m:
        limit = int(m.group(1))

    # 2. Conexiones activas en tiempo real para este usuario (filtrando helpers [net] de OpenSSH)
    active_connections = 0
    try:
        out = subprocess.run(["pgrep", "-u", username], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1.5)
        if out.returncode == 0 and out.stdout:
            for pid_str in out.stdout.strip().splitlines():
                pid = pid_str.strip()
                if pid and os.path.isdir(f"/proc/{pid}"):
                    comm_path = f"/proc/{pid}/comm"
                    cmdline_path = f"/proc/{pid}/cmdline"
                    comm = ""
                    cmdline = ""
                    try:
                        if os.path.exists(comm_path):
                            with open(comm_path, "r", encoding="utf-8", errors="ignore") as cf:
                                comm = cf.read().strip()
                        if os.path.exists(cmdline_path):
                            with open(cmdline_path, "rb") as cmdf:
                                cmdline = cmdf.read().replace(b"\x00", b" ").decode("utf-8", errors="ignore")
                    except Exception:
                        pass

                    if "sshd" in comm:
                        # En OpenSSH cada sesion tiene un helper [net] de separacion de privilegios; ignorarlo para no contar doble
                        if "[net]" in cmdline or "[priv]" in cmdline:
                            continue
                        active_connections += 1
                    elif "dropbear" in comm:
                        active_connections += 1
    except Exception:
        pass

    available_slots = max(0, limit - active_connections)

    # 3. Trafico consumido
    traffic_bytes = 0
    traffic_human = "0 MB"
    if os.path.exists(traffic_file):
        try:
            with open(traffic_file, "r", encoding="utf-8", errors="ignore") as tf:
                for line in tf:
                    parts = line.strip().split(":")
                    if len(parts) >= 2 and parts[0] == username:
                        if parts[1].isdigit():
                            traffic_bytes = int(parts[1])
                            if traffic_bytes < 1024 * 1024:
                                traffic_human = f"{traffic_bytes / 1024:.1f} KB"
                            elif traffic_bytes < 1024 * 1024 * 1024:
                                traffic_human = f"{traffic_bytes / (1024 * 1024):.1f} MB"
                            else:
                                traffic_human = f"{traffic_bytes / (1024 * 1024 * 1024):.2f} GB"
                        break
        except Exception:
            pass

    # 4. Comprobar si es cuenta Trial en trials.db
    is_trial = False
    trial_exp = None
    trial_dur = 60
    if os.path.exists(trials_file):
        try:
            with open(trials_file, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    parts = line.strip().split(":")
                    if len(parts) >= 3 and parts[0] == username:
                        is_trial = True
                        trial_exp = int(parts[1]) if parts[1].isdigit() else now_epoch
                        trial_dur = int(parts[2]) if parts[2].isdigit() else 60
                        break
        except Exception:
            pass

    if is_trial and trial_exp is not None:
        expired = now_epoch >= trial_exp
        rem_sec = max(0, trial_exp - now_epoch)
        rem_min = rem_sec // 60
        exp_iso = datetime.datetime.fromtimestamp(trial_exp).strftime("%Y-%m-%d %H:%M:%S")
        exp_date_short = datetime.datetime.fromtimestamp(trial_exp).strftime("%d/%m/%Y %H:%M")

        if expired:
            formatted = "Cuenta Trial Expirada"
            status_text = "EXPIRED"
            days_left = 0
        else:
            status_text = "ACTIVE"
            days_left = max(1, rem_sec // 86400) if rem_sec >= 86400 else 0
            if rem_min >= 60:
                h = rem_min // 60
                m = rem_min % 60
                formatted = f"{h}h {m}m restantes ({exp_date_short})"
            else:
                formatted = f"{rem_min} min restantes ({exp_date_short})"

        return {
            "status": "ok",
            "username": username,
            "exists": True,
            "account_type": "trial",
            "is_trial": True,
            "locked": False,
            "expired": expired,
            "status_text": status_text,
            "limit": limit,
            "active_connections": active_connections,
            "available_slots": available_slots,
            "traffic_bytes": traffic_bytes,
            "traffic_human": traffic_human,
            "days_left": days_left,
            "minutes_left": rem_min,
            "seconds_left": rem_sec,
            "expiration_date": exp_iso,
            "expiration_formatted": formatted,
            "server_timestamp": now_epoch,
            "server_time": datetime.datetime.fromtimestamp(now_epoch).strftime("%Y-%m-%d %H:%M:%S")
        }

    # 5. Comprobar expiracion estandar en /etc/shadow y estado de bloqueo
    exp_epoch = None
    exp_iso = "Sin vencimiento"
    expired = False
    days_left = -1
    status_text = "ACTIVE"
    formatted = "Ilimitado (Sin vencimiento)"
    locked = False

    if os.path.exists(shadow_file):
        try:
            with open(shadow_file, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    parts = line.strip().split(":")
                    if len(parts) >= 8 and parts[0] == username:
                        pwd = parts[1]
                        if pwd.startswith("!") or pwd.startswith("*"):
                            locked = True
                        exp_field = parts[7].strip()
                        if exp_field and exp_field.isdigit():
                            exp_days = int(exp_field)
                            exp_epoch = exp_days * 86400
                            exp_dt = datetime.datetime.fromtimestamp(exp_epoch)
                            exp_iso = exp_dt.strftime("%Y-%m-%d")
                            diff_sec = exp_epoch - now_epoch
                            diff_days = diff_sec // 86400
                            if diff_sec < 0:
                                expired = True
                                days_left = 0
                                status_text = "EXPIRED"
                                formatted = f"Expirado el {exp_iso}"
                            else:
                                expired = False
                                days_left = max(0, diff_days)
                                status_text = "LOCKED" if locked else "ACTIVE"
                                formatted = f"{diff_days} dia(s) restante(s) ({exp_iso})"
                        break
        except Exception:
            pass

    # Si shadow no arrojo vencimiento o no fue legible, intentar con chage como fallback
    if exp_epoch is None:
        try:
            ch_out = subprocess.run(["chage", "-l", username], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1.5)
            if ch_out.returncode == 0:
                for line in ch_out.stdout.splitlines():
                    if "Account expires" in line:
                        exp_raw = line.split(":", 1)[1].strip()
                        if exp_raw and exp_raw.lower() not in ("never", "nunca", ""):
                            try:
                                dt = datetime.datetime.strptime(exp_raw, "%b %d, %Y")
                                exp_epoch = int(dt.timestamp())
                                exp_iso = dt.strftime("%Y-%m-%d")
                                diff_days = (exp_epoch - now_epoch) // 86400
                                if diff_days < 0:
                                    expired = True
                                    days_left = 0
                                    status_text = "EXPIRED"
                                    formatted = f"Expirado el {exp_iso}"
                                else:
                                    days_left = max(0, diff_days)
                                    status_text = "LOCKED" if locked else "ACTIVE"
                                    formatted = f"{diff_days} dia(s) restante(s) ({exp_iso})"
                            except Exception:
                                pass
                        break
        except Exception:
            pass

    return {
        "status": "ok",
        "username": username,
        "exists": True,
        "account_type": "standard",
        "is_trial": False,
        "locked": locked,
        "expired": expired,
        "status_text": status_text,
        "limit": limit,
        "active_connections": active_connections,
        "available_slots": available_slots,
        "traffic_bytes": traffic_bytes,
        "traffic_human": traffic_human,
        "days_left": days_left,
        "minutes_left": (days_left * 1440) if days_left >= 0 else -1,
        "seconds_left": (days_left * 86400) if days_left >= 0 else -1,
        "expiration_date": exp_iso,
        "expiration_timestamp": exp_epoch,
        "expiration_formatted": formatted,
        "server_timestamp": now_epoch,
        "server_time": datetime.datetime.fromtimestamp(now_epoch).strftime("%Y-%m-%d %H:%M:%S")
    }


def connect_target(target_host, target_port):
    """
    Conecta al servicio SSH con tolerancia a fallos.
    Intenta el puerto configurado (OpenSSH 22 para banners individuales de usuario),
    y si no responde intenta los puertos alternativos (Dropbear 143, 90, 109).
    """
    ports = [target_port, 22, 143, 90, 109]
    seen = set()
    for p in ports:
        if p in seen:
            continue
        seen.add(p)
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            try:
                if hasattr(socket, "TCP_KEEPIDLE"):
                    s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 10)
                if hasattr(socket, "TCP_KEEPINTVL"):
                    s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 3)
                if hasattr(socket, "TCP_KEEPCNT"):
                    s.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 3)
            except Exception:
                pass
            s.settimeout(2.0)
            s.connect((target_host, p))
            s.settimeout(None)
            return s
        except Exception:
            try:
                s.close()
            except Exception:
                pass
    return None


def forward_client_to_target(client_sock, target_sock):
    """
    Reenvia trafico del cliente hacia Dropbear/SSH.
    Filtra y descarta encabezados HTTP residuales (como payloads split de HTTP Custom)
    para que Dropbear reciba unicamenete paquetes SSH limpios.
    """
    ssh_started = False
    try:
        while True:
            r, _, _ = select.select([client_sock], [], [], TIMEOUT)
            if not r:
                break
            data = client_sock.recv(BUFFER_SIZE)
            if not data:
                break

            if not ssh_started:
                while data:
                    lower_data = data.lower().lstrip(b"\r\n ")
                    if any(lower_data.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ", b"http/")):
                        idx = data.find(b"\r\n\r\n")
                        if idx != -1:
                            data = data[idx + 4:].lstrip(b"\r\n ")
                            try:
                                client_sock.sendall(WS_101_RESPONSE)
                            except Exception:
                                pass
                        else:
                            data = b""
                    else:
                        data = data.lstrip(b"\r\n ")
                        ssh_started = True
                        break
                if data:
                    target_sock.sendall(data)
            else:
                target_sock.sendall(data)
    except Exception:
        pass
    finally:
        try:
            target_sock.shutdown(socket.SHUT_WR)
        except Exception:
            pass


def forward_target_to_client(target_sock, client_sock):
    """
    Reenvia la respuesta y banner de Dropbear/SSH hacia el cliente HTTP Custom.
    """
    try:
        while True:
            r, _, _ = select.select([target_sock], [], [], TIMEOUT)
            if not r:
                break
            data = target_sock.recv(BUFFER_SIZE)
            if not data:
                break
            client_sock.sendall(data)
    except Exception:
        pass
    finally:
        try:
            client_sock.shutdown(socket.SHUT_WR)
        except Exception:
            pass


def handle_client(client_sock, client_addr, target_host, target_port):
    target_sock = None
    try:
        client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        client_sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        try:
            if hasattr(socket, "TCP_KEEPIDLE"):
                client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 10)
            if hasattr(socket, "TCP_KEEPINTVL"):
                client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 3)
            if hasattr(socket, "TCP_KEEPCNT"):
                client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 3)
        except Exception:
            pass
        client_sock.settimeout(15.0)

        initial_data = b""
        while b"\r\n\r\n" not in initial_data and len(initial_data) < 8192:
            try:
                chunk = client_sock.recv(4096)
                if not chunk:
                    break
                initial_data += chunk
            except socket.timeout:
                break

        if not initial_data:
            client_sock.close()
            return

        # ----------------------------------------------------------------------
        # Detección temprana de peticiones REST API o comprobación de cuenta
        # ----------------------------------------------------------------------
        first_line = initial_data.split(b"\r\n", 1)[0]
        first_line_str = first_line.decode("utf-8", errors="ignore").strip()

        # Comprobar método OPTIONS (CORS Preflight para navegadores y apps web/móvil)
        if first_line_str.startswith("OPTIONS "):
            cors_headers = (
                b"HTTP/1.1 204 No Content\r\n"
                b"Access-Control-Allow-Origin: *\r\n"
                b"Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
                b"Access-Control-Allow-Headers: Content-Type, Authorization, X-User, X-Requested-With\r\n"
                b"Access-Control-Max-Age: 86400\r\n"
                b"Connection: close\r\n\r\n"
            )
            try:
                client_sock.sendall(cors_headers)
                client_sock.shutdown(socket.SHUT_WR)
            except Exception:
                pass
            try:
                client_sock.close()
            except Exception:
                pass
            return

        # Comprobar rutas API (/api/user, /check, /user/, /api/server, /api/status)
        is_api_route = False
        api_method = ""
        api_path = ""
        m_http = re.match(r"^(GET|POST)\s+([^\s]+)\s+HTTP/", first_line_str, re.IGNORECASE)
        if m_http:
            api_method = m_http.group(1).upper()
            api_path = m_http.group(2)
            if (
                api_path.startswith("/api/user")
                or api_path.startswith("/check")
                or api_path.startswith("/user/")
                or api_path.startswith("/api/server")
                or api_path.startswith("/api/status")
            ):
                is_api_route = True

        if is_api_route:
            username = ""
            parsed_url = urllib.parse.urlparse(api_path)
            q_params = urllib.parse.parse_qs(parsed_url.query)

            if "u" in q_params:
                username = q_params["u"][0]
            elif "user" in q_params:
                username = q_params["user"][0]
            elif "username" in q_params:
                username = q_params["username"][0]
            elif parsed_url.path.startswith("/user/"):
                username = parsed_url.path[6:].strip("/")

            # Si es POST, leer el body (form-urlencoded o JSON)
            if api_method == "POST" and not username:
                body = b""
                idx_body = initial_data.find(b"\r\n\r\n")
                if idx_body != -1:
                    body = initial_data[idx_body + 4:]
                body_str = body.decode("utf-8", errors="ignore").strip()
                if body_str:
                    try:
                        j_body = json.loads(body_str)
                        username = j_body.get("username") or j_body.get("user") or j_body.get("u") or ""
                    except Exception:
                        p_body = urllib.parse.parse_qs(body_str)
                        if "u" in p_body:
                            username = p_body["u"][0]
                        elif "user" in p_body:
                            username = p_body["user"][0]
                        elif "username" in p_body:
                            username = p_body["username"][0]

            if parsed_url.path in ("/api/server", "/api/status"):
                resp_payload = {
                    "status": "ok",
                    "server": "vps-ssh-limiter",
                    "service": "ssh-wsproxy",
                    "timestamp": int(time.time()),
                    "datetime": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                }
            elif username:
                resp_payload = get_user_account_info(username)
            else:
                resp_payload = {
                    "status": "error",
                    "message": "Parametro de usuario no especificado. Uso: /api/user?u=<nombre> o /check?user=<nombre>"
                }

            json_bytes = json.dumps(resp_payload, ensure_ascii=False, indent=2).encode("utf-8")
            status_code = b"200 OK" if resp_payload.get("status") == "ok" else (b"404 Not Found" if resp_payload.get("status") == "not_found" else b"400 Bad Request")

            resp_http = (
                b"HTTP/1.1 " + status_code + b"\r\n"
                b"Content-Type: application/json; charset=utf-8\r\n"
                b"Access-Control-Allow-Origin: *\r\n"
                b"Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
                b"Access-Control-Allow-Headers: Content-Type, Authorization, X-User, X-Requested-With\r\n"
                b"Connection: close\r\n"
                b"Content-Length: " + str(len(json_bytes)).encode("ascii") + b"\r\n\r\n" + json_bytes
            )
            try:
                client_sock.sendall(resp_http)
                client_sock.shutdown(socket.SHUT_WR)
            except Exception:
                pass
            try:
                client_sock.settimeout(0.3)
                while client_sock.recv(1024):
                    pass
            except Exception:
                pass
            try:
                client_sock.close()
            except Exception:
                pass
            return

        # ----------------------------------------------------------------------
        # Tráfico de Túnel SSH / WebSocket
        # ----------------------------------------------------------------------
        # Conectar al servicio destino SSH (con tolerancia y fallback)
        target_sock = connect_target(target_host, target_port)
        if not target_sock:
            client_sock.close()
            return

        client_sock.settimeout(None)

        lower_data = initial_data.lower().lstrip(b"\r\n ")
        is_http = any(lower_data.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ", b"http/")) or b"upgrade: websocket" in lower_data

        if is_http:
            # Consumir y limpiar peticiones HTTP de initial_data (soporte para [split])
            buffer = initial_data
            while True:
                idx = buffer.find(b"\r\n\r\n")
                if idx == -1:
                    buffer = b""
                    break
                buffer = buffer[idx + 4:].lstrip(b"\r\n ")
                lower_rem = buffer.lower()
                if any(lower_rem.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ")):
                    continue
                else:
                    break

            # Comprobar si el cliente WebSocket incluyó encabezado X-User o query param u=
            ws_user = ""
            m_user_hdr = re.search(r"\r\nx-user:\s*([^\r\n]+)", initial_data.decode("utf-8", errors="ignore"), re.IGNORECASE)
            if m_user_hdr:
                ws_user = m_user_hdr.group(1).strip()
            else:
                m_u_url = re.search(r"[?&]u=([^&\s]+)", first_line_str)
                if m_u_url:
                    ws_user = m_u_url.group(1).strip()

            if ws_user:
                u_info = get_user_account_info(ws_user)
                days_left_str = str(u_info.get("days_left", -1))
                expire_str = str(u_info.get("expiration_date", "never"))
                limit_str = str(u_info.get("limit", 1))
                status_str = str(u_info.get("status_text", "ACTIVE"))
                custom_101 = (
                    b"HTTP/1.1 101 Switching Protocols\r\n"
                    b"Upgrade: websocket\r\n"
                    b"Connection: Upgrade\r\n"
                    b"X-Account-User: " + ws_user.encode("utf-8", errors="ignore") + b"\r\n"
                    b"X-Account-Days-Left: " + days_left_str.encode("ascii") + b"\r\n"
                    b"X-Account-Expire: " + expire_str.encode("ascii") + b"\r\n"
                    b"X-Account-Limit: " + limit_str.encode("ascii") + b"\r\n"
                    b"X-Account-Status: " + status_str.encode("ascii") + b"\r\n\r\n"
                )
                client_sock.sendall(custom_101)
            else:
                # Responder con 101 Switching Protocols estándar
                client_sock.sendall(WS_101_RESPONSE)

            # Si quedaron bytes residuales y corresponden a SSH, enviarlos al target
            if buffer:
                buffer = buffer.lstrip(b"\r\n ")
                if buffer:
                    target_sock.sendall(buffer)
        else:
            # Conexion SSH o binaria directa sin cabecera HTTP
            target_sock.sendall(initial_data)

        # Iniciar reenvio bidireccional mediante hilos concurrentes
        t1 = threading.Thread(target=forward_client_to_target, args=(client_sock, target_sock), daemon=True)
        t2 = threading.Thread(target=forward_target_to_client, args=(target_sock, client_sock), daemon=True)
        t1.start()
        t2.start()
        t1.join()
        t2.join()

    except Exception:
        pass
    finally:
        try:
            client_sock.close()
        except Exception:
            pass
        if target_sock:
            try:
                target_sock.close()
            except Exception:
                pass


def run_server(listen_port, target_host, target_port):
    server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

    try:
        server_sock.bind(("0.0.0.0", listen_port))
    except Exception as e:
        print(f"[ERROR] No se pudo vincular al puerto {listen_port}: {e}", file=sys.stderr)
        sys.exit(1)

    server_sock.listen(128)
    print(f"[*] WebSocket Proxy iniciado en 0.0.0.0:{listen_port} -> {target_host}:{target_port}")

    def sig_handler(signum, frame):
        print("\n[*] Deteniendo WebSocket Proxy...")
        try:
            server_sock.close()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    while True:
        try:
            client_sock, client_addr = server_sock.accept()
            client_thread = threading.Thread(
                target=handle_client,
                args=(client_sock, client_addr, target_host, target_port),
                daemon=True,
            )
            client_thread.start()
        except Exception:
            time.sleep(0.05)


def service_cmd(action):
    try:
        res = subprocess.run(["systemctl", action, "ssh-wsproxy"], check=False)
        return res.returncode == 0
    except Exception as e:
        print(f"Error al ejecutar systemctl {action}: {e}", file=sys.stderr)
        return False


def is_service_active():
    try:
        res = subprocess.run(
            ["systemctl", "is-active", "--quiet", "ssh-wsproxy"], check=False
        )
        return res.returncode == 0
    except Exception:
        return False


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--help", "-h"):
            print("Uso: ssh-wsproxy [COMANDO | PUERTO_ESCUCHA] [TARGET_HOST:TARGET_PORT]")
            print("")
            print("Comandos disponibles:")
            print("  --start       Inicia el servicio en segundo plano (systemd)")
            print("  --stop        Detiene el servicio en segundo plano")
            print("  --restart     Reinicia el servicio en segundo plano")
            print("  --status      Muestra el estado del servicio y puertos")
            print("  --run         Ejecuta en primer plano con la configuracion guardada")
            print("")
            print("Ejemplos:")
            print("  ssh-wsproxy --status")
            print("  ssh-wsproxy 80 127.0.0.1:143   (Ejecutar directamente)")
            sys.exit(0)

        elif arg == "--status":
            active = is_service_active()
            l_port, t_host, t_port = load_config()
            status_str = "\033[1;32mONLINE\033[0m" if active else "\033[1;31mOFFLINE\033[0m"
            print(f"Estado del servicio: {status_str}")
            print(f"Puerto de escucha:   {l_port} (0.0.0.0:{l_port})")
            print(f"Servicio destino:    {t_host}:{t_port} (Dropbear/SSH)")
            sys.exit(0 if active else 1)

        elif arg == "--start":
            if service_cmd("start"):
                print("\033[1;32m✔ Servicio ssh-wsproxy iniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo iniciar el servicio ssh-wsproxy.\033[0m")
            sys.exit(0)

        elif arg == "--stop":
            if service_cmd("stop"):
                print("\033[1;33m✔ Servicio ssh-wsproxy detenido.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo detener el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--restart":
            if service_cmd("restart"):
                print("\033[1;32m✔ Servicio ssh-wsproxy reiniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo reiniciar el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--run":
            l_port, t_host, t_port = load_config()
            run_server(l_port, t_host, t_port)
            return

        elif arg.isdigit():
            l_port = int(arg)
            t_host = DEFAULT_TARGET_HOST
            t_port = DEFAULT_TARGET_PORT
            if len(sys.argv) > 2:
                target_part = sys.argv[2]
                if ":" in target_part:
                    t_host, p_str = target_part.split(":", 1)
                    t_port = int(p_str)
                elif target_part.isdigit():
                    t_port = int(target_part)
            save_config(l_port, t_host, t_port)
            run_server(l_port, t_host, t_port)
            return

    # Si se ejecuta sin parametros desde la terminal
    l_port, t_host, t_port = load_config()
    run_server(l_port, t_host, t_port)


if __name__ == "__main__":
    main()
