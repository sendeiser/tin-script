#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# ==============================================================================
# vps-ssh-limiter: bin/ssh-wsproxy
# Proxy WebSocket / HTTP Injector de alto rendimiento para SSH / Dropbear.
# Soporta payloads con "Upgrade: websocket" (Cloudflare CDN / SNI Bug Host),
# métodos HTTP (GET, GETT, POST, CONNECT) y conexiones directas en puerto 80.
# Compatible con HTTP Custom, HTTP Injector, NapsternetV, eProxy, etc.
# ==============================================================================

import sys
import os
import socket
import select
import threading
import signal
import subprocess
import time

CONFIG_DIR = "/etc/vps-ssh-limiter"
CONFIG_FILE = os.path.join(CONFIG_DIR, "wsproxy.conf")
DEFAULT_LISTEN_PORT = 80
DEFAULT_TARGET_HOST = "127.0.0.1"
DEFAULT_TARGET_PORT = 22
BUFFER_SIZE = 32768
TIMEOUT = 120

# Respuesta HTTP 101 Switching Protocols para WebSockets
WS_101_RESPONSE = (
    b"HTTP/1.1 101 Switching Protocols\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: Upgrade\r\n\r\n"
)

HTTP_200_RESPONSE = b"HTTP/1.1 200 Connection Established\r\n\r\n"


def load_config():
    listen_port = DEFAULT_LISTEN_PORT
    target_host = DEFAULT_TARGET_HOST
    target_port = DEFAULT_TARGET_PORT

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip().upper()
                        v = v.strip()
                        if k == "LISTEN_PORT":
                            listen_port = int(v)
                        elif k == "TARGET_HOST":
                            target_host = v
                        elif k == "TARGET_PORT":
                            target_port = int(v)
        except Exception:
            pass

    return listen_port, target_host, target_port


def save_config(listen_port, target_host, target_port):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write("# Configuracion de WebSocket Proxy para vps-ssh-limiter\n")
        f.write(f"LISTEN_PORT={listen_port}\n")
        f.write(f"TARGET_HOST={target_host}\n")
        f.write(f"TARGET_PORT={target_port}\n")


def connect_target(target_host, target_port):
    """
    Conecta al servicio SSH con tolerancia a fallos.
    Intenta el puerto configurado (OpenSSH 22 para banners individuales de usuario),
    y si no responde intenta los puertos alternativos (Dropbear 143, 90, 109).
    """
    ports = [target_port, 22, 143, 90, 109]
    seen = set()
    for p in ports:
        if p in seen:
            continue
        seen.add(p)
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            s.settimeout(2.0)
            s.connect((target_host, p))
            s.settimeout(None)
            return s
        except Exception:
            try:
                s.close()
            except Exception:
                pass
    return None


def forward_client_to_target(client_sock, target_sock):
    """
    Reenvia trafico del cliente hacia Dropbear/SSH.
    Filtra y descarta encabezados HTTP residuales (como payloads split de HTTP Custom)
    para que Dropbear reciba unicamenete paquetes SSH limpios.
    """
    ssh_started = False
    try:
        while True:
            r, _, _ = select.select([client_sock], [], [], TIMEOUT)
            if not r:
                break
            data = client_sock.recv(BUFFER_SIZE)
            if not data:
                break

            if not ssh_started:
                while data:
                    lower_data = data.lower().lstrip(b"\r\n ")
                    if any(lower_data.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ", b"http/")):
                        idx = data.find(b"\r\n\r\n")
                        if idx != -1:
                            data = data[idx + 4:].lstrip(b"\r\n ")
                            try:
                                client_sock.sendall(WS_101_RESPONSE)
                            except Exception:
                                pass
                        else:
                            data = b""
                    else:
                        data = data.lstrip(b"\r\n ")
                        ssh_started = True
                        break
                if data:
                    target_sock.sendall(data)
            else:
                target_sock.sendall(data)
    except Exception:
        pass
    finally:
        try:
            target_sock.shutdown(socket.SHUT_WR)
        except Exception:
            pass


def forward_target_to_client(target_sock, client_sock):
    """
    Reenvia la respuesta y banner de Dropbear/SSH hacia el cliente HTTP Custom.
    """
    try:
        while True:
            r, _, _ = select.select([target_sock], [], [], TIMEOUT)
            if not r:
                break
            data = target_sock.recv(BUFFER_SIZE)
            if not data:
                break
            client_sock.sendall(data)
    except Exception:
        pass
    finally:
        try:
            client_sock.shutdown(socket.SHUT_WR)
        except Exception:
            pass


def handle_client(client_sock, client_addr, target_host, target_port):
    target_sock = None
    try:
        client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        client_sock.settimeout(15.0)

        initial_data = b""
        while b"\r\n\r\n" not in initial_data and len(initial_data) < 8192:
            try:
                chunk = client_sock.recv(4096)
                if not chunk:
                    break
                initial_data += chunk
            except socket.timeout:
                break

        if not initial_data:
            client_sock.close()
            return

        # Conectar al servicio destino SSH (con tolerancia y fallback)
        target_sock = connect_target(target_host, target_port)
        if not target_sock:
            client_sock.close()
            return

        client_sock.settimeout(None)

        lower_data = initial_data.lower().lstrip(b"\r\n ")
        is_http = any(lower_data.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ", b"http/")) or b"upgrade: websocket" in lower_data

        if is_http:
            # Consumir y limpiar peticiones HTTP de initial_data (soporte para [split])
            buffer = initial_data
            while True:
                idx = buffer.find(b"\r\n\r\n")
                if idx == -1:
                    buffer = b""
                    break
                buffer = buffer[idx + 4:].lstrip(b"\r\n ")
                lower_rem = buffer.lower()
                if any(lower_rem.startswith(m) for m in (b"get ", b"gett ", b"post ", b"head ", b"connect ")):
                    continue
                else:
                    break

            # Responder con 101 Switching Protocols
            client_sock.sendall(WS_101_RESPONSE)

            # Si quedaron bytes residuales y corresponden a SSH, enviarlos al target
            if buffer:
                buffer = buffer.lstrip(b"\r\n ")
                if buffer:
                    target_sock.sendall(buffer)
        else:
            # Conexion SSH o binaria directa sin cabecera HTTP
            target_sock.sendall(initial_data)

        # Iniciar reenvio bidireccional mediante hilos concurrentes
        t1 = threading.Thread(target=forward_client_to_target, args=(client_sock, target_sock), daemon=True)
        t2 = threading.Thread(target=forward_target_to_client, args=(target_sock, client_sock), daemon=True)
        t1.start()
        t2.start()
        t1.join()
        t2.join()

    except Exception:
        pass
    finally:
        try:
            client_sock.close()
        except Exception:
            pass
        if target_sock:
            try:
                target_sock.close()
            except Exception:
                pass


def run_server(listen_port, target_host, target_port):
    server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

    try:
        server_sock.bind(("0.0.0.0", listen_port))
    except Exception as e:
        print(f"[ERROR] No se pudo vincular al puerto {listen_port}: {e}", file=sys.stderr)
        sys.exit(1)

    server_sock.listen(128)
    print(f"[*] WebSocket Proxy iniciado en 0.0.0.0:{listen_port} -> {target_host}:{target_port}")

    def sig_handler(signum, frame):
        print("\n[*] Deteniendo WebSocket Proxy...")
        try:
            server_sock.close()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    while True:
        try:
            client_sock, client_addr = server_sock.accept()
            client_thread = threading.Thread(
                target=handle_client,
                args=(client_sock, client_addr, target_host, target_port),
                daemon=True,
            )
            client_thread.start()
        except Exception:
            time.sleep(0.05)


def service_cmd(action):
    try:
        res = subprocess.run(["systemctl", action, "ssh-wsproxy"], check=False)
        return res.returncode == 0
    except Exception as e:
        print(f"Error al ejecutar systemctl {action}: {e}", file=sys.stderr)
        return False


def is_service_active():
    try:
        res = subprocess.run(
            ["systemctl", "is-active", "--quiet", "ssh-wsproxy"], check=False
        )
        return res.returncode == 0
    except Exception:
        return False


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--help", "-h"):
            print("Uso: ssh-wsproxy [COMANDO | PUERTO_ESCUCHA] [TARGET_HOST:TARGET_PORT]")
            print("")
            print("Comandos disponibles:")
            print("  --start       Inicia el servicio en segundo plano (systemd)")
            print("  --stop        Detiene el servicio en segundo plano")
            print("  --restart     Reinicia el servicio en segundo plano")
            print("  --status      Muestra el estado del servicio y puertos")
            print("  --run         Ejecuta en primer plano con la configuracion guardada")
            print("")
            print("Ejemplos:")
            print("  ssh-wsproxy --status")
            print("  ssh-wsproxy 80 127.0.0.1:143   (Ejecutar directamente)")
            sys.exit(0)

        elif arg == "--status":
            active = is_service_active()
            l_port, t_host, t_port = load_config()
            status_str = "\033[1;32mONLINE\033[0m" if active else "\033[1;31mOFFLINE\033[0m"
            print(f"Estado del servicio: {status_str}")
            print(f"Puerto de escucha:   {l_port} (0.0.0.0:{l_port})")
            print(f"Servicio destino:    {t_host}:{t_port} (Dropbear/SSH)")
            sys.exit(0 if active else 1)

        elif arg == "--start":
            if service_cmd("start"):
                print("\033[1;32m✔ Servicio ssh-wsproxy iniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo iniciar el servicio ssh-wsproxy.\033[0m")
            sys.exit(0)

        elif arg == "--stop":
            if service_cmd("stop"):
                print("\033[1;33m✔ Servicio ssh-wsproxy detenido.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo detener el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--restart":
            if service_cmd("restart"):
                print("\033[1;32m✔ Servicio ssh-wsproxy reiniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo reiniciar el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--run":
            l_port, t_host, t_port = load_config()
            run_server(l_port, t_host, t_port)
            return

        elif arg.isdigit():
            l_port = int(arg)
            t_host = DEFAULT_TARGET_HOST
            t_port = DEFAULT_TARGET_PORT
            if len(sys.argv) > 2:
                target_part = sys.argv[2]
                if ":" in target_part:
                    t_host, p_str = target_part.split(":", 1)
                    t_port = int(p_str)
                elif target_part.isdigit():
                    t_port = int(target_part)
            save_config(l_port, t_host, t_port)
            run_server(l_port, t_host, t_port)
            return

    # Si se ejecuta sin parametros desde la terminal
    l_port, t_host, t_port = load_config()
    run_server(l_port, t_host, t_port)


if __name__ == "__main__":
    main()
