#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# ==============================================================================
# vps-ssh-limiter: bin/ssh-wsproxy
# Proxy WebSocket / HTTP Injector de alto rendimiento para SSH / Dropbear.
# Soporta payloads con "Upgrade: websocket" (Cloudflare CDN / SNI Bug Host),
# métodos HTTP (GET, GETT, POST, CONNECT) y conexiones directas en puerto 80.
# Compatible con HTTP Custom, HTTP Injector, NapsternetV, eProxy, etc.
# ==============================================================================

import sys
import os
import socket
import select
import threading
import signal
import subprocess
import time

CONFIG_DIR = "/etc/vps-ssh-limiter"
CONFIG_FILE = os.path.join(CONFIG_DIR, "wsproxy.conf")
DEFAULT_LISTEN_PORT = 80
DEFAULT_TARGET_HOST = "127.0.0.1"
DEFAULT_TARGET_PORT = 143
BUFFER_SIZE = 32768
TIMEOUT = 120

# Respuesta HTTP 101 Switching Protocols para WebSockets
WS_101_RESPONSE = (
    b"HTTP/1.1 101 Switching Protocols\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: Upgrade\r\n"
    b"Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
)

HTTP_200_RESPONSE = b"HTTP/1.1 200 Connection Established\r\n\r\n"


def load_config():
    listen_port = DEFAULT_LISTEN_PORT
    target_host = DEFAULT_TARGET_HOST
    target_port = DEFAULT_TARGET_PORT

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip().upper()
                        v = v.strip()
                        if k == "LISTEN_PORT":
                            listen_port = int(v)
                        elif k == "TARGET_HOST":
                            target_host = v
                        elif k == "TARGET_PORT":
                            target_port = int(v)
        except Exception:
            pass

    return listen_port, target_host, target_port


def save_config(listen_port, target_host, target_port):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write("# Configuracion de WebSocket Proxy para vps-ssh-limiter\n")
        f.write(f"LISTEN_PORT={listen_port}\n")
        f.write(f"TARGET_HOST={target_host}\n")
        f.write(f"TARGET_PORT={target_port}\n")


def forward_stream(source, destination):
    try:
        while True:
            r, _, _ = select.select([source], [], [], TIMEOUT)
            if not r:
                break
            data = source.recv(BUFFER_SIZE)
            if not data:
                break
            destination.sendall(data)
    except Exception:
        pass


def handle_client(client_sock, client_addr, target_host, target_port):
    target_sock = None
    try:
        # Activar TCP_NODELAY para reducir latencia en tuneles SSH
        client_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)

        # Leer encabezado HTTP inicial (hasta 8KB)
        client_sock.settimeout(15.0)
        initial_data = b""
        while b"\r\n\r\n" not in initial_data and len(initial_data) < 8192:
            try:
                chunk = client_sock.recv(4096)
                if not chunk:
                    break
                initial_data += chunk
            except socket.timeout:
                break

        if not initial_data:
            client_sock.close()
            return

        # Conectar al servicio destino (Dropbear o SSH local)
        target_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        target_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        target_sock.settimeout(10.0)
        target_sock.connect((target_host, target_port))
        target_sock.settimeout(None)
        client_sock.settimeout(None)

        lower_data = initial_data.lower()

        # Deteccion de handshake WebSocket (Upgrade: websocket o metodos HTTP)
        if b"upgrade: websocket" in lower_data or b"upgrade:websocket" in lower_data or b"connection: upgrade" in lower_data:
            client_sock.sendall(WS_101_RESPONSE)
            # Si hay datos residuales tras \r\n\r\n en el paquete inicial, enviarlos al target
            header_end = initial_data.find(b"\r\n\r\n")
            if header_end != -1 and header_end + 4 < len(initial_data):
                extra_payload = initial_data[header_end + 4:]
                if extra_payload:
                    target_sock.sendall(extra_payload)

        elif lower_data.startswith(b"get ") or lower_data.startswith(b"gett ") or lower_data.startswith(b"post ") or lower_data.startswith(b"head "):
            # Peticion HTTP regular (algunas apps usan 101 o 200)
            client_sock.sendall(WS_101_RESPONSE)
            header_end = initial_data.find(b"\r\n\r\n")
            if header_end != -1 and header_end + 4 < len(initial_data):
                extra_payload = initial_data[header_end + 4:]
                if extra_payload:
                    target_sock.sendall(extra_payload)

        elif lower_data.startswith(b"connect "):
            # Metodo CONNECT (Proxy HTTP tradicional)
            client_sock.sendall(HTTP_200_RESPONSE)

        else:
            # Conexion SSH o binaria directa sin cabeceras HTTP
            target_sock.sendall(initial_data)

        # Iniciar reenvio bidireccional mediante hilos concurrentes
        t1 = threading.Thread(target=forward_stream, args=(client_sock, target_sock), daemon=True)
        t2 = threading.Thread(target=forward_stream, args=(target_sock, client_sock), daemon=True)
        t1.start()
        t2.start()
        t1.join()
        t2.join()

    except Exception:
        pass
    finally:
        try:
            client_sock.close()
        except Exception:
            pass
        if target_sock:
            try:
                target_sock.close()
            except Exception:
                pass


def run_server(listen_port, target_host, target_port):
    server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

    try:
        server_sock.bind(("0.0.0.0", listen_port))
    except Exception as e:
        print(f"[ERROR] No se pudo vincular al puerto {listen_port}: {e}", file=sys.stderr)
        sys.exit(1)

    server_sock.listen(128)
    print(f"[*] WebSocket Proxy iniciado en 0.0.0.0:{listen_port} -> {target_host}:{target_port}")

    def sig_handler(signum, frame):
        print("\n[*] Deteniendo WebSocket Proxy...")
        try:
            server_sock.close()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    while True:
        try:
            client_sock, client_addr = server_sock.accept()
            client_thread = threading.Thread(
                target=handle_client,
                args=(client_sock, client_addr, target_host, target_port),
                daemon=True,
            )
            client_thread.start()
        except Exception:
            time.sleep(0.05)


def service_cmd(action):
    try:
        res = subprocess.run(["systemctl", action, "ssh-wsproxy"], check=False)
        return res.returncode == 0
    except Exception as e:
        print(f"Error al ejecutar systemctl {action}: {e}", file=sys.stderr)
        return False


def is_service_active():
    try:
        res = subprocess.run(
            ["systemctl", "is-active", "--quiet", "ssh-wsproxy"], check=False
        )
        return res.returncode == 0
    except Exception:
        return False


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--help", "-h"):
            print("Uso: ssh-wsproxy [COMANDO | PUERTO_ESCUCHA] [TARGET_HOST:TARGET_PORT]")
            print("")
            print("Comandos disponibles:")
            print("  --start       Inicia el servicio en segundo plano (systemd)")
            print("  --stop        Detiene el servicio en segundo plano")
            print("  --restart     Reinicia el servicio en segundo plano")
            print("  --status      Muestra el estado del servicio y puertos")
            print("  --run         Ejecuta en primer plano con la configuracion guardada")
            print("")
            print("Ejemplos:")
            print("  ssh-wsproxy --status")
            print("  ssh-wsproxy 80 127.0.0.1:143   (Ejecutar directamente)")
            sys.exit(0)

        elif arg == "--status":
            active = is_service_active()
            l_port, t_host, t_port = load_config()
            status_str = "\033[1;32mONLINE\033[0m" if active else "\033[1;31mOFFLINE\033[0m"
            print(f"Estado del servicio: {status_str}")
            print(f"Puerto de escucha:   {l_port} (0.0.0.0:{l_port})")
            print(f"Servicio destino:    {t_host}:{t_port} (Dropbear/SSH)")
            sys.exit(0 if active else 1)

        elif arg == "--start":
            if service_cmd("start"):
                print("\033[1;32m✔ Servicio ssh-wsproxy iniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo iniciar el servicio ssh-wsproxy.\033[0m")
            sys.exit(0)

        elif arg == "--stop":
            if service_cmd("stop"):
                print("\033[1;33m✔ Servicio ssh-wsproxy detenido.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo detener el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--restart":
            if service_cmd("restart"):
                print("\033[1;32m✔ Servicio ssh-wsproxy reiniciado.\033[0m")
            else:
                print("\033[1;31m[ERROR] No se pudo reiniciar el servicio.\033[0m")
            sys.exit(0)

        elif arg == "--run":
            l_port, t_host, t_port = load_config()
            run_server(l_port, t_host, t_port)
            return

        elif arg.isdigit():
            l_port = int(arg)
            t_host = DEFAULT_TARGET_HOST
            t_port = DEFAULT_TARGET_PORT
            if len(sys.argv) > 2:
                target_part = sys.argv[2]
                if ":" in target_part:
                    t_host, p_str = target_part.split(":", 1)
                    t_port = int(p_str)
                elif target_part.isdigit():
                    t_port = int(target_part)
            save_config(l_port, t_host, t_port)
            run_server(l_port, t_host, t_port)
            return

    # Si se ejecuta sin parametros desde la terminal
    l_port, t_host, t_port = load_config()
    run_server(l_port, t_host, t_port)


if __name__ == "__main__":
    main()
