#!/bin/bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-tunnel-shell
# Shell restringida y persistente para cuentas de túnel SSH (HTTP Custom, Dropbear, OpenSSH).
# Muestra el banner DINÁMICO con el nombre real del usuario conectado, fecha de
# vencimiento, días restantes y enlace interactivo de soporte.
# ==============================================================================
# Obtener nombre de usuario con múltiples fallbacks
u=""
if [[ -n "${USER:-}" ]]; then
    u="$USER"
elif [[ -n "${LOGNAME:-}" ]]; then
    u="$LOGNAME"
else
    u="$(id -un 2>/dev/null || whoami 2>/dev/null || true)"
fi
# Último recurso: obtener del UID del proceso
if [[ -z "$u" || "$u" == "root" ]]; then
    _uid="$(id -u 2>/dev/null || true)"
    if [[ -n "$_uid" && "$_uid" -ge 1000 ]] 2>/dev/null; then
        u="$(getent passwd "$_uid" 2>/dev/null | cut -d: -f1 || true)"
    fi
fi
if [[ -z "$u" || "$u" == "root" || "$u" == "ubuntu" || "$u" == "debian" || "$u" == "admin" ]]; then
    u="usuario"
fi

# --------------------------------------------------------------------------
# 1. Recopilar info dinámica del usuario desde el sistema
# --------------------------------------------------------------------------
_now_epoch=$(date +%s)
_now_date=$(date '+%d/%m/%Y %H:%M')
_exp_date="Sin exp."
_days_left="Ilimitado"
_limit="1"

# Vencimiento y días restantes (chage)
if command -v chage >/dev/null 2>&1 && id "$u" >/dev/null 2>&1; then
    _exp_raw=$(chage -l "$u" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
    if [[ -n "$_exp_raw" && "$_exp_raw" != "never" && "$_exp_raw" != "nunca" ]]; then
        _exp_epoch=$(date -d "$_exp_raw" +%s 2>/dev/null || true)
        if [[ -n "$_exp_epoch" ]]; then
            _exp_date=$(date -d "@$_exp_epoch" +%d/%m/%Y 2>/dev/null || echo "$_exp_raw")
            _diff=$(( (_exp_epoch - _now_epoch) / 86400 ))
            if [[ $_diff -ge 0 ]]; then
                _days_left="${_diff} día(s)"
            else
                _days_left="EXPIRADO"
            fi
        fi
    fi
fi

# Límite desde GECOS en /etc/passwd
_pass_line=$(grep "^${u}:" /etc/passwd 2>/dev/null | head -n1 || true)
if [[ "$_pass_line" =~ LIM[:_=-]?([0-9]+) ]]; then
    _limit="${BASH_REMATCH[1]}"
fi

# Nombre del servidor, contacto y reglas desde configuración
_sname="SupraVPS"
_contact="3826432180"
_rules="Prohibido Torrent, SPAM, DDoS y Multi-Login no autorizado"
_tmpl="1"

if [[ -f /etc/vps-ssh-limiter/banner.conf ]]; then
    # shellcheck disable=SC1091
    source /etc/vps-ssh-limiter/banner.conf 2>/dev/null || true
    _sname="${SERVER_NAME:-SupraVPS}"
    _contact="${CONTACT_INFO:-3826432180}"
    _rules="${CUSTOM_RULES:-Prohibido Torrent, SPAM, DDoS y Multi-Login no autorizado}"
    _tmpl="${TEMPLATE_ID:-1}"
fi
if [[ "${_contact:-}" == *"Telegram"* || "${_contact:-}" == *"@Soporte"* || -z "${_contact:-}" ]]; then
    _contact="3826432180"
fi

# --------------------------------------------------------------------------
# 2. Mostrar banner dinámico del usuario conectado
# --------------------------------------------------------------------------
# Si existe el banner individual pre-generado para esta cuenta, mostrarlo
if [[ -f "/etc/vps-ssh-limiter/banners/${u}.net" && -s "/etc/vps-ssh-limiter/banners/${u}.net" ]]; then
    cat "/etc/vps-ssh-limiter/banners/${u}.net"
elif [[ -x /usr/local/bin/ssh-banner ]]; then
    # shellcheck disable=SC1091
    source /usr/local/bin/ssh-banner --source-only 2>/dev/null || true
    generate_banner_text "$_tmpl" "$_sname" "$_contact" "$_rules" "$u"
else
    # Construcción inteligente de Hipervínculo
    _link_url=""
    _link_text=""
    if [[ "$_contact" =~ ^https?:// ]]; then
        _link_url="$_contact"
        if [[ "$_contact" == *"t.me"* ]]; then
            _link_text="Telegram Soporte"
        elif [[ "$_contact" == *"wa.me"* || "$_contact" == *"whatsapp"* ]]; then
            _link_text="WhatsApp Soporte"
        else
            _link_text="Click Aquí para Contactar"
        fi
    elif [[ "$_contact" =~ ^@ ]]; then
        _tg_u="${_contact#@}"
        _link_url="https://t.me/${_tg_u}"
        _link_text="Telegram (@${_tg_u})"
    elif [[ "$_contact" =~ ^t\.me/ ]]; then
        _link_url="https://${_contact}"
        _link_text="Telegram (${_contact#t.me/})"
    elif [[ "$_contact" =~ ^wa\.me/ ]]; then
        _link_url="https://${_contact}"
        _link_text="WhatsApp (${_contact#wa.me/})"
    else
        _clean_num=$(echo "$_contact" | tr -cd '0-9')
        if [[ -n "$_clean_num" && ${#clean_num} -ge 7 ]]; then
            _link_url="https://wa.me/${_clean_num}"
            _link_text="WhatsApp (${_contact})"
        else
            _link_url="https://t.me/${_contact}"
            _link_text="Contacto: ${_contact}"
        fi
    fi

    case "$_tmpl" in
        2)
            cat <<EOBANNER
<center><font color="#FFD700"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#FFA500"><b>★ ★ ★ ${_sname} VIP NETWORK ★ ★ ★</b></font><br>
<font color="#FFD700"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#FFD700">◆ <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#FFD700">◆ <b>Vence:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#FFA500">(${_days_left})</font><br>
<font color="#FFD700">◆ <b>Límite:</b></font> <font color="#FFA500"><b>${_limit} Dispositivo(s)</b></font><br>
<font color="#FFD700">◆ <b>Contacto:</b></font> <a href="${_link_url}"><font color="#00E5FF"><b><u>${_link_text}</u></b></font></a><br>
<font color="#FFA500">─────────────────────────────────────</font><br>
<center><font color="#FF4444">⚠️ <b>${_rules}</b></font></center>
EOBANNER
            ;;
        3)
            cat <<EOBANNER
<center><font color="#39FF14"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#00FFCC"><b>🎮 ${_sname} GAMING LOW-PING 🎮</b></font><br>
<font color="#39FF14"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#39FF14">► <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#39FF14">► <b>Vence:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00FFCC">(${_days_left})</font><br>
<font color="#39FF14">► <b>Límite:</b></font> <font color="#00E5FF"><b>${_limit} Disp.</b></font><br>
<font color="#39FF14">► <b>Soporte:</b></font> <a href="${_link_url}"><font color="#FFD700"><b><u>${_link_text}</u></b></font></a><br>
<font color="#00FFCC">─────────────────────────────────────</font><br>
<center><font color="#FF3333">⚠️ <b>${_rules}</b></font></center>
EOBANNER
            ;;
        4)
            cat <<EOBANNER
<center><font color="#FF007F"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#00F0FF"><b>⚡ ${_sname} HIGH SPEED ⚡</b></font><br>
<font color="#FF007F"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#00F0FF">► <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#00F0FF">► <b>Vence:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00F0FF">(${_days_left})</font><br>
<font color="#00F0FF">► <b>Límite:</b></font> <font color="#FFFF00"><b>${_limit} Disp.</b></font><br>
<font color="#00F0FF">► <b>Contacto:</b></font> <a href="${_link_url}"><font color="#FF007F"><b><u>${_link_text}</u></b></font></a><br>
<font color="#00F0FF">═════════════════════════════════════</font><br>
<center><font color="#FF0055">⛔ <b>${_rules}</b></font></center>
EOBANNER
            ;;
        5)
            cat <<EOBANNER
<center><font color="#00BFFF"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#FFFFFF"><b>🛡️ ${_sname} SECURE GATEWAY 🛡️</b></font><br>
<font color="#00BFFF"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#00BFFF">✔ <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#00BFFF">✔ <b>Vence:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00BFFF">(${_days_left})</font><br>
<font color="#00BFFF">✔ <b>Límite:</b></font> <font color="#00E5FF"><b>${_limit} simultáneo(s)</b></font><br>
<font color="#00BFFF">✔ <b>Soporte:</b></font> <a href="${_link_url}"><font color="#FFD700"><b><u>${_link_text}</u></b></font></a><br>
<font color="#888888">─────────────────────────────────────</font><br>
<center><font color="#FF3366">⚠️ <b>${_rules}</b></font></center>
EOBANNER
            ;;
        6)
            cat <<EOBANNER
╔═══════════════════════════════════════╗
║     ★ INFORMACIÓN DE TU CUENTA ★      ║
╚═══════════════════════════════════════╝
  ● Usuario     : ${u}
  ● Vencimiento : ${_exp_date} (${_days_left})
  ● Conexiones  : ${_limit} permitido(s)
  ● Contacto    : ${_link_url}
─────────────────────────────────────────
 ⚠️  ${_rules}
═════════════════════════════════════════
EOBANNER
            ;;
        *)
            cat <<EOBANNER
<center><font color="#00E5FF"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#FFD700"><b>★ INFORMACIÓN DE TU CUENTA ★</b></font><br>
<font color="#00E5FF"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#00E5FF">● <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#00E5FF">● <b>Vence:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00E5FF">(${_days_left})</font><br>
<font color="#00E5FF">● <b>Límite:</b></font> <font color="#FFD700"><b>${_limit} Conexión(es)</b></font><br>
<font color="#00E5FF">● <b>Soporte:</b></font> <a href="${_link_url}"><font color="#00FFCC"><b><u>${_link_text}</u></b></font></a><br>
<font color="#888888">─────────────────────────────────────</font><br>
<center><font color="#FF3366">⚠️ <b>${_rules}</b></font></center>
EOBANNER
            ;;
    esac
fi

# --------------------------------------------------------------------------
# 3. Mantener la sesión activa (para port-forwarding / túnel VPN)
# --------------------------------------------------------------------------
while read -r _ 2>/dev/null; do
    :
done

exit 0
