#!/bin/bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-tunnel-shell
# Shell restringida y persistente para cuentas de túnel SSH (HTTP Custom, Dropbear, OpenSSH).
# Genera un banner DINÁMICO con info del usuario en tiempo real (nombre, vencimiento,
# datos usados, conexiones) y mantiene la sesión activa para port-forwarding / VPN.
# ==============================================================================
# Obtener nombre de usuario con múltiples fallbacks (USER puede estar vacío en sesiones restringidas)
u=""
if [[ -n "${USER:-}" ]]; then
    u="$USER"
elif [[ -n "${LOGNAME:-}" ]]; then
    u="$LOGNAME"
else
    u="$(id -un 2>/dev/null || whoami 2>/dev/null || true)"
fi
# Último recurso: obtener del UID del proceso
if [[ -z "$u" || "$u" == "root" ]]; then
    _uid="$(id -u 2>/dev/null || true)"
    if [[ -n "$_uid" && "$_uid" -ge 1000 ]] 2>/dev/null; then
        u="$(getent passwd "$_uid" 2>/dev/null | cut -d: -f1 || true)"
    fi
fi
if [[ -z "$u" ]]; then
    u="usuario"
fi

# --------------------------------------------------------------------------
# 1. Recopilar info dinámica del usuario desde el sistema
# --------------------------------------------------------------------------
_now_epoch=$(date +%s)
_now_date=$(date '+%d/%m/%Y %H:%M')
_exp_date="Sin exp."
_days_left="Ilimitado"
_limit="1"
_conns="0"
_traffic_str="0 B"

# Vencimiento y días restantes (chage)
if command -v chage >/dev/null 2>&1; then
    _exp_raw=$(chage -l "$u" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
    if [[ -n "$_exp_raw" && "$_exp_raw" != "never" && "$_exp_raw" != "nunca" ]]; then
        _exp_epoch=$(date -d "$_exp_raw" +%s 2>/dev/null || true)
        if [[ -n "$_exp_epoch" ]]; then
            _exp_date=$(date -d "@$_exp_epoch" +%d/%m/%Y 2>/dev/null || echo "$_exp_raw")
            _diff=$(( (_exp_epoch - _now_epoch) / 86400 ))
            if [[ $_diff -ge 0 ]]; then
                _days_left="${_diff} dia(s)"
            else
                _days_left="EXPIRADO"
            fi
        fi
    fi
fi

# Límite desde GECOS en /etc/passwd
_pass_line=$(grep "^${u}:" /etc/passwd 2>/dev/null | head -n1 || true)
if [[ "$_pass_line" =~ LIM[:_=-]?([0-9]+) ]]; then
    _limit="${BASH_REMATCH[1]}"
fi

# Conexiones activas del usuario (solo sshd y dropbear)
_conns=0
for p in $(pgrep -u "$u" 2>/dev/null || true); do
    if [[ -r "/proc/$p/comm" ]]; then
        _c=$(cat "/proc/$p/comm" 2>/dev/null || true)
        if [[ "$_c" == *"sshd"* || "$_c" == *"dropbear"* ]]; then
            _conns=$((_conns + 1))
        fi
    fi
done

# Consumo de datos (traffic.db persistente)
_u_bytes=0
if [[ -f /etc/vps-ssh-limiter/traffic.db ]]; then
    _t_line=$(grep "^${u}:" /etc/vps-ssh-limiter/traffic.db 2>/dev/null | head -n1 || true)
    if [[ -n "$_t_line" ]]; then
        _u_bytes=$(echo "$_t_line" | cut -d: -f2 || echo 0)
    fi
fi

if [[ $_u_bytes -ge 1073741824 ]]; then
    _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
elif [[ $_u_bytes -ge 1048576 ]]; then
    _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.2f MB", b / 1048576 }')
elif [[ $_u_bytes -ge 1024 ]]; then
    _traffic_str=$(awk -v b="$_u_bytes" 'BEGIN { printf "%.1f KB", b / 1024 }')
elif [[ $_u_bytes -gt 0 ]]; then
    _traffic_str="${_u_bytes} B"
fi

# Nombre del servidor y contacto desde configuración
_sname="SupraVPS"
_contact="3826432180"
if [[ -f /etc/vps-ssh-limiter/banner.conf ]]; then
    # shellcheck disable=SC1091
    source /etc/vps-ssh-limiter/banner.conf 2>/dev/null || true
    _sname="${SERVER_NAME:-SupraVPS}"
    _contact="${CONTACT_INFO:-3826432180}"
fi
if [[ "${_contact:-}" == *"Telegram"* || "${_contact:-}" == *"@Soporte"* || -z "${_contact:-}" ]]; then
    _contact="3826432180"
fi

# --------------------------------------------------------------------------
# 2. Determinar plantilla del banner y mostrar
# --------------------------------------------------------------------------
_tmpl="${TEMPLATE_ID:-1}"

case "$_tmpl" in
    2)
        cat <<EOBANNER
<center><font color="#FFD700"><b>★ ★ ★ ${_sname} VIP NETWORK ★ ★ ★</b></font><br>
<font color="#FFA500"><b>─────────────────────────────────────</b></font></center><br>
<font color="#FFD700">● <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#FFD700">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#FFA500">(${_days_left})</font><br>
<font color="#FFD700">● <b>Datos Usados:</b></font> <font color="#39FF14"><b>${_traffic_str}</b></font><br>
<font color="#FFD700">● <b>Conexiones:</b></font> <font color="#FFA500">${_conns} de ${_limit} permitido(s)</font><br>
<font color="#FFD700">● <b>Servidor:</b></font> <font color="#FFFFFF">${_sname} VIP</font><br>
<font color="#FFD700">● <b>Estado:</b></font> <font color="#39FF14"><b>CONECTADO / VIP ULTRA</b></font><br>
<font color="#FFD700">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${_now_date}</font><br>
<font color="#FFD700">● <b>Contacto:</b></font> <font color="#00E5FF"><b>${_contact}</b></font><br>
<font color="#FFA500">─────────────────────────────────────</font><br>
<center><font color="#FF4444">⚠️ <b>Prohibido Torrent, SPAM y Multi-Login</b></font><br>
<font color="#FFD700"><b>★ Servicio Exclusivo de Alta Velocidad ★</b></font></center>
EOBANNER
        ;;
    3)
        cat <<EOBANNER
<center><font color="#39FF14"><b>🎮 ${_sname} GAMING LOW-PING PRO 🎮</b></font><br>
<font color="#00FFCC"><b>─────────────────────────────────────</b></font></center><br>
<font color="#39FF14">● <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#39FF14">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00FFCC">(${_days_left})</font><br>
<font color="#39FF14">● <b>Datos Usados:</b></font> <font color="#00FFCC"><b>${_traffic_str}</b></font><br>
<font color="#39FF14">● <b>Conexiones:</b></font> <font color="#00E5FF">${_conns} de ${_limit} permitido(s)</font><br>
<font color="#39FF14">● <b>Servidor:</b></font> <font color="#FFFFFF">${_sname} Gaming</font><br>
<font color="#39FF14">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${_now_date}</font><br>
<font color="#39FF14">● <b>Contacto:</b></font> <font color="#FFD700"><b>${_contact}</b></font><br>
<font color="#00FFCC">─────────────────────────────────────</font><br>
<center><font color="#FF3333">⚠️ <b>Prohibido Torrent, P2P y Multi-Login</b></font><br>
<font color="#39FF14"><b>★ Máxima Velocidad y Menor Latencia ★</b></font></center>
EOBANNER
        ;;
    4)
        cat <<EOBANNER
<center><font color="#FF007F"><b>⚡ ${_sname} CYBERPUNK HIGH SPEED ⚡</b></font><br>
<font color="#00F0FF"><b>═════════════════════════════════════</b></font></center><br>
<font color="#00F0FF">► <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#00F0FF">► <b>Vencimiento:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00F0FF">(${_days_left})</font><br>
<font color="#00F0FF">► <b>Datos:</b></font> <font color="#FF007F"><b>${_traffic_str}</b></font><br>
<font color="#00F0FF">► <b>Conexiones:</b></font> <font color="#FFFF00">${_conns} de ${_limit} permitido(s)</font><br>
<font color="#00F0FF">► <b>Host:</b></font> <font color="#FFFFFF">${_sname}</font><br>
<font color="#00F0FF">► <b>Hora:</b></font> <font color="#FFFFFF">${_now_date}</font><br>
<font color="#00F0FF">► <b>Contacto:</b></font> <font color="#FFFF00"><b>${_contact}</b></font><br>
<font color="#00F0FF">═════════════════════════════════════</font><br>
<center><font color="#FF0055">⛔ <b>No Torrent | No Spam | No DDoS</b></font><br>
<font color="#00F0FF"><b>★ Conexión Cifrada y Segura ★</b></font></center>
EOBANNER
        ;;
    5)
        cat <<EOBANNER
╔═══════════════════════════════════════╗
║     ★ INFORMACIÓN DE TU CUENTA ★      ║
╚═══════════════════════════════════════╝
  ● Usuario     : ${u}
  ● Vencimiento : ${_exp_date} (${_days_left})
  ● Datos Usados: ${_traffic_str}
  ● Conexiones  : ${_conns} de ${_limit} permitido(s)
  ● Servidor    : ${_sname} (SSH / WS)
  ● Estado      : ACTIVO Y OPTIMIZADO
  ● Fecha / Hora: ${_now_date}
  ● Contacto    : ${_contact}
─────────────────────────────────────────
 ⚠️ Prohibido Torrent, Spam y Multi-Login
═════════════════════════════════════════
EOBANNER
        ;;
    *)
        # Plantilla 1 (por defecto): ★ INFORMACIÓN DE TU CUENTA ★ HTML Pro
        cat <<EOBANNER
<center><font color="#00E5FF"><b>╔═══════════════════════════════════╗</b></font><br>
<font color="#FFD700"><b>★ INFORMACIÓN DE TU CUENTA ★</b></font><br>
<font color="#00E5FF"><b>╚═══════════════════════════════════╝</b></font></center><br>
<font color="#39FF14">● <b>Usuario:</b></font> <font color="#FFFFFF">${u}</font><br>
<font color="#39FF14">● <b>Vencimiento:</b></font> <font color="#39FF14"><b>${_exp_date}</b></font> <font color="#00E5FF">(${_days_left})</font><br>
<font color="#39FF14">● <b>Datos Usados:</b></font> <font color="#FF00FF"><b>${_traffic_str}</b></font><br>
<font color="#39FF14">● <b>Conexiones:</b></font> <font color="#00E5FF">${_conns} de ${_limit} permitido(s)</font><br>
<font color="#39FF14">● <b>Servidor:</b></font> <font color="#FFFFFF">${_sname} (Alta Velocidad)</font><br>
<font color="#39FF14">● <b>Estado:</b></font> <font color="#39FF14"><b>ACTIVO Y OPTIMIZADO</b></font><br>
<font color="#39FF14">● <b>Fecha / Hora:</b></font> <font color="#FFFFFF">${_now_date}</font><br>
<font color="#39FF14">● <b>Contacto:</b></font> <font color="#FFD700"><b>${_contact}</b></font><br>
<font color="#888888">─────────────────────────────────────</font><br>
<center><font color="#FF3366">⚠️ <b>Prohibido Torrent, SPAM y Multi-Login</b></font><br>
<font color="#00E5FF"><b>★ Conexión Estable y de Alta Calidad ★</b></font></center>
EOBANNER
        ;;
esac

# --------------------------------------------------------------------------
# 3. Mantener la sesión activa (para port-forwarding / túnel VPN)
# --------------------------------------------------------------------------
while read -r _ 2>/dev/null; do
    :
done

exit 0
