#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-api
# Consulta de vigencia, días restantes y API REST para aplicaciones móviles / clientes.
# Atajos globales: ssh-api, api
# ==============================================================================
set -euo pipefail

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_BORDER="\033[0;36m"
    C_TITLE="\033[1;37m"
    C_BRAND="\033[1;36m"
    C_LABEL="\033[1;36m"
    C_VAL="\033[1;37m"
    C_NUM="\033[1;33m"
    C_ON="\033[1;32m"
    C_OFF="\033[0;31m"
    C_YELLOW="\033[1;33m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_GRAY="\033[0;36m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_BORDER=""
    C_TITLE=""
    C_BRAND=""
    C_LABEL=""
    C_VAL=""
    C_NUM=""
    C_ON=""
    C_OFF=""
    C_YELLOW=""
    C_RED=""
    C_GREEN=""
    C_GRAY=""
fi

get_server_domain() {
    if [[ -f /etc/vps-ssh-limiter/domain && -s /etc/vps-ssh-limiter/domain ]]; then
        tr -d '[:space:]' < /etc/vps-ssh-limiter/domain
    else
        local ip
        ip=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
             curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
             hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
        echo "$ip"
    fi
}

show_code_snippets() {
    local domain
    domain=$(get_server_domain)

    echo -e "\n ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}      ${C_BOLD}${C_WHITE}★ CÓDIGO DE INTEGRACIÓN PARA APPS CLIENTES ★${C_RESET}         ${C_BORDER}│${C_RESET}"
    echo -e " ${C_BORDER}╰───────────────────────────────────────────────────────────╯${C_RESET}"

    echo -e "\n${C_BRAND}1. INTEGRACIÓN EN ANDROID (Kotlin + OkHttp / Retrofit):${C_RESET}"
    cat <<'EOF'
import okhttp3.*
import org.json.JSONObject
import java.io.IOException

fun checkAccountExpiration(vpsHost: String, username: String) {
    val client = OkHttpClient()
    val url = "http://$vpsHost/api/user?u=$username"
    val request = Request.Builder().url(url).build()

    client.newCall(request).enqueue(object : Callback {
        override fun onFailure(call: Call, e: IOException) {
            println("Error al consultar vigencia: ${e.message}")
        }

        override fun onResponse(call: Call, response: Response) {
            response.body?.string()?.let { jsonStr ->
                val json = JSONObject(jsonStr)
                if (json.optBoolean("exists", false)) {
                    val daysLeft = json.optInt("days_left", -1)
                    val isTrial = json.optBoolean("is_trial", false)
                    val minutesLeft = json.optInt("minutes_left", 0)
                    val expireDate = json.optString("expiration_date", "Sin fecha")
                    val isExpired = json.optBoolean("expired", false)
                    val statusText = json.optString("status_text", "ACTIVE")

                    // Actualizar UI del usuario en la App
                    runOnUiThread {
                        if (isExpired) {
                            tvStatus.text = "CUENTA EXPIRADA"
                        } else if (isTrial) {
                            tvStatus.text = "Trial: $minutesLeft min restantes"
                        } else {
                            tvStatus.text = "Vence: $expireDate ($daysLeft días restantes)"
                        }
                    }
                }
            }
        }
    })
}
EOF

    echo -e "\n${C_BRAND}2. INTEGRACIÓN EN FLUTTER / DART (Package 'http'):${C_RESET}"
    cat <<'EOF'
import 'dart:convert';
import 'package:http/http.dart' as http;

Future<Map<String, dynamic>?> checkVpsAccount(String host, String user) async {
  final url = Uri.parse('http://$host/api/user?u=$user');
  try {
    final response = await http.get(url).timeout(const Duration(seconds: 4));
    if (response.statusCode == 200) {
      final data = jsonDecode(response.body);
      // data['days_left'] -> Días que le quedan
      // data['expiration_formatted'] -> "29 día(s) restante(s) (2026-10-15)"
      // data['is_trial'] -> true / false
      // data['minutes_left'] -> Minutos si es trial
      return data;
    }
  } catch (e) {
    print("Error consultando API: $e");
  }
  return null;
}
EOF

    echo -e "\n${C_BRAND}3. CONSULTA DESDE CONSOLA / cURL:${C_RESET}"
    echo -e "  ${C_VAL}curl -s \"http://${domain}/api/user?u=martin\" | jq .${C_RESET}"
    echo -e "  ${C_VAL}curl -s \"http://${domain}/check?user=martin\"${C_RESET}"

    echo -e "\n${C_BRAND}4. EXTRACCIÓN AUTOMÁTICA EN WEBSOCKET HANDSHAKE:${C_RESET}"
    echo -e "  Cuando la app conecte por WebSocket al puerto 80, agrega el header:"
    echo -e "  ${C_LABEL}X-User: <nombre_usuario>${C_RESET}"
    echo -e "  El servidor responderá en el 101 Switching Protocols con:"
    echo -e "  ${C_VAL}X-Account-Days-Left: 29${C_RESET}"
    echo -e "  ${C_VAL}X-Account-Expire: 2026-10-15${C_RESET}"
    echo -e "  ${C_VAL}X-Account-Limit: 2${C_RESET}"
    echo -e "  ${C_VAL}X-Account-Status: ACTIVE${C_RESET}\n"
}

query_api_user() {
    local u="$1"
    local raw_json="${2:-false}"

    # Ejecutar consulta a través del módulo python
    local py_code="
import sys
import json
try:
    sys.path.insert(0, '/usr/local/bin')
    # Importar motor desde ssh-wsproxy si existe
    import importlib.util
    spec = importlib.util.spec_from_file_location('ssh_wsproxy', '/usr/local/bin/ssh-wsproxy')
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    data = mod.get_user_account_info('$u')
except Exception:
    import subprocess, re, time, os, datetime
    # Fallback directo en python puro
    now = int(time.time())
    data = {'status': 'error', 'exists': False, 'username': '$u'}
    if os.path.exists('/etc/passwd'):
        with open('/etc/passwd') as f:
            for l in f:
                p = l.strip().split(':')
                if p and p[0] == '$u':
                    lim = 1
                    m = re.search(r'LIM[:_=-]?([0-9]+)', p[4])
                    if m: lim = int(m.group(1))
                    data = {
                        'status': 'ok', 'exists': True, 'username': '$u',
                        'limit': lim, 'is_trial': False, 'days_left': 30,
                        'expiration_date': 'Activo', 'expiration_formatted': 'Activo',
                        'status_text': 'ACTIVE', 'expired': False
                    }
                    break
print(json.dumps(data))
"
    local json_res
    json_res=$(python3 -c "$py_code" 2>/dev/null || echo '{"status":"error","exists":false,"message":"Error al procesar consulta."}')

    if [[ "$raw_json" == true ]]; then
        echo "$json_res"
        return 0
    fi

    # Extraer campos clave
    local exists
    exists=$(python3 -c "import json; d=json.loads('''$json_res'''); print('true' if d.get('exists') else 'false')" 2>/dev/null || echo "false")
    if [[ "$exists" != "true" ]]; then
        echo -e "\n${C_RED}[ERROR] El usuario '$u' no existe en este servidor VPS.${C_RESET}\n"
        return 1
    fi

    local days_left is_trial min_left exp_date exp_formatted limit act_conns st_text traf_human
    days_left=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('days_left', -1))" 2>/dev/null || echo "-1")
    is_trial=$(python3 -c "import json; d=json.loads('''$json_res'''); print('true' if d.get('is_trial') else 'false')" 2>/dev/null || echo "false")
    min_left=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('minutes_left', 0))" 2>/dev/null || echo "0")
    exp_date=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('expiration_date', 'Sin exp.'))" 2>/dev/null || echo "Sin exp.")
    exp_formatted=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('expiration_formatted', ''))" 2>/dev/null || echo "")
    limit=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('limit', 1))" 2>/dev/null || echo "1")
    act_conns=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('active_connections', 0))" 2>/dev/null || echo "0")
    st_text=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('status_text', 'ACTIVE'))" 2>/dev/null || echo "ACTIVE")
    traf_human=$(python3 -c "import json; d=json.loads('''$json_res'''); print(d.get('traffic_human', '0 MB'))" 2>/dev/null || echo "0 MB")

    local domain
    domain=$(get_server_domain)

    local badge_color="$C_ON"
    local badge_text="ACTIVO"
    if [[ "$st_text" == "EXPIRED" ]]; then
        badge_color="$C_OFF"
        badge_text="EXPIRADO"
    elif [[ "$st_text" == "LOCKED" ]]; then
        badge_color="$C_RED"
        badge_text="BLOQUEADO"
    fi

    echo -e "\n ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}     ${C_BOLD}${C_WHITE}★ FICHA DE CONSULTA API • CUENTA DE USUARIO ★${C_RESET}        ${C_BORDER}│${C_RESET}"
    echo -e " ${C_BORDER}├───────────────────────────────────────────────────────────┤${C_RESET}"
    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Usuario" "$C_VAL" "$u" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Estado" "$badge_color" "$badge_text" "$C_RESET"

    if [[ "$is_trial" == "true" ]]; then
        printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Tipo de Cuenta" "$C_YELLOW" "Prueba Temporal (Trial)" "$C_RESET"
        printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Tiempo Restante" "$C_ON" "${min_left} minutos" "$C_RESET"
    else
        printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Tipo de Cuenta" "$C_VAL" "Estándar / Permanente" "$C_RESET"
        if [[ "$days_left" -ge 0 ]]; then
            printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Días Restantes" "$C_ON" "${days_left} día(s)" "$C_RESET"
        else
            printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Días Restantes" "$C_VAL" "Ilimitado" "$C_RESET"
        fi
    fi

    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Fecha Vencimiento" "$C_VAL" "$exp_date" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Límite Conexiones" "$C_VAL" "${limit} simultánea(s)" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Conexiones en Vivo" "$C_VAL" "${act_conns} / ${limit} en uso" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET}  %-24s : %b%-30s%b ${C_BORDER}│${C_RESET}\n" "Tráfico Acumulado" "$C_VAL" "$traf_human" "$C_RESET"
    echo -e " ${C_BORDER}├───────────────────────────────────────────────────────────┤${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}  ${C_LABEL}🌐 ENDPOINTS HTTP LISTOS PARA TU APP:${C_RESET}                    ${C_BORDER}│${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}  ${C_VAL}http://${domain}/api/user?u=${u}${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}  ${C_VAL}http://${domain}/check?user=${u}${C_RESET}"
    echo -e " ${C_BORDER}╰───────────────────────────────────────────────────────────╯${C_RESET}\n"
}

# ------------------------------------------------------------------------------
# Manejo de Argumentos CLI
# ------------------------------------------------------------------------------
RAW_JSON=false
SHOW_CODE=false
USER_ARG=""

for arg in "$@"; do
    case "$arg" in
        --json|-j)
            RAW_JSON=true
            ;;
        --code|-c)
            SHOW_CODE=true
            ;;
        -h|--help)
            cat <<EOF
Uso: ssh-api [OPCIONES] [USUARIO]

Consulta la vigencia, fecha de vencimiento y estado de cuentas VPS mediante
la API REST incorporada (puerto 80) o línea de comandos.

Opciones:
    <usuario>        Muestra la ficha de consulta interactiva para la cuenta.
    --json, -j       Devuelve la respuesta en formato JSON crudo (para scripts/curl).
    --code, -c       Muestra ejemplos de código listos para Android (Kotlin) y Flutter (Dart).
    -h, --help       Muestra esta ayuda.

Ejemplos:
    ssh-api martin
    ssh-api --json martin
    ssh-api --code
EOF
            exit 0
            ;;
        *)
            if [[ -z "$USER_ARG" && ! "$arg" =~ ^- ]]; then
                USER_ARG="$arg"
            fi
            ;;
    esac
done

if [[ "$SHOW_CODE" == true ]]; then
    show_code_snippets
    exit 0
fi

if [[ -n "$USER_ARG" ]]; then
    query_api_user "$USER_ARG" "$RAW_JSON"
    exit 0
fi

# Si no se pasó argumento y está en terminal interactivo
if [[ -t 0 ]]; then
    echo -e "\n ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e " ${C_BORDER}│${C_RESET}   ${C_BOLD}${C_WHITE}★ API DE CONSULTA DE VIGENCIA PARA APPS MÓVILES ★${C_RESET}       ${C_BORDER}│${C_RESET}"
    echo -e " ${C_BORDER}╰───────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "  ${C_NUM}[1]${C_RESET} 🔍 Consultar usuario existente"
    echo -e "  ${C_NUM}[2]${C_RESET} 📱 Ver código de integración (Kotlin / Flutter / cURL)"
    echo -e "  ${C_RED}[0]${C_RESET} ↩️  Salir"
    echo -e " ${C_BORDER}─────────────────────────────────────────────────────────────${C_RESET}"
    read -r -p "  ❱❱❱ Seleccione una opción [0-2]: " menu_opt || true

    case "${menu_opt:-}" in
        1)
            read -r -p " Ingrese el nombre de usuario: " sel_u || true
            if [[ -n "${sel_u:-}" ]]; then
                query_api_user "$sel_u" false
            fi
            ;;
        2)
            show_code_snippets
            ;;
        *)
            exit 0
            ;;
    esac
else
    echo "Uso: ssh-api <usuario> [--json] [--code]"
    exit 1
fi
