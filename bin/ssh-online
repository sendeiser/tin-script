#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-online
# Monitor CLI de conexiones concurrentes para SSH y Dropbear.
# Optimizado para pantallas móviles (41 columnas) con soporte para tabla extendida y JSON.
# ==============================================================================
set -euo pipefail

USE_COLOR=true
JSON_OUTPUT=false
WIDE_TABLE=false

if [[ ! -t 1 ]]; then
    USE_COLOR=false
fi

for arg in "$@"; do
    case "$arg" in
        --no-color) USE_COLOR=false ;;
        --json) JSON_OUTPUT=true ;;
        --wide|--table|-w) WIDE_TABLE=true ;;
        -h|--help)
            cat <<EOF
Uso: ssh-online [OPCIONES]

Opciones:
    --wide, -w    Muestra la tabla horizontal ancha (para terminales de PC).
    --no-color    Desactiva el resaltado de color en la terminal.
    --json        Genera la salida en formato JSON estructurado.
    -h, --help    Muestra esta ayuda.
EOF
            exit 0
            ;;
    esac
done

if [[ "$USE_COLOR" == true ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

# ------------------------------------------------------------------------------
# Funciones de Medición y Formateo de Tráfico / Datos
# ------------------------------------------------------------------------------
format_bytes() {
    local b="${1:-0}"
    if [[ ! "$b" =~ ^[0-9]+$ ]] || [[ "$b" -le 0 ]]; then
        echo "0 B"
        return
    fi
    if [[ $b -ge 1073741824 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.2f GB", b / 1073741824 }'
    elif [[ $b -ge 1048576 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.2f MB", b / 1048576 }'
    elif [[ $b -ge 1024 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.1f KB", b / 1024 }'
    else
        echo "${b} B"
    fi
}

# ------------------------------------------------------------------------------
# Mapeo Universal de Conexiones en Vivo (Dropbear + OpenSSH)
# ------------------------------------------------------------------------------
declare -A USER_SSH_COUNT=()
declare -A USER_DROPBEAR_COUNT=()
declare -A USER_ACTIVE_PIDS=()

load_all_user_connections() {
    USER_SSH_COUNT=()
    USER_DROPBEAR_COUNT=()
    USER_ACTIVE_PIDS=()

    # 1. Procesos que corren bajo el UID del usuario (sesiones interactivas o túneles con setuid)
    for entry in "${USERS_LIST[@]}"; do
        local u="${entry%%:*}"
        USER_SSH_COUNT["$u"]=0
        USER_DROPBEAR_COUNT["$u"]=0
        USER_ACTIVE_PIDS["$u"]=""

        local pids
        pids=$(pgrep -u "$u" 2>/dev/null || true)
        for p in $pids; do
            [[ -z "$p" || ! "$p" =~ ^[0-9]+$ || ! -d "/proc/$p" ]] && continue
            local comm=""
            [[ -r "/proc/$p/comm" ]] && comm=$(cat "/proc/$p/comm" 2>/dev/null || true)
            # Contabilizar únicamente procesos de transporte SSH auténticos
            if [[ "$comm" == *"dropbear"* ]]; then
                local cur="${USER_ACTIVE_PIDS["$u"]:-}"
                if [[ ! " $cur " =~ " $p " ]]; then
                    USER_DROPBEAR_COUNT["$u"]=$(( ${USER_DROPBEAR_COUNT["$u"]:-0} + 1 ))
                    USER_ACTIVE_PIDS["$u"]="${cur} $p"
                fi
            elif [[ "$comm" == *"sshd"* ]]; then
                # En OpenSSH cada conexion autenticada crea un proceso unpriv [net] y una sesion @notty
                # Ignorar [net] y [priv] para contabilizar exactamente 1 proceso por conexion real
                local cmdline=""
                [[ -r "/proc/$p/cmdline" ]] && cmdline=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null || true)
                if [[ "$cmdline" == *"[net]"* || "$cmdline" == *"[priv]"* ]]; then
                    continue
                fi
                # Si el proceso padre (PPID) tambien es sshd, es el subproceso hijo de la misma sesion: no contar doble
                local ppid
                ppid=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 0)
                if [[ -n "$ppid" && "$ppid" -gt 1 && -d "/proc/$ppid" ]]; then
                    local pcomm
                    pcomm=$(cat "/proc/$ppid/comm" 2>/dev/null || true)
                    if [[ "$pcomm" == *"sshd"* ]]; then
                        continue
                    fi
                fi
                local cur="${USER_ACTIVE_PIDS["$u"]:-}"
                if [[ ! " $cur " =~ " $p " ]]; then
                    USER_SSH_COUNT["$u"]=$(( ${USER_SSH_COUNT["$u"]:-0} + 1 ))
                    USER_ACTIVE_PIDS["$u"]="${cur} $p"
                fi
            fi
        done
    done

    # 2. Conexiones Dropbear en modo túnel/port-forwarding (corren como root)
    local db_active=()
    for p in $(pgrep -x dropbear 2>/dev/null || true); do
        [[ -n "$p" && -d "/proc/$p" ]] && db_active+=("$p")
    done

    if [[ ${#db_active[@]} -gt 0 ]]; then
        local logs=""
        if command -v journalctl >/dev/null 2>&1; then
            logs=$(journalctl -u dropbear -n 1000 --no-pager 2>/dev/null || true)
        fi
        if [[ -f /var/log/auth.log ]]; then
            local al
            al=$(tail -n 1000 /var/log/auth.log 2>/dev/null | grep -i "dropbear" || true)
            logs="${logs}"$'\n'"${al}"
        fi

        # Parsear: dropbear[12345]: Password auth succeeded for 'carlos'
        while read -r line; do
            if [[ "$line" =~ dropbear\[([0-9]+)\]:.*auth\ succeeded\ for\ \'([^\']+)\' ]]; then
                local pid="${BASH_REMATCH[1]}"
                local user="${BASH_REMATCH[2]}"
                if [[ -d "/proc/$pid" ]]; then
                    local comm=""
                    [[ -r "/proc/$pid/comm" ]] && comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
                    if [[ "$comm" == *"dropbear"* ]]; then
                        local cur="${USER_ACTIVE_PIDS["$user"]:-}"
                        # Evitar contar el proceso padre si ya se registro el hijo bajo el UID del usuario
                        local already_has_child=false
                        for ep in $cur; do
                            local e_ppid
                            e_ppid=$(awk '{print $4}' "/proc/$ep/stat" 2>/dev/null || echo 0)
                            if [[ "$e_ppid" -eq "$pid" ]]; then
                                already_has_child=true
                                break
                            fi
                        done
                        if [[ "$already_has_child" == false && ! " $cur " =~ " $pid " ]]; then
                            USER_DROPBEAR_COUNT["$user"]=$(( ${USER_DROPBEAR_COUNT["$user"]:-0} + 1 ))
                            USER_ACTIVE_PIDS["$user"]="${cur} $pid"
                        fi
                    fi
                fi
            fi
        done <<< "$logs"
    fi
}

get_user_traffic_bytes() {
    local user="$1"
    local db_file="/etc/vps-ssh-limiter/traffic.db"
    local total_bytes=0

    if [[ -f "$db_file" ]]; then
        local line
        line=$(grep "^${user}:" "$db_file" 2>/dev/null | head -n1 || true)
        if [[ -n "$line" ]]; then
            total_bytes=$(echo "$line" | cut -d: -f2 || echo 0)
        fi
    fi

    # Sumar consumo en vivo de todos los procesos activos del usuario
    local pids="${USER_ACTIVE_PIDS["$user"]:-}"
    for p in $pids; do
        [[ -z "$p" || ! "$p" =~ ^[0-9]+$ || ! -r "/proc/$p/io" ]] && continue
        local r_b w_b cur_total last_seen=0
        r_b=$(awk '/rchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
        w_b=$(awk '/wchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
        cur_total=$(( r_b + w_b ))

        local p_file="/run/vps-ssh-limiter/pids/${p}"
        if [[ -f "$p_file" ]]; then
            last_seen=$(cat "$p_file" 2>/dev/null || echo 0)
        fi
        if [[ $cur_total -gt $last_seen ]]; then
            total_bytes=$(( total_bytes + (cur_total - last_seen) ))
        fi
    done

    echo "$total_bytes"
}

get_server_total_traffic_bytes() {
    local rx=0 tx=0
    if [[ -r /proc/net/dev ]]; then
        while read -r iface rx_b _ _ _ _ _ _ _ tx_b _; do
            if [[ "$iface" != "lo:" && "$iface" =~ :$ ]]; then
                rx=$(( rx + rx_b ))
                tx=$(( tx + tx_b ))
            fi
        done < /proc/net/dev
    fi
    echo $(( rx + tx ))
}

count_user_connections() {
    local user="$1"
    local s_cnt="${USER_SSH_COUNT["$user"]:-0}"
    local d_cnt="${USER_DROPBEAR_COUNT["$user"]:-0}"
    echo "$s_cnt $d_cnt"
}

# ------------------------------------------------------------------------------
# Función para verificar expiración y calcular días restantes
# ------------------------------------------------------------------------------
check_user_expiration() {
    local user="$1"
    local expiry_raw=""
    local is_expired="NO"
    local expiry_formatted="Sin exp."
    local days_left="Ilimitado"
    local now_epoch
    now_epoch=$(date +%s)

    # 1. Comprobar si es una cuenta trial activa en trials.db
    local trials_db="/etc/vps-ssh-limiter/trials.db"
    if [[ -f "$trials_db" ]]; then
        local t_line
        t_line=$(grep "^${user}:" "$trials_db" 2>/dev/null | head -n1 || true)
        if [[ -n "$t_line" ]]; then
            local t_exp
            t_exp=$(echo "$t_line" | cut -d: -f2)
            if [[ -n "$t_exp" && "$t_exp" =~ ^[0-9]+$ ]]; then
                expiry_formatted=$(date -d "@$t_exp" +"%H:%M" 2>/dev/null || echo "Trial")
                if [[ "$now_epoch" -ge "$t_exp" ]]; then
                    days_left="TRIAL EXP"
                    is_expired="SI"
                else
                    local rem_sec=$(( t_exp - now_epoch ))
                    local rem_min=$(( rem_sec / 60 ))
                    if [[ $rem_min -ge 60 ]]; then
                        local rem_h=$(( rem_min / 60 ))
                        local rem_m=$(( rem_min % 60 ))
                        days_left="${rem_h}h ${rem_m}m"
                    else
                        days_left="${rem_min}m"
                    fi
                fi
                echo "${expiry_formatted}|${is_expired}|${days_left}"
                return
            fi
        fi
    fi

    # 2. Comprobación estándar con chage
    if command -v chage >/dev/null 2>&1; then
        expiry_raw=$(chage -l "$user" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$expiry_raw" && "$expiry_raw" != "never" && "$expiry_raw" != "nunca" ]]; then
            local expiry_epoch
            expiry_epoch=$(date -d "$expiry_raw" +%s 2>/dev/null || true)
            if [[ -n "$expiry_epoch" ]]; then
                expiry_formatted=$(date -d "@$expiry_epoch" +%Y-%m-%d 2>/dev/null || echo "$expiry_raw")
                local diff=$(( (expiry_epoch - now_epoch) / 86400 ))
                if [[ $diff -ge 0 ]]; then
                    days_left="${diff} d rest."
                else
                    days_left="EXPIRADO"
                    is_expired="SI"
                fi
            fi
        fi
    fi

    echo "${expiry_formatted}|${is_expired}|${days_left}"
}

# ------------------------------------------------------------------------------
# Detección Universal de Usuarios Túnel en el Sistema
# ------------------------------------------------------------------------------
PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
if [[ ! -r "$PASSWD_FILE" ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} No se puede leer el archivo $PASSWD_FILE" >&2
    exit 1
fi

declare -a USERS_LIST=()
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    u="${line%%:*}"
    [[ -z "$u" ]] && continue
    rest="${line#*:}"
    rest="${rest#*:}"
    uid="${rest%%:*}"

    limit=""
    if [[ "$line" =~ LIM[:_=-]?([0-9]+) ]]; then
        limit="${BASH_REMATCH[1]}"
    elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]]; then
        if [[ "$u" != "nobody" && "$u" != "nogroup" && "$u" != "ubuntu" && "$u" != "debian" ]]; then
            limit="1"
        fi
    fi

    if [[ -n "$limit" ]]; then
        USERS_LIST+=("$u:$limit")
    fi
done < "$PASSWD_FILE"

TOTAL_MANAGED=${#USERS_LIST[@]}
load_all_user_connections

# ------------------------------------------------------------------------------
# Salida en Formato JSON
# ------------------------------------------------------------------------------
if [[ "$JSON_OUTPUT" == true ]]; then
    json_entries=()
    for entry in "${USERS_LIST[@]}"; do
        user="${entry%%:*}"
        limit="${entry##*:}"

        read -r ssh_count dropbear_count < <(count_user_connections "$user")
        IFS='|' read -r exp_date is_exp days_left < <(check_user_expiration "$user")
        total_conn=$((ssh_count + dropbear_count))
        u_traffic=$(get_user_traffic_bytes "$user")
        u_traffic_fmt=$(format_bytes "$u_traffic")

        status="OFFLINE"
        if [[ "$is_exp" == "SI" ]]; then
            status="EXPIRADO"
        elif [[ "$total_conn" -gt "$limit" ]]; then
            status="EXCEDIDO"
        elif [[ "$total_conn" -eq "$limit" && "$total_conn" -gt 0 ]]; then
            status="AL_LIMITE"
        elif [[ "$total_conn" -gt 0 ]]; then
            status="ACTIVO"
        fi

        json_entries+=("{\"username\":\"$user\",\"ssh\":$ssh_count,\"dropbear\":$dropbear_count,\"total\":$total_conn,\"limit\":$limit,\"traffic_bytes\":$u_traffic,\"traffic_formatted\":\"$u_traffic_fmt\",\"expiration\":\"$exp_date\",\"days_left\":\"$days_left\",\"expired\":$( [[ "$is_exp" == "SI" ]] && echo "true" || echo "false" ),\"status\":\"$status\"}")
    done
    
    joined=$(IFS=,; echo "${json_entries[*]}")
    srv_traffic=$(get_server_total_traffic_bytes)
    srv_traffic_fmt=$(format_bytes "$srv_traffic")
    echo "{\"total_managed\":$TOTAL_MANAGED,\"timestamp\":\"$(date -Iseconds)\",\"server_traffic_bytes\":$srv_traffic,\"server_traffic_formatted\":\"$srv_traffic_fmt\",\"users\":[$joined]}"
    exit 0
fi

# ------------------------------------------------------------------------------
# Modo Tabla Ancha (--wide para PC / Terminales grandes)
# ------------------------------------------------------------------------------
if [[ "$WIDE_TABLE" == true ]]; then
    echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}${C_WHITE}    VPS-SSH-LIMITER :: MONITOR DE CONEXIONES Y CONSUMO DE DATOS     ${C_RESET}${C_GRAY}($(date '+%H:%M:%S'))${C_RESET} ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════════════════════╝${C_RESET}"

    if [[ $TOTAL_MANAGED -eq 0 ]]; then
        echo -e "${C_YELLOW}⚠ No se encontraron usuarios túnel configurados en el sistema.${C_RESET}"
        echo -e "Cree usuarios con: ${C_BOLD}${C_GREEN}ssh-useradd <usuario> <contraseña> <días> <límite>${C_RESET}\n"
        exit 0
    fi

    printf " ${C_BOLD}%-16s %-5s %-9s %-6s %-7s %-12s %-12s %-20s${C_RESET}\n" \
        "USUARIO" "SSH" "DROPBEAR" "TOTAL" "CUOTA" "DATOS USADOS" "EXPIRACIÓN" "ESTADO"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"

    ONLINE_USERS=0
    TOTAL_ALL_CONN=0

    for entry in "${USERS_LIST[@]}"; do
        user="${entry%%:*}"
        limit="${entry##*:}"

        read -r ssh_count dropbear_count < <(count_user_connections "$user")
        IFS='|' read -r exp_date is_exp days_left < <(check_user_expiration "$user")
        total_conn=$((ssh_count + dropbear_count))
        u_bytes=$(get_user_traffic_bytes "$user")
        u_traffic_str=$(format_bytes "$u_bytes")

        TOTAL_ALL_CONN=$((TOTAL_ALL_CONN + total_conn))
        if [[ "$total_conn" -gt 0 ]]; then
            ONLINE_USERS=$((ONLINE_USERS + 1))
        fi

        user_color="${C_WHITE}"
        quota_str="${total_conn}/${limit}"
        if [[ "$is_exp" == "SI" ]]; then
            status_label="${C_RED}⏰ EXPIRADO${C_RESET}"
            user_color="${C_RED}"
        elif [[ "$total_conn" -gt "$limit" ]]; then
            status_label="${C_RED}${C_BOLD}🚫 EXCEDIDO (${total_conn}/${limit})${C_RESET}"
            user_color="${C_RED}"
        elif [[ "$total_conn" -eq "$limit" && "$total_conn" -gt 0 ]]; then
            status_label="${C_YELLOW}⚠️  AL LÍMITE (${total_conn}/${limit})${C_RESET}"
            user_color="${C_YELLOW}"
        elif [[ "$total_conn" -gt 0 ]]; then
            status_label="${C_GREEN}● ONLINE (${total_conn}/${limit})${C_RESET}"
            user_color="${C_GREEN}"
        else
            status_label="${C_GRAY}○ Desconectado${C_RESET}"
            user_color="${C_WHITE}"
        fi

        printf " ${user_color}%-16s${C_RESET} %-5d %-9d %-6d %-7s %-12s %-12s %b\n" \
            "$user" "$ssh_count" "$dropbear_count" "$total_conn" "$quota_str" "$u_traffic_str" "$exp_date" "$status_label"
    done

    srv_total_bytes=$(get_server_total_traffic_bytes)
    srv_total_str=$(format_bytes "$srv_total_bytes")

    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"
    printf " ${C_BOLD}%-13s${C_RESET} ${C_CYAN}%d${C_RESET} | ${C_BOLD}Online:${C_RESET} ${C_GREEN}%d${C_RESET} | ${C_BOLD}Conexiones:${C_RESET} ${C_YELLOW}%d${C_RESET} | ${C_BOLD}Tráfico Total Servidor:${C_RESET} ${C_BOLD}${C_GREEN}%s${C_RESET}\n" \
        "Registrados:" "$TOTAL_MANAGED" "$ONLINE_USERS" "$TOTAL_ALL_CONN" "$srv_total_str"
    echo -e "${C_CYAN}══════════════════════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    exit 0
fi

# ------------------------------------------------------------------------------
# Modo Móvil por Defecto (Tarjetas 41 columnas - 100% Celular)
# ------------------------------------------------------------------------------
srv_total_bytes=$(get_server_total_traffic_bytes)
srv_total_str=$(format_bytes "$srv_total_bytes")

echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
echo -e "${C_CYAN}║${C_RESET}   ${C_BOLD}${C_WHITE}★ MONITOR DE CONEXIONES Y DATOS ★${C_RESET}   ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}║${C_RESET}               ${C_GRAY}($(date '+%H:%M:%S'))${C_RESET}              ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"

if [[ $TOTAL_MANAGED -eq 0 ]]; then
    echo -e " ${C_YELLOW}⚠ No hay usuarios túnel en el sistema.${C_RESET}"
    echo -e " Cree uno con: ${C_GREEN}ssh-useradd <usuario>${C_RESET}"
    echo -e "${C_CYAN}═════════════════════════════════════════${C_RESET}\n"
    exit 0
fi

ONLINE_USERS=0
TOTAL_ALL_CONN=0
TOTAL_LIMIT_CAP=0
idx=0

# Primero calculamos estadísticas globales
for entry in "${USERS_LIST[@]}"; do
    u="${entry%%:*}"
    lim="${entry##*:}"
    TOTAL_LIMIT_CAP=$((TOTAL_LIMIT_CAP + lim))
    read -r s_cnt d_cnt < <(count_user_connections "$u")
    tot_c=$((s_cnt + d_cnt))
    TOTAL_ALL_CONN=$((TOTAL_ALL_CONN + tot_c))
    if [[ "$tot_c" -gt 0 ]]; then
        ONLINE_USERS=$((ONLINE_USERS + 1))
    fi
done

echo -e " ${C_BOLD}Total:${C_RESET} ${C_CYAN}${TOTAL_MANAGED}${C_RESET} | ${C_BOLD}Online:${C_RESET} ${C_GREEN}${ONLINE_USERS}${C_RESET} | ${C_BOLD}Tráfico:${C_RESET} ${C_GREEN}${srv_total_str}${C_RESET}"
echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"

for entry in "${USERS_LIST[@]}"; do
    idx=$((idx + 1))
    user="${entry%%:*}"
    limit="${entry##*:}"

    read -r ssh_count dropbear_count < <(count_user_connections "$user")
    IFS='|' read -r exp_date is_exp days_left < <(check_user_expiration "$user")
    total_conn=$((ssh_count + dropbear_count))
    u_bytes=$(get_user_traffic_bytes "$user")
    u_traffic_str=$(format_bytes "$u_bytes")

    # Formatear estado para móvil
    if [[ "$is_exp" == "SI" ]]; then
        badge="${C_RED}⏰ EXPIRADO${C_RESET}"
        bullet="${C_RED}●${C_RESET}"
    elif [[ "$total_conn" -gt "$limit" ]]; then
        badge="${C_RED}${C_BOLD}🚫 EXCEDIDO (${total_conn}/${limit})${C_RESET}"
        bullet="${C_RED}●${C_RESET}"
    elif [[ "$total_conn" -eq "$limit" && "$total_conn" -gt 0 ]]; then
        badge="${C_YELLOW}⚠️ AL LÍMITE (${total_conn}/${limit})${C_RESET}"
        bullet="${C_YELLOW}●${C_RESET}"
    elif [[ "$total_conn" -gt 0 ]]; then
        badge="${C_GREEN}● ONLINE (${total_conn}/${limit})${C_RESET}"
        bullet="${C_GREEN}●${C_RESET}"
    else
        badge="${C_GRAY}○ OFFLINE (0/${limit})${C_RESET}"
        bullet="${C_WHITE}○${C_RESET}"
    fi

    echo -e " ${C_BOLD}[${idx}]${C_RESET} ${bullet} ${C_BOLD}${C_WHITE}${user}${C_RESET} : ${badge}"
    echo -e "     • Datos : ${C_MAGENTA}${u_traffic_str}${C_RESET} usados"
    echo -e "     • Vence : ${C_CYAN}${exp_date}${C_RESET} (${days_left})"
    if [[ "$total_conn" -gt 0 ]]; then
        echo -e "     • Túnel : ${C_YELLOW}SSH: ${ssh_count}${C_RESET} | ${C_YELLOW}Dropbear: ${dropbear_count}${C_RESET}"
    else
        echo -e "     • Túnel : ${C_GRAY}Sin conexiones activas${C_RESET}"
    fi

    if [[ $idx -lt $TOTAL_MANAGED ]]; then
        echo -e "${C_GRAY}  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·${C_RESET}"
    fi
done

echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
echo -e " Conexiones activas: ${C_YELLOW}${TOTAL_ALL_CONN}${C_RESET} de ${C_BOLD}${TOTAL_LIMIT_CAP}${C_RESET} permitidas"
echo -e "${C_CYAN}═════════════════════════════════════════${C_RESET}\n"

exit 0
