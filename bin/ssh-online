#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-online
# Monitor CLI de conexiones concurrentes para SSH y Dropbear.
# Muestra una tabla formateada con estado en tiempo real, límites y expiración.
# ==============================================================================
set -euo pipefail

USE_COLOR=true
JSON_OUTPUT=false

if [[ ! -t 1 ]]; then
    USE_COLOR=false
fi

for arg in "$@"; do
    case "$arg" in
        --no-color) USE_COLOR=false ;;
        --json) JSON_OUTPUT=true ;;
        -h|--help)
            cat <<EOF
Uso: ssh-online [OPCIONES]

Opciones:
    --no-color    Desactiva el resaltado de color en la terminal.
    --json        Genera la salida en formato JSON estructurado.
    -h, --help    Muestra esta ayuda.
EOF
            exit 0
            ;;
    esac
done

if [[ "$USE_COLOR" == true ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi
# ------------------------------------------------------------------------------
# Funciones de Medición y Formateo de Tráfico / Datos
# ------------------------------------------------------------------------------
format_bytes() {
    local b="${1:-0}"
    if [[ ! "$b" =~ ^[0-9]+$ ]] || [[ "$b" -le 0 ]]; then
        echo "0 B"
        return
    fi
    if [[ $b -ge 1073741824 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.2f GB", b / 1073741824 }'
    elif [[ $b -ge 1048576 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.2f MB", b / 1048576 }'
    elif [[ $b -ge 1024 ]]; then
        awk -v b="$b" 'BEGIN { printf "%.1f KB", b / 1024 }'
    else
        echo "${b} B"
    fi
}

get_user_traffic_bytes() {
    local user="$1"
    local db_file="/etc/vps-ssh-limiter/traffic.db"
    local saved_bytes=0

    if [[ -f "$db_file" ]]; then
        local line
        line=$(grep "^${user}:" "$db_file" 2>/dev/null | head -n1 || true)
        if [[ -n "$line" ]]; then
            saved_bytes=$(echo "$line" | cut -d: -f2 || echo 0)
        fi
    fi

    local live_bytes=0
    local pids
    pids=$(pgrep -u "$user" 2>/dev/null || true)
    for p in $pids; do
        if [[ -r "/proc/$p/io" ]]; then
            local r_b w_b
            r_b=$(awk '/rchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            w_b=$(awk '/wchar:/ {print $2}' "/proc/$p/io" 2>/dev/null || echo 0)
            live_bytes=$(( live_bytes + r_b + w_b ))
        fi
    done

    echo $(( saved_bytes + live_bytes ))
}

get_server_total_traffic_bytes() {
    local rx=0 tx=0
    if [[ -r /proc/net/dev ]]; then
        while read -r iface rx_b _ _ _ _ _ _ _ tx_b _; do
            if [[ "$iface" != "lo:" && "$iface" =~ :$ ]]; then
                rx=$(( rx + rx_b ))
                tx=$(( tx + tx_b ))
            fi
        done < /proc/net/dev
    fi
    echo $(( rx + tx ))
}

# ------------------------------------------------------------------------------
# Función para contar procesos activos por usuario
# ------------------------------------------------------------------------------
count_user_connections() {
    local user="$1"
    local ssh_pids=""
    local dropbear_pids=""

    # Dual inspection: OpenSSH y Dropbear bajo el UID del usuario
    ssh_pids=$(pgrep -u "$user" -f "^sshd: $user@" 2>/dev/null || true)
    dropbear_pids=$(pgrep -u "$user" -x "dropbear" 2>/dev/null || true)

    local ssh_count=0
    local dropbear_count=0

    if [[ -n "$ssh_pids" ]]; then
        ssh_count=$(echo "$ssh_pids" | wc -w)
    fi

    if [[ -n "$dropbear_pids" ]]; then
        dropbear_count=$(echo "$dropbear_pids" | wc -w)
    fi

    echo "$ssh_count $dropbear_count"
}

# ------------------------------------------------------------------------------
# Función para verificar expiración
# ------------------------------------------------------------------------------
check_user_expiration() {
    local user="$1"
    local expiry_raw=""
    local is_expired="NO"
    local expiry_formatted="Sin exp."

    # Intentar obtener información de chage
    if command -v chage >/dev/null 2>&1; then
        expiry_raw=$(chage -l "$user" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
        if [[ -n "$expiry_raw" && "$expiry_raw" != "never" && "$expiry_raw" != "nunca" ]]; then
            local expiry_epoch
            expiry_epoch=$(date -d "$expiry_raw" +%s 2>/dev/null || true)
            if [[ -n "$expiry_epoch" ]]; then
                expiry_formatted=$(date -d "@$expiry_epoch" +%Y-%m-%d 2>/dev/null || echo "$expiry_raw")
                local now_epoch
                now_epoch=$(date +%s)
                if [[ "$now_epoch" -gt "$expiry_epoch" ]]; then
                    is_expired="SI"
                fi
            fi
        fi
    fi

    echo "${expiry_formatted}|${is_expired}"
}

# ------------------------------------------------------------------------------
# Recolección de usuarios gestionados (GECOS contiene LIM:<N>)
# ------------------------------------------------------------------------------
PASSWD_FILE="${PASSWD_FILE:-/etc/passwd}"
if [[ ! -r "$PASSWD_FILE" ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} No se puede leer el archivo $PASSWD_FILE" >&2
    exit 1
fi

declare -a USERS_LIST=()
while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^([a-zA-Z0-9_-]+):.*:LIM[:_=-]?([0-9]+) ]]; then
        username="${BASH_REMATCH[1]}"
        limit="${BASH_REMATCH[2]}"
        USERS_LIST+=("$username:$limit")
    fi
done < "$PASSWD_FILE"

TOTAL_MANAGED=${#USERS_LIST[@]}

if [[ "$JSON_OUTPUT" == true ]]; then
    json_entries=()
    for entry in "${USERS_LIST[@]}"; do
        user="${entry%%:*}"
        limit="${entry##*:}"

        read -r ssh_count dropbear_count < <(count_user_connections "$user")
        IFS='|' read -r exp_date is_exp < <(check_user_expiration "$user")
        total_conn=$((ssh_count + dropbear_count))
        u_traffic=$(get_user_traffic_bytes "$user")
        u_traffic_fmt=$(format_bytes "$u_traffic")

        status="OFFLINE"
        if [[ "$is_exp" == "SI" ]]; then
            status="EXPIRADO"
        elif [[ "$total_conn" -gt "$limit" ]]; then
            status="EXCEDIDO"
        elif [[ "$total_conn" -eq "$limit" && "$total_conn" -gt 0 ]]; then
            status="AL_LIMITE"
        elif [[ "$total_conn" -gt 0 ]]; then
            status="ACTIVO"
        fi

        json_entries+=("{\"username\":\"$user\",\"ssh\":$ssh_count,\"dropbear\":$dropbear_count,\"total\":$total_conn,\"limit\":$limit,\"traffic_bytes\":$u_traffic,\"traffic_formatted\":\"$u_traffic_fmt\",\"expiration\":\"$exp_date\",\"expired\":$( [[ "$is_exp" == "SI" ]] && echo "true" || echo "false" ),\"status\":\"$status\"}")
    done
    
    joined=$(IFS=,; echo "${json_entries[*]}")
    srv_traffic=$(get_server_total_traffic_bytes)
    srv_traffic_fmt=$(format_bytes "$srv_traffic")
    echo "{\"total_managed\":$TOTAL_MANAGED,\"timestamp\":\"$(date -Iseconds)\",\"server_traffic_bytes\":$srv_traffic,\"server_traffic_formatted\":\"$srv_traffic_fmt\",\"users\":[$joined]}"
    exit 0
fi

# ------------------------------------------------------------------------------
# Encabezado visual de la tabla
# ------------------------------------------------------------------------------
echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}${C_WHITE}    VPS-SSH-LIMITER :: MONITOR DE CONEXIONES Y CONSUMO DE DATOS     ${C_RESET}${C_GRAY}($(date '+%H:%M:%S'))${C_RESET} ${C_CYAN}║${C_RESET}"
echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════════════════════╝${C_RESET}"

if [[ $TOTAL_MANAGED -eq 0 ]]; then
    echo -e "${C_YELLOW}⚠ No se encontraron usuarios túnel configurados en el sistema.${C_RESET}"
    echo -e "Cree usuarios con: ${C_BOLD}${C_GREEN}ssh-useradd <usuario> <contraseña> <días> <límite>${C_RESET}\n"
    exit 0
fi

printf " ${C_BOLD}%-16s %-5s %-9s %-6s %-7s %-12s %-12s %-20s${C_RESET}\n" \
    "USUARIO" "SSH" "DROPBEAR" "TOTAL" "CUOTA" "DATOS USADOS" "EXPIRACIÓN" "ESTADO"
echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"

ONLINE_USERS=0
TOTAL_SSH_CONN=0
TOTAL_DROPBEAR_CONN=0
TOTAL_ALL_CONN=0

for entry in "${USERS_LIST[@]}"; do
    user="${entry%%:*}"
    limit="${entry##*:}"

    read -r ssh_count dropbear_count < <(count_user_connections "$user")
    IFS='|' read -r exp_date is_exp < <(check_user_expiration "$user")
    total_conn=$((ssh_count + dropbear_count))
    u_bytes=$(get_user_traffic_bytes "$user")
    u_traffic_str=$(format_bytes "$u_bytes")

    TOTAL_SSH_CONN=$((TOTAL_SSH_CONN + ssh_count))
    TOTAL_DROPBEAR_CONN=$((TOTAL_DROPBEAR_CONN + dropbear_count))
    TOTAL_ALL_CONN=$((TOTAL_ALL_CONN + total_conn))

    if [[ "$total_conn" -gt 0 ]]; then
        ONLINE_USERS=$((ONLINE_USERS + 1))
    fi

    # Determinar estado, icono y color
    user_color="${C_WHITE}"
    quota_str="${total_conn}/${limit}"
    if [[ "$is_exp" == "SI" ]]; then
        status_label="${C_RED}⏰ EXPIRADO${C_RESET}"
        user_color="${C_RED}"
    elif [[ "$total_conn" -gt "$limit" ]]; then
        status_label="${C_RED}${C_BOLD}🚫 EXCEDIDO (${total_conn}/${limit})${C_RESET}"
        user_color="${C_RED}"
    elif [[ "$total_conn" -eq "$limit" && "$total_conn" -gt 0 ]]; then
        status_label="${C_YELLOW}⚠️  AL LÍMITE (${total_conn}/${limit})${C_RESET}"
        user_color="${C_YELLOW}"
    elif [[ "$total_conn" -gt 0 ]]; then
        status_label="${C_GREEN}● ONLINE (${total_conn}/${limit})${C_RESET}"
        user_color="${C_GREEN}"
    else
        status_label="${C_GRAY}○ Desconectado${C_RESET}"
        user_color="${C_WHITE}"
    fi

    printf " ${user_color}%-16s${C_RESET} %-5d %-9d %-6d %-7s %-12s %-12s %b\n" \
        "$user" \
        "$ssh_count" \
        "$dropbear_count" \
        "$total_conn" \
        "$quota_str" \
        "$u_traffic_str" \
        "$exp_date" \
        "$status_label"
done

srv_total_bytes=$(get_server_total_traffic_bytes)
srv_total_str=$(format_bytes "$srv_total_bytes")

echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"
printf " ${C_BOLD}%-13s${C_RESET} ${C_CYAN}%d${C_RESET} | ${C_BOLD}Online:${C_RESET} ${C_GREEN}%d${C_RESET} | ${C_BOLD}Conexiones:${C_RESET} ${C_YELLOW}%d${C_RESET} | ${C_BOLD}Tráfico Total Servidor:${C_RESET} ${C_BOLD}${C_GREEN}%s${C_RESET}\n" \
    "Registrados:" "$TOTAL_MANAGED" "$ONLINE_USERS" "$TOTAL_ALL_CONN" "$srv_total_str"
echo -e "${C_CYAN}══════════════════════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

exit 0
