#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-domain
# Gestor y creador de dominios y subdominios para el host VPS.
# Incluye Asistente Guiado Mediado Paso a Paso con Opciones 100% Gratuitas ($0.00):
# - Dominio Instantáneo 1-Click (sslip.io - Cero registro, cero cuentas)
# - DuckDNS Dinámico (*.duckdns.org - Gratuito con auto-renovación)
# - Cloudflare API (Plan Gratuito $0 - Detección automática de zonas)
# ==============================================================================
set -euo pipefail

DOMAIN_FILE="/etc/vps-ssh-limiter/domain"
CONFIG_DIR="/etc/vps-ssh-limiter"
CF_CONF_FILE="/etc/vps-ssh-limiter/cloudflare.conf"
DUCK_CONF_FILE="/etc/vps-ssh-limiter/duckdns.conf"

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_BOLD=""
    C_GRAY=""
    C_MAGENTA=""
    C_WHITE=""
fi

get_public_ip() {
    local ip
    ip=$(curl -s4 -m 2 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 2 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "")
    echo "$ip"
}

get_current_domain() {
    if [[ -f "$DOMAIN_FILE" && -s "$DOMAIN_FILE" ]]; then
        tr -d '[:space:]' < "$DOMAIN_FILE"
    else
        echo ""
    fi
}

press_enter() {
    echo -e "\n${C_GRAY}Presione ${C_BOLD}[Enter]${C_RESET}${C_GRAY} para continuar...${C_RESET}"
    read -r _
}

save_domain() {
    local dom="$1"
    mkdir -p "$CONFIG_DIR"
    echo "$dom" > "$DOMAIN_FILE"
    echo -e "${C_GREEN}✔ Dominio guardado exitosamente:${C_RESET} ${C_BOLD}${dom}${C_RESET}"
    
    # Actualizar hostname del sistema opcionalmente
    if command -v hostnamectl >/dev/null 2>&1; then
        hostnamectl set-hostname "$dom" 2>/dev/null || true
    fi
}

# ------------------------------------------------------------------------------
# Ficha de Conexión Automática para HTTP Custom
# ------------------------------------------------------------------------------
show_httpcustom_card() {
    local target_dom="$1"
    local vps_ip="$2"
    local mode="${3:-direct}"

    # Detectar usuario túnel de muestra de la VPS
    local sample_user="tu_usuario"
    local sample_pass="tu_contraseña"
    if [[ -f "/etc/vps-ssh-limiter/users.db" ]]; then
        local first_line
        first_line=$(head -n1 "/etc/vps-ssh-limiter/users.db" 2>/dev/null || true)
        if [[ -n "$first_line" ]]; then
            sample_user=$(echo "$first_line" | cut -d: -f1)
            sample_pass=$(echo "$first_line" | cut -d: -f2)
        fi
    fi

    echo -e "\n${C_GREEN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_GREEN}║                 DATOS LISTOS PARA COPIAR EN HTTP CUSTOM                      ║${C_RESET}"
    echo -e "${C_GREEN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e "  • ${C_BOLD}Server / Host SSH:${C_RESET}  ${C_CYAN}${C_BOLD}${target_dom}:80${C_RESET}"
    echo -e "  • ${C_BOLD}Puerto:${C_RESET}             ${C_YELLOW}80${C_RESET} (Servicio WebSocket ssh-wsproxy -> Dropbear:143)"
    echo -e "  • ${C_BOLD}Usuario Túnel:${C_RESET}      ${C_WHITE}${sample_user}${C_RESET}"
    echo -e "  • ${C_BOLD}Contraseña:${C_RESET}         ${C_WHITE}${sample_pass}${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}Payload recomendado listo para copiar y pegar en HTTP Custom:${C_RESET}"
    if [[ "$mode" == "cloudflare" ]]; then
        echo -e "  ${C_CYAN}GET / HTTP/1.3[crlf]Host: rexo.personal.com.ar[crlf][crlf][crlf][split][crlf][split]GETT / HTTP/1.1[crlf]Host: ${target_dom}[crlf]Connection: Keep-Alive[crlf]Upgrade: websocket[crlf][crlf]${C_RESET}"
    else
        echo -e "  ${C_CYAN}GET / HTTP/1.1[crlf]Host: rexo.personal.com.ar[crlf]Upgrade: websocket[crlf]Connection: Keep-Alive[crlf][crlf]${C_RESET}"
    fi
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_YELLOW}★ Instrucciones de conexión en la app HTTP Custom de tu teléfono:${C_RESET}"
    echo -e "    1. Abre HTTP Custom y activa las casillas ${C_BOLD}'Payload'${C_RESET} y ${C_BOLD}'Auto Ping'${C_RESET}."
    echo -e "    2. En el recuadro superior pega el ${C_BOLD}Payload${C_RESET} de arriba."
    echo -e "    3. En el campo Server pon: ${C_CYAN}${target_dom}:80@${sample_user}:${sample_pass}${C_RESET}"
    echo -e "    4. Pulsa ${C_GREEN}${C_BOLD}[CONNECT]${C_RESET}. ¡Conexión 100% gratuita establecida!"
    echo -e "${C_GREEN}══════════════════════════════════════════════════════════════════════════════${C_RESET}"
}

# ------------------------------------------------------------------------------
# Funciones Auxiliares de JSON para Cloudflare API (Python 3)
# ------------------------------------------------------------------------------
cf_parse_zones_py() {
    python3 -c '
import sys, json

try:
    data = json.load(sys.stdin)
except Exception as ex:
    print("ERROR:JSON_INVALID:" + str(ex))
    sys.exit(0)

if not data.get("success"):
    errs = data.get("errors", [])
    msg = "; ".join(e.get("message", "") for e in errs) if errs else "Fallo de autenticacion"
    print("ERROR:" + msg)
    sys.exit(0)

zones = data.get("result", [])
if not zones:
    print("EMPTY")
    sys.exit(0)

for z in zones:
    name = str(z.get("name", "")).strip()
    zid = str(z.get("id", "")).strip()
    status = str(z.get("status", "active")).strip()
    if name and zid:
        print(name + "|" + zid + "|" + status)
'
}

cf_get_rec_id_py() {
    python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    recs = data.get("result", [])
    if recs:
        print(recs[0].get("id", ""))
except Exception:
    pass
'
}

cf_print_errors_py() {
    python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    for e in data.get("errors", []):
        print(f" - [{e.get(\"code\", \"?\")}] {e.get(\"message\", \"\")}")
except Exception:
    pass
'
}

# ------------------------------------------------------------------------------
# Carga y Autenticación de Cloudflare (Guarda credenciales en servidor)
# ------------------------------------------------------------------------------
load_cf_credentials() {
    cf_auth_type=""
    cf_email=""
    cf_key=""
    cf_token=""

    if [[ -f "$CF_CONF_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CF_CONF_FILE" 2>/dev/null || true
        if [[ -n "${CF_AUTH_TYPE:-}" ]]; then
            echo -e "${C_GREEN}✔ Se encontraron credenciales guardadas de Cloudflare en este servidor.${C_RESET}"
            if [[ "$CF_AUTH_TYPE" == "token" && -n "${CF_TOKEN:-}" ]]; then
                local masked_tok="••••••••••••${CF_TOKEN: -4}"
                echo -e "  Método: ${C_BOLD}API Token${C_RESET} (${masked_tok})"
            elif [[ "$CF_AUTH_TYPE" == "key" && -n "${CF_KEY:-}" ]]; then
                local masked_key="••••••••••••${CF_KEY: -4}"
                echo -e "  Método: ${C_BOLD}Global API Key${C_RESET} (Email: ${CF_EMAIL:-?} | Key: ${masked_key})"
            fi
            
            local use_saved=""
            read -r -p "¿Deseas utilizar estas credenciales guardadas? [S/n]: " use_saved || true
            if [[ ! "${use_saved:-}" =~ ^[nN]$ ]]; then
                cf_auth_type="$CF_AUTH_TYPE"
                cf_email="${CF_EMAIL:-}"
                cf_key="${CF_KEY:-}"
                cf_token="${CF_TOKEN:-}"
                return 0
            fi
        fi
    fi

    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║             AUTENTICACIÓN EN CLOUDFLARE API                      ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
    echo -e "${C_YELLOW}¿Dónde obtener tus credenciales gratuitas de Cloudflare?${C_RESET}"
    echo -e " 1. Ingresa a tu panel en: ${C_CYAN}https://dash.cloudflare.com${C_RESET}"
    echo -e " 2. Arriba a la derecha haz clic en tu perfil > ${C_BOLD}'My Profile' (Mi Perfil)${C_RESET}"
    echo -e " 3. En la columna izquierda entra a ${C_BOLD}'API Tokens'${C_RESET}"
    echo -e " 4. Métodos disponibles:"
    echo -e "    ${C_GREEN}● [1] Global API Key (MÁS RECOMENDADO / Sin fallos de permisos):${C_RESET}"
    echo -e "      En 'Global API Key', clic en 'View' e ingresa tu contraseña."
    echo -e "    ${C_GREEN}● [2] API Token:${C_RESET}"
    echo -e "      'Create Token' > plantilla 'Edit zone DNS' > Zona: 'All zones'."
    echo -e "      ${C_GRAY}(Nota: Asegúrate de haber agregado tu dominio primero con el botón '+ Add a site')${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}\n"

    echo -e "Selecciona el método de autenticación:"
    echo -e "  ${C_YELLOW}[1]${C_RESET} Global API Key + Correo electrónico (Recomendado sin límites)"
    echo -e "  ${C_YELLOW}[2]${C_RESET} API Token de Cloudflare (Permiso Zone:DNS:Edit)"
    echo -e "  ${C_RED}[0]${C_RESET} Cancelar"
    local opt_auth=""
    read -r -p "Opción [0-2]: " opt_auth || true

    case "${opt_auth:-}" in
        1)
            cf_auth_type="key"
            read -r -p "Correo de tu cuenta Cloudflare: " cf_email || true
            read -r -p "Global API Key de Cloudflare: " cf_key || true
            cf_email=$(echo "$cf_email" | tr -d '[:space:]')
            cf_key=$(echo "$cf_key" | tr -d '[:space:]')
            if [[ -z "$cf_email" || -z "$cf_key" ]]; then
                echo -e "${C_YELLOW}Credenciales incompletas. Operación cancelada.${C_RESET}"
                return 1
            fi
            ;;
        2)
            cf_auth_type="token"
            read -r -p "Introduce tu Cloudflare API Token: " cf_token || true
            cf_token=$(echo "$cf_token" | tr -d '[:space:]')
            if [[ -z "$cf_token" ]]; then
                echo -e "${C_YELLOW}Token vacío. Operación cancelada.${C_RESET}"
                return 1
            fi
            ;;
        *)
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
            return 1
            ;;
    esac

    # Preguntar si guardar credenciales
    local save_ans=""
    read -r -p "¿Deseas guardar estas credenciales en el servidor para futuros subdominios? [S/n]: " save_ans || true
    if [[ ! "${save_ans:-}" =~ ^[nN]$ ]]; then
        mkdir -p "$CONFIG_DIR"
        cat > "$CF_CONF_FILE" <<EOF
CF_AUTH_TYPE="${cf_auth_type}"
CF_EMAIL="${cf_email}"
CF_KEY="${cf_key}"
CF_TOKEN="${cf_token}"
EOF
        chmod 600 "$CF_CONF_FILE"
        echo -e "${C_GREEN}✔ Credenciales guardadas con permisos restringidos (chmod 600).${C_RESET}"
    fi
    return 0
}

# ------------------------------------------------------------------------------
# ASISTENTE MEDIADO Y GUIADO PASO A PASO (100% GRATUITO)
# ------------------------------------------------------------------------------
wizard_step_instant() {
    local vps_ip="$1"
    clear
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║     ★ PASO A PASO: DOMINIO INSTANTÁNEO 1-CLICK (100% GRATUITO) ★             ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_BOLD}${C_YELLOW}Paso 1 de 3: ¿Por qué este método es 100% gratuito y no requiere nada?${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  El servicio global ${C_CYAN}sslip.io${C_RESET} proporciona resolución DNS automática en todo el"
    echo -e "  mundo sin que tengas que registrarte, ni ingresar tarjetas, ni crear contraseñas."
    echo -e "  Convierte tu IP pública en un dominio FQDN internacional válido de forma inmediata.\n"

    local ip_dash="${vps_ip//./-}"
    local generated_dom="vps-${ip_dash}.sslip.io"

    echo -e "${C_BOLD}${C_YELLOW}Paso 2 de 3: Generación y Verificación del Dominio${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  • IP pública de tu VPS: ${C_YELLOW}${C_BOLD}${vps_ip}${C_RESET}"
    echo -e "  • Dominio asignado:     ${C_GREEN}${C_BOLD}${generated_dom}${C_RESET}\n"

    local conf_use=""
    read -r -p "¿Deseas aplicar este dominio gratuito a tu VPS ahora mismo? [S/n]: " conf_use || true
    if [[ "${conf_use:-}" =~ ^[nN]$ ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        press_enter
        return 0
    fi

    echo -e "\n${C_CYAN}Verificando la resolución DNS en tiempo real...${C_RESET}"
    local test_ip=""
    test_ip=$(ping -c 1 -W 2 "$generated_dom" 2>/dev/null | grep -oP '\(\K[0-9.]+(?=\))' | head -n1 || \
              getent ahosts "$generated_dom" 2>/dev/null | awk '{print $1}' | head -n1 || echo "")

    if [[ "$test_ip" == "$vps_ip" ]]; then
        echo -e "${C_GREEN}✔ Resolución verificada exitosamente: ${generated_dom} -> ${vps_ip}${C_RESET}"
    else
        echo -e "${C_YELLOW}[AVISO] Resolución pendiente de propagación local, pero el dominio está activo.${C_RESET}"
    fi

    save_domain "$generated_dom"

    echo -e "\n${C_BOLD}${C_YELLOW}Paso 3 de 3: Configuración Automática para HTTP Custom${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "¡Tu dominio gratuito ya está activo y vinculado a tu VPS!"
    show_httpcustom_card "$generated_dom" "$vps_ip" "direct"
    press_enter
}

wizard_step_duckdns() {
    local vps_ip="$1"
    clear
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║     ★ PASO A PASO: SUBDOMINIO DUCKDNS GRATUITO (*.duckdns.org) ★             ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_BOLD}${C_YELLOW}Paso 1 de 4: Obtener tu Token Gratuito de DuckDNS${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  1. En tu celular o PC, entra en: ${C_CYAN}https://www.duckdns.org${C_RESET}"
    echo -e "  2. Haz clic en ${C_BOLD}'Sign in with Google'${C_RESET} e inicia sesión con tu Gmail (${C_GREEN}100% gratis${C_RESET})."
    echo -e "  3. En la parte superior de la página verás un recuadro con tu ${C_BOLD}'token'${C_RESET} privado."
    echo -e "     ${C_GRAY}(Es una serie de letras y números como: a1b2c3d4-e5f6-7890-...)${C_RESET}\n"

    local duck_token="" duck_sub=""
    if [[ -f "$DUCK_CONF_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$DUCK_CONF_FILE" 2>/dev/null || true
        if [[ -n "${DUCK_TOKEN:-}" && -n "${DUCK_SUB:-}" ]]; then
            local masked="••••••••••••${DUCK_TOKEN: -4}"
            echo -e "${C_GREEN}✔ Se encontraron datos guardados de DuckDNS: ${C_BOLD}${DUCK_SUB}.duckdns.org${C_RESET} (${masked})"
            local use_s=""
            read -r -p "¿Deseas utilizar estos mismos datos guardados? [S/n]: " use_s || true
            if [[ ! "${use_s:-}" =~ ^[nN]$ ]]; then
                duck_token="$DUCK_TOKEN"
                duck_sub="$DUCK_SUB"
            fi
        fi
    fi

    if [[ -z "$duck_token" ]]; then
        read -r -p "Pega aquí tu Token de DuckDNS: " duck_token || true
        duck_token=$(echo "$duck_token" | tr -d '[:space:]')
        if [[ -z "$duck_token" ]]; then
            echo -e "${C_YELLOW}Token no ingresado. Operación cancelada.${C_RESET}"
            press_enter
            return 0
        fi
    fi

    echo -e "\n${C_BOLD}${C_YELLOW}Paso 2 de 4: Elegir tu subdominio gratuito${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  En la misma página de DuckDNS, en la sección ${C_BOLD}'domains'${C_RESET}:"
    echo -e "  1. Escribe el nombre que quieras para tu VPS (ej: ${C_CYAN}miservidor${C_RESET})."
    echo -e "  2. Haz clic en el botón verde ${C_BOLD}'add domain'${C_RESET}."
    echo -e "  3. Escribe ese mismo nombre a continuación.\n"

    if [[ -z "$duck_sub" ]]; then
        read -r -p "Nombre del subdominio (solo el nombre, sin .duckdns.org): " duck_sub || true
        duck_sub=$(echo "$duck_sub" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
        if [[ -z "$duck_sub" ]]; then
            echo -e "${C_YELLOW}Nombre no ingresado. Operación cancelada.${C_RESET}"
            press_enter
            return 0
        fi
    fi

    local full_dom="${duck_sub}.duckdns.org"

    echo -e "\n${C_BOLD}${C_YELLOW}Paso 3 de 4: Vinculación y Auto-renovación${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "Conectando con DuckDNS para apuntar ${C_BOLD}${full_dom}${C_RESET} -> ${C_YELLOW}${vps_ip}${C_RESET}..."

    local duck_res
    duck_res=$(curl -s -m 8 "https://www.duckdns.org/update?domains=${duck_sub}&token=${duck_token}&ip=${vps_ip}" || true)

    if [[ "$duck_res" == "OK" ]]; then
        echo -e "${C_GREEN}${C_BOLD}✔ ¡DuckDNS vinculado exitosamente!${C_RESET}"

        # Guardar en archivo de configuración con permisos 600
        mkdir -p "$CONFIG_DIR"
        cat > "$DUCK_CONF_FILE" <<EOF
DUCK_SUB="${duck_sub}"
DUCK_TOKEN="${duck_token}"
EOF
        chmod 600 "$DUCK_CONF_FILE"

        # Configurar cron job para mantener la IP actualizada automáticamente cada 4 horas
        local cron_script="/etc/vps-ssh-limiter/duckdns_update.sh"
        cat > "$cron_script" <<EOF
#!/usr/bin/env bash
curl -s "https://www.duckdns.org/update?domains=${duck_sub}&token=${duck_token}&ip=" >/dev/null 2>&1
EOF
        chmod 700 "$cron_script"

        if command -v crontab >/dev/null 2>&1; then
            ( crontab -l 2>/dev/null | grep -v "$cron_script" ; echo "0 */4 * * * $cron_script >/dev/null 2>&1" ) | crontab - 2>/dev/null || true
            echo -e "${C_GREEN}✔ Renovación automática programada (la IP nunca vencerá).${C_RESET}"
        fi

        save_domain "$full_dom"

        echo -e "\n${C_BOLD}${C_YELLOW}Paso 4 de 4: Configuración para HTTP Custom${C_RESET}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
        show_httpcustom_card "$full_dom" "$vps_ip" "direct"
    else
        echo -e "${C_RED}[ERROR] DuckDNS respondió con error: '$duck_res'.${C_RESET}"
        echo -e "${C_YELLOW}Verifica que el token y el nombre coincidan con lo que ves en duckdns.org.${C_RESET}"
    fi
    press_enter
}

