# ------------------------------------------------------------------------------
setup_instant_domain() {
    local vps_ip
    vps_ip=$(get_public_ip)
    wizard_step_instant "$vps_ip"
}

# ------------------------------------------------------------------------------
# 4. Asignar Dominio Propio Manualmente
# ------------------------------------------------------------------------------
setup_manual_domain() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║             ASIGNAR DOMINIO PROPIO MANUALMENTE                  ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Utiliza esta opción si ya tienes tu dominio y creaste el registro"
    echo -e "tipo 'A' apuntando a la IP de tu VPS en tu registrador o panel DNS.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    echo -e "IP de tu VPS: ${C_GREEN}${vps_ip}${C_RESET}\n"

    local man_domain=""
    read -r -p "Introduce tu dominio o subdominio (ej: vps.midominio.com): " man_domain || true
    man_domain=$(echo "$man_domain" | tr -d '[:space:]')

    if [[ -z "$man_domain" ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        press_enter
        return 0
    fi

    echo -e "\n${C_CYAN}Comprobando si '${man_domain}' resuelve hacia ${vps_ip}...${C_RESET}"
    local resolved_ip=""
    resolved_ip=$(getent ahosts "$man_domain" 2>/dev/null | awk '{print $1}' | head -n1 || \
                  ping -c 1 -W 2 "$man_domain" 2>/dev/null | grep -oP '\(\K[0-9.]+(?=\))' | head -n1 || echo "")

    if [[ "$resolved_ip" == "$vps_ip" ]]; then
        echo -e "${C_GREEN}✔ ¡Verificación exitosa! El dominio ya apunta a este servidor.${C_RESET}"
        save_domain "$man_domain"
        show_httpcustom_card "$man_domain" "$vps_ip" "direct"
    else
        echo -e "${C_YELLOW}[AVISO] El dominio resuelve a: '${resolved_ip:-Sin respuesta}' (IP VPS: ${vps_ip}).${C_RESET}"
        echo -e "¿Deseas guardarlo de todos modos? (Útil si acabas de crear el DNS y está propagando)"
        local force_save=""
        read -r -p "¿Guardar dominio de todos modos? [s/N]: " force_save || true
        if [[ "${force_save:-}" =~ ^[sS]$ ]]; then
            save_domain "$man_domain"
            show_httpcustom_card "$man_domain" "$vps_ip" "direct"
        else
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 5. Comprobación y Diagnóstico DNS Avanzado
# ------------------------------------------------------------------------------
check_dns_status() {
    clear
    local current_dom
    current_dom=$(get_current_domain)
    local vps_ip
    vps_ip=$(get_public_ip)

    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║                   ESTADO Y DIAGNÓSTICO DNS                      ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "IP pública de la VPS: ${C_YELLOW}${vps_ip}${C_RESET}"

    if [[ -z "$current_dom" ]]; then
        echo -e "Dominio configurado:  ${C_GRAY}(Ninguno - Utilizando IP directa)${C_RESET}"
    else
        echo -e "Dominio configurado:  ${C_GREEN}${C_BOLD}${current_dom}${C_RESET}"
        echo -e "\n${C_CYAN}Consultando servidores DNS globales (Google 8.8.8.8 y Cloudflare 1.1.1.1)...${C_RESET}"
        local google_dns=""
        if command -v dig >/dev/null 2>&1; then
            google_dns=$(dig +short "@8.8.8.8" "$current_dom" 2>/dev/null | tr '\n' ' ' || true)
        elif command -v nslookup >/dev/null 2>&1; then
            google_dns=$(nslookup "$current_dom" 8.8.8.8 2>/dev/null | awk '/Address:/ {print $2}' | tail -n+2 | tr '\n' ' ' || true)
        fi
        echo -e "Respuesta DNS público: ${C_BOLD}${google_dns:-Sin respuesta o consulta no disponible}${C_RESET}"

        echo -e "\n${C_CYAN}Probando resolución local en el sistema...${C_RESET}"
        local local_res=""
        local_res=$(getent ahosts "$current_dom" 2>/dev/null | awk '{print $1}' | head -n1 || echo "")
        echo -e "Resolución local:      ${C_BOLD}${local_res:-No resuelve}${C_RESET}"

        echo -e "\n${C_BOLD}Diagnóstico:${C_RESET}"
        if [[ "$google_dns" == *"104."* || "$google_dns" == *"172.67."* || "$google_dns" == *"172.64."* || "$google_dns" == *"162.159."* ]]; then
            echo -e "${C_GREEN}✔ El dominio resuelve a Cloudflare CDN (IPs Anycast de Cloudflare).${C_RESET}"
            echo -e "${C_GREEN}  El Proxy (Nube Naranja) está funcionando perfectamente para WebSocket / HTTP Custom.${C_RESET}"
        elif [[ "$local_res" == "$vps_ip" || "$google_dns" == *"$vps_ip"* ]]; then
            echo -e "${C_GREEN}✔ El dominio resuelve directamente hacia la IP pública de esta VPS (Modo DNS Directo).${C_RESET}"
        else
            echo -e "${C_YELLOW}⚠ El dominio aún no responde o apunta a otra dirección.${C_RESET}"
            echo -e "${C_GRAY}Si acabas de modificar el registro, recuerda que la propagación DNS mundial puede tardar de 2 a 15 minutos.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 6. Eliminar Dominio
# ------------------------------------------------------------------------------
delete_domain() {
    clear
    local current_dom
    current_dom=$(get_current_domain)
    if [[ -z "$current_dom" ]]; then
        echo -e "${C_YELLOW}No hay ningún dominio configurado actualmente.${C_RESET}"
    else
        echo -e "\n${C_BOLD}${C_RED}¿Está seguro de eliminar el dominio '${current_dom}'?${C_RESET}"
        echo -e "El sistema volverá a mostrar la IP pública en el menú y las fichas de usuarios."
        local conf_del=""
        read -r -p "Confirmar eliminación [s/N]: " conf_del || true
        if [[ "${conf_del:-}" =~ ^[sS]$ ]]; then
            rm -f "$DOMAIN_FILE"
            echo -e "${C_GREEN}✔ Dominio eliminado. El sistema ha vuelto a modo IP.${C_RESET}"
        else
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 7. Guía Educativa Paso a Paso
# ------------------------------------------------------------------------------
show_domain_guide() {
    clear
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║     GUÍA COMPLETA: CÓMO CREAR, CONFIGURAR Y USAR DOMINIOS EN TU VPS      ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_BOLD}${C_YELLOW}1. OPCIONES 100% GRATUITAS ($0.00) DISPONIBLES EN ESTE SCRIPT${C_RESET}"
    echo -e "──────────────────────────────────────────────────────────────────────────"
    echo -e "  • ${C_GREEN}Opción A: Dominio Instantáneo (sslip.io):${C_RESET}"
    echo -e "    - Costo: \$0.00. Cero cuentas, cero registros."
    echo -e "    - Genera al instante: vps-X-X-X-X.sslip.io."
    echo -e "    - Conecta directamente por WebSocket en puerto 80 con Bug Host."
    echo -e "  • ${C_GREEN}Opción B: DuckDNS (*.duckdns.org):${C_RESET}"
    echo -e "    - Costo: \$0.00 para siempre."
    echo -e "    - Solo necesitas entrar a duckdns.org con tu cuenta de Google."
    echo -e "    - Te da un nombre propio (ej: tunombre.duckdns.org) y el script lo renueva solo."
    echo -e "  • ${C_GREEN}Opción C: Cloudflare CDN (Plan Gratuito Free \$0):${C_RESET}"
    echo -e "    - Cloudflare no cobra nada por gestionar DNS ni por su red CDN WebSocket.\n"

    echo -e "${C_BOLD}${C_YELLOW}2. ¿CÓMO FUNCIONA LA CONEXIÓN WEBSOCKET CDN (PUERTO 80)?${C_RESET}"
    echo -e "──────────────────────────────────────────────────────────────────────────"
    echo -e "  [Tu Celular / HTTP Custom]"
    echo -e "       │"
    echo -e "       ▼ (Petición HTTP con Bug Host de la operadora)"
    echo -e "  [Red Móvil / Bug Host (ej: rexo.personal.com.ar)] -> Datos Cero / WhatsApp"
    echo -e "       │"
    echo -e "       ▼ (Payload lleva cabecera 'Host: tudominio-o-sslip')"
    echo -e "  [Tu VPS (Puerto 80: ssh-wsproxy -> Dropbear:143)] -> ¡Túnel Establecido!\n"

    echo -e "${C_BOLD}${C_YELLOW}3. NUBE NARANJA (PROXY CDN) VS NUBE GRIS (DNS DIRECTO)${C_RESET}"
    echo -e "──────────────────────────────────────────────────────────────────────────"
    echo -e "  • ${C_GREEN}Nube Naranja (Proxy: ON):${C_RESET} OBLIGATORIO si usas Payloads Split con Bug Host"
    echo -e "    para que Cloudflare rutee el tráfico hacia tu VPS en puerto 80."
    echo -e "  • ${C_GRAY}Nube Gris / Directo (sslip.io / DuckDNS):${C_RESET} Conecta directo a tu servidor."
    echo -e "    El demonio ${C_BOLD}ssh-wsproxy${C_RESET} instalado en tu VPS recibe el WebSocket directo"
    echo -e "    en el puerto 80 sin intermediarios, con menor latencia y cero costo."
    echo -e "──────────────────────────────────────────────────────────────────────────"
    press_enter
}

# ------------------------------------------------------------------------------
# 8. Administrar Credenciales Guardadas
# ------------------------------------------------------------------------------
manage_saved_credentials() {
    clear
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║            ADMINISTRAR CREDENCIALES GUARDADAS                    ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "Estado de credenciales en el servidor:"
    if [[ -f "$CF_CONF_FILE" ]]; then
        echo -e "  • Cloudflare: ${C_GREEN}Guardadas${C_RESET} (${CF_CONF_FILE})"
    else
        echo -e "  • Cloudflare: ${C_GRAY}No guardadas${C_RESET}"
    fi

    if [[ -f "$DUCK_CONF_FILE" ]]; then
        echo -e "  • DuckDNS:    ${C_GREEN}Guardadas${C_RESET} (${DUCK_CONF_FILE})"
    else
        echo -e "  • DuckDNS:    ${C_GRAY}No guardadas${C_RESET}"
    fi

    echo -e "\nOpciones disponibles:"
    echo -e "  ${C_YELLOW}[1]${C_RESET} Borrar credenciales de Cloudflare"
    echo -e "  ${C_YELLOW}[2]${C_RESET} Borrar credenciales de DuckDNS"
    echo -e "  ${C_YELLOW}[3]${C_RESET} Borrar todas las credenciales"
    echo -e "  ${C_RED}[0]${C_RESET} Volver"

    local opt_cred=""
    read -r -p "Seleccione una opción [0-3]: " opt_cred || true

    case "${opt_cred:-}" in
        1)
            rm -f "$CF_CONF_FILE"
            echo -e "${C_GREEN}✔ Credenciales de Cloudflare eliminadas.${C_RESET}"
            ;;
        2)
            rm -f "$DUCK_CONF_FILE"
            echo -e "${C_GREEN}✔ Credenciales de DuckDNS eliminadas.${C_RESET}"
            ;;
        3)
            rm -f "$CF_CONF_FILE" "$DUCK_CONF_FILE"
            echo -e "${C_GREEN}✔ Todas las credenciales han sido eliminadas.${C_RESET}"
            ;;
        0)
            return 0
            ;;
        *)
            echo -e "${C_RED}Opción inválida.${C_RESET}"
            ;;
    esac
    press_enter
}

# ------------------------------------------------------------------------------
# Bucle Principal Interactivo y Parámetros CLI
# ------------------------------------------------------------------------------
main_menu() {
    while true; do
        clear
        local active_dom
        active_dom=$(get_current_domain)
        local dom_badge="${C_GRAY}(Sin dominio - Modo IP)${C_RESET}"
        if [[ -n "$active_dom" ]]; then
            dom_badge="${C_GREEN}${C_BOLD}${active_dom}${C_RESET}"
        fi

        echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}             GESTIÓN Y CREACIÓN DE DOMINIOS / HOST             ${C_RESET}${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
        echo -e " Host activo: ${dom_badge}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}${C_YELLOW}⭐ [1] ASISTENTE GUIADO PASO A PASO (100% GRATUITO - Cero Costo)${C_RESET}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_CYAN}[2]${C_RESET} Dominio Instantáneo 1-Click (sslip.io - Cero registro)"
        echo -e "  ${C_CYAN}[3]${C_RESET} DuckDNS Personalizado (*.duckdns.org - Gratuito dinámico)"
        echo -e "  ${C_CYAN}[4]${C_RESET} Cloudflare API (Plan Gratuito \$0 - Detección automática)"
        echo -e "  ${C_YELLOW}[5]${C_RESET} Asignar / Cambiar dominio manualmente (Tu propio dominio)"
        echo -e "  ${C_YELLOW}[6]${C_RESET} Comprobar estado y diagnóstico DNS del dominio"
        echo -e "  ${C_YELLOW}[7]${C_RESET} Eliminar dominio actual y volver a IP pública"
        echo -e "  ${C_YELLOW}[8]${C_RESET} Guía educativa: ¿Cómo funcionan los dominios gratuitos?"
        echo -e "  ${C_YELLOW}[9]${C_RESET} Administrar / Borrar credenciales guardadas"
        echo -e "  ${C_RED}[0]${C_RESET} Volver al Menú Principal"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        local opt_dom=""
        read -r -p "Seleccione una opción [0-9]: " opt_dom || true

        case "${opt_dom:-}" in
            1) wizard_free_domains ;;
            2) setup_instant_domain ;;
            3) setup_duckdns ;;
            4) setup_cloudflare ;;
            5) setup_manual_domain ;;
            6) check_dns_status ;;
            7) delete_domain ;;
            8) show_domain_guide ;;
            9) manage_saved_credentials ;;
            0) break ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

case "${1:-}" in
    --wizard|-w)
        wizard_free_domains
        ;;
    --show)
        cur=$(get_current_domain)
        if [[ -n "$cur" ]]; then
            echo "$cur"
        else
            get_public_ip
        fi
        ;;
    --check)
        check_dns_status
        ;;
    --set)
        if [[ -z "${2:-}" ]]; then
            echo -e "${C_RED}Uso: ssh-domain --set <dominio>${C_RESET}"
            exit 1
        fi
        save_domain "$2"
        ;;
    --instant)
        v_ip=$(get_public_ip)
        if [[ -z "$v_ip" ]]; then
            echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública.${C_RESET}"
            exit 1
        fi
        i_dash="${v_ip//./-}"
        inst_dom="vps-${i_dash}.sslip.io"
        save_domain "$inst_dom"
        show_httpcustom_card "$inst_dom" "$v_ip" "direct"
        ;;
    --guide)
        show_domain_guide
        ;;
    --cf-clear)
        rm -f "$CF_CONF_FILE"
        echo -e "${C_GREEN}✔ Credenciales de Cloudflare eliminadas.${C_RESET}"
        ;;
    --duck-clear)
        rm -f "$DUCK_CONF_FILE"
        echo -e "${C_GREEN}✔ Credenciales de DuckDNS eliminadas.${C_RESET}"
        ;;
    --unset)
        rm -f "$DOMAIN_FILE"
        echo -e "${C_GREEN}✔ Dominio eliminado. El servidor ha vuelto a modo IP pública.${C_RESET}"
        ;;
    *)
        main_menu
        ;;
esac
