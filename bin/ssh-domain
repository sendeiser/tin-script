}

wizard_free_domains() {
    clear
    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║     ★ ASISTENTE GUIADO PASO A PASO: DOMINIOS Y HOSTS 100% GRATUITOS ★       ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${C_RESET}\n"

    echo -e "${C_WHITE}¡Bienvenido! Este asistente te acompañará paso a paso para configurar un${C_RESET}"
    echo -e "${C_WHITE}dominio o nombre de host para tu VPS ${C_BOLD}${C_GREEN}SIN GASTAR UN SOLO CENTAVO ($0.00)${C_RESET}${C_WHITE}.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    if [[ -z "$vps_ip" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública de tu servidor VPS.${C_RESET}"
        press_enter
        return 1
    fi
    echo -e "IP pública detectada de tu VPS: ${C_YELLOW}${C_BOLD}${vps_ip}${C_RESET}\n"

    echo -e "${C_BOLD}Elige la alternativa 100% gratuita que mejor se adapte a ti:${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}${C_YELLOW}[1] ★ Dominio Instantáneo 1-Click (sslip.io)${C_RESET} ${C_GREEN}◄ RECOMENDADO / MÁS FÁCIL${C_RESET}"
    echo -e "      • ${C_BOLD}Costo:${C_RESET} ${C_GREEN}\$0.00 (Totalmente gratis)${C_RESET}"
    echo -e "      • ${C_BOLD}Registro:${C_RESET} ${C_CYAN}CERO registros, cero cuentas, cero contraseñas.${C_RESET}"
    echo -e "      • ${C_BOLD}Tiempo:${C_RESET} 1 segundo. Se activa al instante."
    echo -e "      • ${C_BOLD}Ideal si:${C_RESET} Quieres conectar ya mismo a HTTP Custom sin trámites."
    echo -e ""
    echo -e "  ${C_BOLD}${C_YELLOW}[2] ★ DuckDNS Personalizado (*.duckdns.org)${C_RESET}"
    echo -e "      • ${C_BOLD}Costo:${C_RESET} ${C_GREEN}\$0.00 (Gratis para siempre)${C_RESET}"
    echo -e "      • ${C_BOLD}Registro:${C_RESET} Solo iniciar sesión con Google en duckdns.org (toma 10 seg)."
    echo -e "      • ${C_BOLD}Tiempo:${C_RESET} 1 minuto."
    echo -e "      • ${C_BOLD}Ideal si:${C_RESET} Quieres un nombre personalizado (ej: tunombre.duckdns.org)."
    echo -e "      • ${C_BOLD}Auto-renovación:${C_RESET} El script programa un cron para que nunca venza."
    echo -e ""
    echo -e "  ${C_BOLD}${C_YELLOW}[3] ★ Cloudflare API (Plan Gratuito \$0)${C_RESET}"
    echo -e "      • ${C_BOLD}Costo:${C_RESET} ${C_GREEN}\$0.00 con tu cuenta gratuita de Cloudflare.${C_RESET}"
    echo -e "      • ${C_BOLD}Ideal si:${C_RESET} Ya tienes un dominio agregado en Cloudflare."
    echo -e "      • ${C_BOLD}Detección:${C_RESET} El script detecta tu dominio automáticamente."
    echo -e ""
    echo -e "  ${C_RED}[0] Volver al menú de dominios${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────────────────${C_RESET}"

    local opt_wiz=""
    read -r -p "Selecciona una opción gratuita [0-3]: " opt_wiz || true

    case "${opt_wiz:-}" in
        1) wizard_step_instant "$vps_ip" ;;
        2) wizard_step_duckdns "$vps_ip" ;;
        3) wizard_step_cloudflare "$vps_ip" ;;
        0) return 0 ;;
        *)
            echo -e "${C_RED}Opción inválida.${C_RESET}"
            sleep 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 1. Integración Inteligente con Cloudflare API (Detección Automática de Zonas)
# ------------------------------------------------------------------------------
setup_cloudflare() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║     CREAR SUBDOMINIO CON CLOUDFLARE API (DETECCIÓN AUTOMÁTICA)   ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Crea o actualiza un registro DNS tipo A en tu cuenta gratuita de Cloudflare"
    echo -e "apuntando automáticamente a la IP pública de esta VPS.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    if [[ -z "$vps_ip" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública del servidor.${C_RESET}"
        press_enter
        return 1
    fi
    echo -e "IP pública detectada: ${C_GREEN}${C_BOLD}${vps_ip}${C_RESET}\n"

    # Cargar o pedir credenciales
    if ! load_cf_credentials; then
        press_enter
        return 0
    fi

    echo -e "\n${C_CYAN}Conectando con Cloudflare API para consultar tus dominios...${C_RESET}"

    local zones_raw=""
    if [[ "$cf_auth_type" == "token" ]]; then
        zones_raw=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones?per_page=50" \
            -H "Authorization: Bearer ${cf_token}" -H "Content-Type: application/json" || echo "")
    else
        zones_raw=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones?per_page=50" \
            -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" || echo "")
    fi

    if [[ -z "$zones_raw" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo comunicar con los servidores de Cloudflare.${C_RESET}"
        press_enter
        return 1
    fi

    local parsed_zones=""
    parsed_zones=$(echo "$zones_raw" | cf_parse_zones_py)

    local zone_names=()
    local zone_ids=()
    local zone_statuses=()
    if [[ "$parsed_zones" != ERROR:* && "$parsed_zones" != "EMPTY" && -n "$parsed_zones" ]]; then
        while IFS="|" read -r z_name z_id z_status; do
            if [[ -n "$z_name" && -n "$z_id" ]]; then
                zone_names+=("$z_name")
                zone_ids+=("$z_id")
                zone_statuses+=("${z_status:-active}")
            fi
        done <<< "$parsed_zones"
    fi

    local selected_name=""
    local selected_id=""

    # Si no se encontraron zonas o hubo error de permisos al listar
    if [[ "${#zone_names[@]}" -eq 0 ]]; then
        if [[ "$parsed_zones" == ERROR:* ]]; then
            local err_msg="${parsed_zones#ERROR:}"
            echo -e "\n${C_YELLOW}⚠ Aviso de Cloudflare al consultar dominios:${C_RESET} ${err_msg}"
            echo -e "${C_GRAY}(Ocurre comúnmente si tu API Token no tiene permiso de lectura de zonas 'Zone:Read')${C_RESET}\n"
        else
            echo -e "\n${C_YELLOW}⚠ No se encontró ningún dominio listado automáticamente en tu cuenta de Cloudflare.${C_RESET}"
            echo -e "${C_GRAY}(Si acabas de agregar el dominio en Cloudflare, puede estar pendiente de verificación o tu Token requiere búsqueda directa)${C_RESET}\n"
        fi

        echo -e "${C_BOLD}¿Cómo deseas continuar?${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} Buscar tu dominio por nombre directo (ej: tudominio.shop)"
        echo -e "  ${C_YELLOW}[2]${C_RESET} Ingresar Dominio y Zone ID manualmente"
        echo -e "  ${C_YELLOW}[3]${C_RESET} Cambiar a Global API Key + Correo (Recomendado sin límites de permisos)"
        echo -e "  ${C_RED}[0]${C_RESET} Cancelar"

        local opt_fallback=""
        read -r -p "Opción [0-3]: " opt_fallback || true
        case "${opt_fallback:-}" in
            1)
                local manual_dom=""
                read -r -p "Introduce el nombre del dominio en Cloudflare (ej: tudominio.shop): " manual_dom || true
                manual_dom=$(echo "$manual_dom" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
                if [[ -z "$manual_dom" ]]; then
                    echo -e "${C_RED}Dominio no ingresado.${C_RESET}"
                    press_enter
                    return 1
                fi
                echo -e "\n${C_CYAN}Buscando '${manual_dom}' en Cloudflare API...${C_RESET}"
                local single_zone_raw=""
                if [[ "$cf_auth_type" == "token" ]]; then
                    single_zone_raw=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones?name=${manual_dom}" \
                        -H "Authorization: Bearer ${cf_token}" -H "Content-Type: application/json" || echo "")
                else
                    single_zone_raw=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones?name=${manual_dom}" \
                        -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" || echo "")
                fi
                local parsed_single
                parsed_single=$(echo "$single_zone_raw" | cf_parse_zones_py)
                if [[ "$parsed_single" != ERROR:* && "$parsed_single" != "EMPTY" && -n "$parsed_single" ]]; then
                    while IFS="|" read -r z_name z_id z_status; do
                        if [[ -n "$z_name" && -n "$z_id" ]]; then
                            zone_names+=("$z_name")
                            zone_ids+=("$z_id")
                            zone_statuses+=("${z_status:-active}")
                        fi
                    done <<< "$parsed_single"
                else
                    echo -e "${C_RED}[AVISO] No se pudo obtener el Zone ID automáticamente para '${manual_dom}'.${C_RESET}"
                    echo -e "${C_YELLOW}Puedes copiar el Zone ID desde dash.cloudflare.com (en la vista de tu dominio, abajo a la derecha).${C_RESET}"
                    read -r -p "Introduce el Zone ID de Cloudflare (32 caracteres): " selected_id || true
                    selected_id=$(echo "$selected_id" | tr -d '[:space:]')
                    if [[ -n "$selected_id" ]]; then
                        selected_name="$manual_dom"
                    else
                        press_enter
                        return 1
                    fi
                fi
                ;;
            2)
                read -r -p "Nombre del dominio (ej: midominio.com): " selected_name || true
                read -r -p "Zone ID de Cloudflare (32 caracteres): " selected_id || true
                selected_name=$(echo "$selected_name" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
                selected_id=$(echo "$selected_id" | tr -d '[:space:]')
                if [[ -z "$selected_name" || -z "$selected_id" ]]; then
                    echo -e "${C_RED}Datos incompletos.${C_RESET}"
                    press_enter
                    return 1
                fi
                ;;
            3)
                rm -f "$CF_CONF_FILE" 2>/dev/null || true
                setup_cloudflare
                return $?
                ;;
            *)
                echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                return 0
                ;;
        esac
    fi

    local total_zones="${#zone_names[@]}"
    if [[ -z "$selected_name" || -z "$selected_id" ]]; then
        if [[ "$total_zones" -eq 1 ]]; then
            selected_name="${zone_names[0]}"
            selected_id="${zone_ids[0]}"
            local stat_label="${C_GREEN}(Estado: Activo)${C_RESET}"
            if [[ "${zone_statuses[0]}" == "pending" ]]; then
                stat_label="${C_YELLOW}(Estado: Pendiente de Nameservers)${C_RESET}"
            fi
            echo -e "\n${C_GREEN}✔ Dominio detectado en tu cuenta:${C_RESET} ${C_BOLD}${C_CYAN}${selected_name}${C_RESET} ${stat_label}"
            local use_detected=""
            read -r -p "¿Deseas utilizar este dominio? [S/n]: " use_detected || true
            if [[ "${use_detected:-}" =~ ^[nN]$ ]]; then
                read -r -p "Introduce el nombre del dominio manualmente: " selected_name || true
                read -r -p "Introduce el Zone ID de Cloudflare: " selected_id || true
            fi
        elif [[ "$total_zones" -gt 1 ]]; then
            echo -e "\n${C_CYAN}Dominios encontrados en tu cuenta de Cloudflare:${C_RESET}"
            for i in "${!zone_names[@]}"; do
                local idx=$((i + 1))
                local stat_label="${C_GREEN}[Activo]${C_RESET}"
                if [[ "${zone_statuses[$i]}" == "pending" ]]; then
                    stat_label="${C_YELLOW}[Pendiente de Nameservers]${C_RESET}"
                fi
                echo -e "  ${C_YELLOW}[${idx}]${C_RESET} ${C_BOLD}${zone_names[$i]}${C_RESET} ${stat_label}"
            done
            echo -e "  ${C_YELLOW}[M]${C_RESET} Ingresar otro dominio y Zone ID manualmente"
            echo -e "  ${C_RED}[0]${C_RESET} Cancelar"

            local sel_idx=""
            read -r -p "Selecciona un dominio [1-${total_zones}]: " sel_idx || true
            if [[ "$sel_idx" == "0" ]]; then
                echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                return 0
            elif [[ "$sel_idx" =~ ^[mM]$ ]]; then
                read -r -p "Nombre del dominio (ej: midominio.com): " selected_name || true
                read -r -p "Zone ID de Cloudflare: " selected_id || true
            elif [[ "$sel_idx" =~ ^[0-9]+$ ]] && (( sel_idx >= 1 && sel_idx <= total_zones )); then
                local arr_idx=$((sel_idx - 1))
                selected_name="${zone_names[$arr_idx]}"
                selected_id="${zone_ids[$arr_idx]}"
            else
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                press_enter
                return 1
            fi
        fi
    fi

    selected_name=$(echo "$selected_name" | tr -d '[:space:]')
    selected_id=$(echo "$selected_id" | tr -d '[:space:]')

    if [[ -z "$selected_name" || -z "$selected_id" ]]; then
        echo -e "${C_RED}[ERROR] Dominio o Zone ID inválido.${C_RESET}"
        press_enter
        return 1
    fi

    # Paso 2: Elegir subdominio
    echo -e "\n${C_BOLD}Paso 2: Elegir subdominio para la VPS${C_RESET}"
    echo -e "${C_GRAY}Ejemplo: Si ingresas 'vps1', el host final será: vps1.${selected_name}${C_RESET}"
    local sub_prefix=""
    read -r -p "Introduce el prefijo del subdominio [Por defecto: vps1]: " sub_prefix || true
    sub_prefix="${sub_prefix:-vps1}"
    sub_prefix=$(echo "$sub_prefix" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    local full_domain="${sub_prefix}.${selected_name}"

    echo -e "Host resultante: ${C_BOLD}${C_GREEN}${full_domain}${C_RESET}"

    # Paso 3: Configurar Proxy de Cloudflare (Nube Naranja CDN vs Nube Gris)
    echo -e "\n${C_BOLD}Paso 3: Configurar Proxy de Cloudflare (CDN / Nube Naranja)${C_RESET}"
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_GREEN}● PROXY ACTIVADO (Nube Naranja / Recomendado por defecto):${C_RESET}"
    echo -e "    El tráfico pasa a través de los servidores CDN de Cloudflare."
    echo -e "    ${C_YELLOW}OBLIGATORIO${C_RESET} si vas a conectar por ${C_BOLD}HTTP Custom (WebSocket en puerto 80)${C_RESET}"
    echo -e "    utilizando Bug Host de operadoras (ej: rexo.personal.com.ar)."
    echo -e "  ${C_GRAY}○ PROXY DESACTIVADO (Nube Gris / DNS Directo):${C_RESET}"
    echo -e "    Tu dominio apunta directamente a la IP de la VPS sin pasar por CDN."
    echo -e "    Útil únicamente para conexiones SSH directas (puerto 22) o BadVPN."
    echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
    local proxy_ans=""
    read -r -p "¿Activar Proxy CDN de Cloudflare (Nube Naranja)? [S/n]: " proxy_ans || true
    local proxied="true"
    if [[ "${proxy_ans:-}" =~ ^[nN]$ ]]; then
        proxied="false"
    fi

    # Paso 4: Crear o actualizar registro DNS
    echo -e "\n${C_CYAN}Verificando si el registro '${full_domain}' ya existe en Cloudflare...${C_RESET}"
    local rec_check=""
    if [[ "$cf_auth_type" == "token" ]]; then
        rec_check=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records?name=${full_domain}&type=A" \
            -H "Authorization: Bearer ${cf_token}" -H "Content-Type: application/json" || echo "")
    else
        rec_check=$(curl -s -m 12 -X GET "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records?name=${full_domain}&type=A" \
            -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" || echo "")
    fi

    local rec_id=""
    rec_id=$(echo "$rec_check" | cf_get_rec_id_py || echo "")

    local create_res=""
    if [[ -n "$rec_id" ]]; then
        echo -e "${C_YELLOW}[AVISO] El registro DNS ya existe (ID: ${rec_id}). Actualizando a IP ${vps_ip} (Proxy: ${proxied})...${C_RESET}"
        local update_payload="{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}"
        if [[ "$cf_auth_type" == "token" ]]; then
            create_res=$(curl -s -m 12 -X PUT "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records/${rec_id}" \
                -H "Authorization: Bearer ${cf_token}" -H "Content-Type: application/json" \
                --data "$update_payload" || echo "")
        else
            create_res=$(curl -s -m 12 -X PUT "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records/${rec_id}" \
                -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" \
                --data "$update_payload" || echo "")
        fi
    else
        echo -e "${C_CYAN}Creando nuevo registro DNS tipo A en Cloudflare...${C_RESET}"
        local create_payload="{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}"
        if [[ "$cf_auth_type" == "token" ]]; then
            create_res=$(curl -s -m 12 -X POST "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records" \
                -H "Authorization: Bearer ${cf_token}" -H "Content-Type: application/json" \
                --data "$create_payload" || echo "")
        else
            create_res=$(curl -s -m 12 -X POST "https://api.cloudflare.com/client/v4/zones/${selected_id}/dns_records" \
                -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" \
                --data "$create_payload" || echo "")
        fi
    fi

    if echo "$create_res" | grep -q '"success":true'; then
        echo -e "\n${C_GREEN}${C_BOLD}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
        echo -e "${C_GREEN}${C_BOLD}║      ✔ ¡SUBDOMINIO CONFIGURADO EXITOSAMENTE EN CLOUDFLARE!       ║${C_RESET}"
        echo -e "${C_GREEN}${C_BOLD}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
        echo -e "  • Dominio / Host:   ${C_CYAN}${C_BOLD}${full_domain}${C_RESET}"
        echo -e "  • IP Destino (VPS): ${C_YELLOW}${vps_ip}${C_RESET}"
        local proxy_desc="${C_GREEN}ACTIVADO (Nube Naranja - Cloudflare CDN WebSocket)${C_RESET}"
        if [[ "$proxied" != "true" ]]; then
            proxy_desc="${C_YELLOW}DESACTIVADO (Nube Gris - DNS Directo a VPS)${C_RESET}"
        fi
        echo -e "  • Estado Proxy:     ${proxy_desc}\n"

        save_domain "$full_domain"

        if [[ "$proxied" == "true" ]]; then
            show_httpcustom_card "$full_domain" "$vps_ip" "cloudflare"
        else
            show_httpcustom_card "$full_domain" "$vps_ip" "direct"
        fi
    else
        echo -e "\n${C_RED}[ERROR] Cloudflare rechazó la solicitud:${C_RESET}"
        echo "$create_res" | cf_print_errors_py || echo "$create_res"
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 2. Dominio Dinámico Gratuito con DuckDNS
# ------------------------------------------------------------------------------
setup_duckdns() {
    local vps_ip
    vps_ip=$(get_public_ip)
    wizard_step_duckdns "$vps_ip"
}

