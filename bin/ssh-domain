#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/ssh-domain
# Gestor y creador de dominios y subdominios para el host VPS.
# Inspirado en Darnyx Script y VPS-MX:
# Soporta Cloudflare API, DuckDNS (Dinámico), Dominios Gratuitos Instantáneos
# (sslip.io / nip.io) y vinculación manual de dominios personalizados.
# ==============================================================================
set -euo pipefail

DOMAIN_FILE="/etc/vps-ssh-limiter/domain"
CONFIG_DIR="/etc/vps-ssh-limiter"

if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
    C_MAGENTA="\033[1;35m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_BOLD=""
    C_GRAY=""
    C_MAGENTA=""
fi

get_public_ip() {
    local ip
    ip=$(curl -s4 -m 2 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 2 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "")
    echo "$ip"
}

get_current_domain() {
    if [[ -f "$DOMAIN_FILE" && -s "$DOMAIN_FILE" ]]; then
        tr -d '[:space:]' < "$DOMAIN_FILE"
    else
        echo ""
    fi
}

press_enter() {
    echo -e "\n${C_GRAY}Presione ${C_BOLD}[Enter]${C_RESET}${C_GRAY} para continuar...${C_RESET}"
    read -r _
}

save_domain() {
    local dom="$1"
    mkdir -p "$CONFIG_DIR"
    echo "$dom" > "$DOMAIN_FILE"
    echo -e "${C_GREEN}✔ Dominio guardado exitosamente:${C_RESET} ${C_BOLD}${dom}${C_RESET}"
    
    # Actualizar hostname opcionalmente
    if command -v hostnamectl >/dev/null 2>&1; then
        hostnamectl set-hostname "$dom" 2>/dev/null || true
    fi
}

# ------------------------------------------------------------------------------
# 1. Integración con Cloudflare API (Crea registro A en la zona del usuario)
# ------------------------------------------------------------------------------
setup_cloudflare() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║             CREAR SUBDOMINIO CON CLOUDFLARE API (A)             ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Crea automáticamente un registro DNS tipo A apuntando a la IP de tu VPS.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    if [[ -z "$vps_ip" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública del servidor.${C_RESET}"
        press_enter
        return 1
    fi
    echo -e "IP pública detectada: ${C_GREEN}${vps_ip}${C_RESET}\n"

    echo -e "Selecciona el método de autenticación en Cloudflare:"
    echo -e " [1] API Token de Cloudflare (Recomendado con permiso Zone:DNS:Edit)"
    echo -e " [2] Global API Key + Correo electrónico"
    echo -e " [0] Cancelar"
    local auth_opt=""
    read -r -p "Opción [0-2]: " auth_opt || true

    local cf_token="" cf_email="" cf_key="" auth_header=""
    case "${auth_opt:-}" in
        1)
            read -r -p "Introduce tu Cloudflare API Token: " cf_token || true
            if [[ -z "${cf_token:-}" ]]; then
                echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                press_enter
                return 0
            fi
            auth_header="Authorization: Bearer ${cf_token}"
            ;;
        2)
            read -r -p "Correo de tu cuenta Cloudflare: " cf_email || true
            read -r -p "Global API Key de Cloudflare: " cf_key || true
            if [[ -z "${cf_email:-}" || -z "${cf_key:-}" ]]; then
                echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                press_enter
                return 0
            fi
            ;;
        *)
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
            return 0
            ;;
    esac

    local root_domain=""
    read -r -p "Dominio principal registrado en Cloudflare (ej: miservidor.com): " root_domain || true
    if [[ -z "${root_domain:-}" ]]; then
        echo -e "${C_RED}[ERROR] El dominio no puede estar vacío.${C_RESET}"
        press_enter
        return 1
    fi

    local sub_prefix=""
    read -r -p "Prefijo del subdominio a crear (ej: vps1 para vps1.${root_domain}): " sub_prefix || true
    if [[ -z "${sub_prefix:-}" ]]; then
        echo -e "${C_RED}[ERROR] El prefijo no puede estar vacío.${C_RESET}"
        press_enter
        return 1
    fi

    local full_domain="${sub_prefix}.${root_domain}"

    local proxy_ans=""
    read -r -p "¿Deseas activar el Proxy de Cloudflare (CDN / Nube Naranja)? [s/N]: " proxy_ans || true
    local proxied="false"
    if [[ "${proxy_ans:-}" =~ ^[sS]$ ]]; then
        proxied="true"
    fi

    echo -e "\n${C_CYAN}Consultando Cloudflare para obtener Zone ID de '${root_domain}'...${C_RESET}"

    local zones_res=""
    if [[ -n "$cf_token" ]]; then
        zones_res=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${root_domain}&status=active" \
            -H "$auth_header" -H "Content-Type: application/json")
    else
        zones_res=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${root_domain}&status=active" \
            -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json")
    fi

    local zone_id=""
    zone_id=$(echo "$zones_res" | grep -oP '(?<="id":")[^"]+' | head -n1 || true)

    if [[ -z "$zone_id" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo encontrar la zona para el dominio '${root_domain}'.${C_RESET}"
        echo -e "${C_GRAY}Verifica tus credenciales y que el dominio esté activo en Cloudflare.${C_RESET}"
        press_enter
        return 1
    fi

    echo -e "${C_GREEN}✔ Zona encontrada:${C_RESET} ID $zone_id"
    echo -e "${C_CYAN}Creando registro DNS tipo A para '${full_domain}' -> ${vps_ip} (Proxy: ${proxied})...${C_RESET}"

    # Comprobar si el registro ya existe
    local rec_check=""
    if [[ -n "$cf_token" ]]; then
        rec_check=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?name=${full_domain}&type=A" \
            -H "$auth_header" -H "Content-Type: application/json")
    else
        rec_check=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?name=${full_domain}&type=A" \
            -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json")
    fi

    local rec_id=""
    rec_id=$(echo "$rec_check" | grep -oP '(?<="id":")[^"]+' | head -n1 || true)

    local create_res=""
    if [[ -n "$rec_id" ]]; then
        echo -e "${C_YELLOW}[AVISO] El registro ya existe. Actualizando registro existente (ID: $rec_id)...${C_RESET}"
        if [[ -n "$cf_token" ]]; then
            create_res=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records/${rec_id}" \
                -H "$auth_header" -H "Content-Type: application/json" \
                --data "{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}")
        else
            create_res=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records/${rec_id}" \
                -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" \
                --data "{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}")
        fi
    else
        if [[ -n "$cf_token" ]]; then
            create_res=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records" \
                -H "$auth_header" -H "Content-Type: application/json" \
                --data "{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}")
        else
            create_res=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records" \
                -H "X-Auth-Email: ${cf_email}" -H "X-Auth-Key: ${cf_key}" -H "Content-Type: application/json" \
                --data "{\"type\":\"A\",\"name\":\"${full_domain}\",\"content\":\"${vps_ip}\",\"ttl\":1,\"proxied\":${proxied}}")
        fi
    fi

    if echo "$create_res" | grep -q '"success":true'; then
        echo -e "\n${C_GREEN}${C_BOLD}✔ ¡Subdominio creado con éxito en Cloudflare!${C_RESET}"
        echo -e "Dominio: ${C_BOLD}${C_CYAN}${full_domain}${C_RESET} -> ${vps_ip}"
        save_domain "$full_domain"
    else
        echo -e "\n${C_RED}[ERROR] Cloudflare rechazó la solicitud:${C_RESET}"
        echo "$create_res" | grep -oP '(?<="message":")[^"]+' || echo "$create_res"
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 2. Dominio Dinámico Gratuito con DuckDNS
# ------------------------------------------------------------------------------
setup_duckdns() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║             VINCULAR DOMINIO GRATUITO CON DUCKDNS                ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_GRAY}DuckDNS (https://www.duckdns.org) ofrece subdominios *.duckdns.org 100% gratuitos.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    echo -e "IP pública: ${C_GREEN}${vps_ip}${C_RESET}\n"

    local duck_sub="" duck_token=""
    read -r -p "Subdominio de DuckDNS (solo el nombre, ej: 'miservidor' para miservidor.duckdns.org): " duck_sub || true
    if [[ -z "${duck_sub:-}" ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        press_enter
        return 0
    fi

    read -r -p "Token de DuckDNS (copiar desde duckdns.org): " duck_token || true
    if [[ -z "${duck_token:-}" ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        press_enter
        return 0
    fi

    echo -e "\n${C_CYAN}Actualizando IP en DuckDNS...${C_RESET}"
    local duck_res
    duck_res=$(curl -s -m 5 "https://www.duckdns.org/update?domains=${duck_sub}&token=${duck_token}&ip=${vps_ip}" || true)

    if [[ "$duck_res" == "OK" ]]; then
        local full_domain="${duck_sub}.duckdns.org"
        echo -e "${C_GREEN}${C_BOLD}✔ ¡DuckDNS actualizado correctamente!${C_RESET}"
        echo -e "Tu dominio es: ${C_BOLD}${C_CYAN}${full_domain}${C_RESET}"

        # Configurar cron job para mantener la IP actualizada automáticamente cada 4 horas
        local cron_script="/etc/vps-ssh-limiter/duckdns_update.sh"
        mkdir -p "$CONFIG_DIR"
        cat > "$cron_script" <<EOF
#!/usr/bin/env bash
curl -s "https://www.duckdns.org/update?domains=${duck_sub}&token=${duck_token}&ip=" >/dev/null 2>&1
EOF
        chmod 700 "$cron_script"

        # Añadir al crontab si no existe
        if command -v crontab >/dev/null 2>&1; then
            ( crontab -l 2>/dev/null | grep -v "$cron_script" ; echo "0 */4 * * * $cron_script >/dev/null 2>&1" ) | crontab - 2>/dev/null || true
            echo -e "${C_GRAY}Cron job programado para renovación automática de DNS.${C_RESET}"
        fi

        save_domain "$full_domain"
    else
        echo -e "${C_RED}[ERROR] DuckDNS respondió con error: '$duck_res'.${C_RESET}"
        echo -e "${C_GRAY}Verifica que el subdominio y el token sean exactamente correctos.${C_RESET}"
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 3. Dominio Gratuito Instantáneo (sslip.io / nip.io - Cero Configuración)
# ------------------------------------------------------------------------------
setup_instant_domain() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║       DOMINIO GRATUITO INSTANTÁNEO (1-CLICK SSLIP.IO)            ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Genera un dominio FQDN válido internacionalmente que resuelve de forma"
    echo -e "instantánea hacia tu IP sin registrar cuentas, ni pagar nada.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    if [[ -z "$vps_ip" ]]; then
        echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública.${C_RESET}"
        press_enter
        return 1
    fi

    echo -e "IP pública: ${C_GREEN}${vps_ip}${C_RESET}"
    local ip_dash="${vps_ip//./-}"
    local instant_dom="vps-${ip_dash}.sslip.io"

    echo -e "Dominio generado: ${C_BOLD}${C_CYAN}${instant_dom}${C_RESET}"
    echo -e "${C_GRAY}Probando resolución DNS en tiempo real...${C_RESET}"

    local test_ip=""
    test_ip=$(ping -c 1 -W 2 "$instant_dom" 2>/dev/null | grep -oP '\(\K[0-9.]+(?=\))' | head -n1 || \
              getent ahosts "$instant_dom" 2>/dev/null | awk '{print $1}' | head -n1 || echo "")

    if [[ "$test_ip" == "$vps_ip" ]]; then
        echo -e "${C_GREEN}✔ Resolución verificada exitosamente: ${instant_dom} -> ${vps_ip}${C_RESET}"
    else
        echo -e "${C_YELLOW}[AVISO] Resolución pendiente de propagación local, pero el dominio está activo.${C_RESET}"
    fi

    save_domain "$instant_dom"
    press_enter
}

# ------------------------------------------------------------------------------
# 4. Asignar Dominio Propio Manualmente
# ------------------------------------------------------------------------------
setup_manual_domain() {
    echo -e "\n${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║             ASIGNAR DOMINIO PROPIO MANUALMENTE                  ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Utiliza esta opción si ya compraste tu dominio y creaste el registro"
    echo -e "tipo 'A' apuntando a la IP de tu VPS en tu proveedor DNS.${C_RESET}\n"

    local vps_ip
    vps_ip=$(get_public_ip)
    echo -e "IP de tu VPS: ${C_GREEN}${vps_ip}${C_RESET}\n"

    local man_domain=""
    read -r -p "Introduce tu dominio o subdominio (ej: vps.midominio.com): " man_domain || true
    man_domain=$(echo "$man_domain" | tr -d '[:space:]')

    if [[ -z "$man_domain" ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        press_enter
        return 0
    fi

    echo -e "\n${C_CYAN}Comprobando si '${man_domain}' resuelve hacia ${vps_ip}...${C_RESET}"
    local resolved_ip=""
    resolved_ip=$(getent ahosts "$man_domain" 2>/dev/null | awk '{print $1}' | head -n1 || \
                  ping -c 1 -W 2 "$man_domain" 2>/dev/null | grep -oP '\(\K[0-9.]+(?=\))' | head -n1 || echo "")

    if [[ "$resolved_ip" == "$vps_ip" ]]; then
        echo -e "${C_GREEN}✔ ¡Verificación exitosa! El dominio ya apunta a este servidor.${C_RESET}"
        save_domain "$man_domain"
    else
        echo -e "${C_YELLOW}[AVISO] El dominio apunta a '$resolved_ip' (o aún no resuelve a ${vps_ip}).${C_RESET}"
        echo -e "¿Deseas guardarlo de todos modos? (Útil si acabas de crear el DNS y está propagando)"
        local force_save=""
        read -r -p "¿Guardar dominio? [s/N]: " force_save || true
        if [[ "${force_save:-}" =~ ^[sS]$ ]]; then
            save_domain "$man_domain"
        else
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 5. Comprobación y Diagnóstico DNS
# ------------------------------------------------------------------------------
check_dns_status() {
    clear
    local current_dom
    current_dom=$(get_current_domain)
    local vps_ip
    vps_ip=$(get_public_ip)

    echo -e "${C_BOLD}${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}║                   ESTADO Y DIAGNÓSTICO DNS                      ║${C_RESET}"
    echo -e "${C_BOLD}${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}\n"
    echo -e "IP pública de la VPS: ${C_YELLOW}${vps_ip}${C_RESET}"

    if [[ -z "$current_dom" ]]; then
        echo -e "Dominio configurado:  ${C_GRAY}(Ninguno - Utilizando IP directa)${C_RESET}"
    else
        echo -e "Dominio configurado:  ${C_GREEN}${C_BOLD}${current_dom}${C_RESET}"
        echo -e "\n${C_CYAN}Probando resolución global con Google DNS (8.8.8.8)...${C_RESET}"
        local google_dns=""
        if command -v dig >/dev/null 2>&1; then
            google_dns=$(dig +short "@8.8.8.8" "$current_dom" 2>/dev/null || true)
        elif command -v nslookup >/dev/null 2>&1; then
            google_dns=$(nslookup "$current_dom" 8.8.8.8 2>/dev/null | grep -A1 "Name:" | awk '/Address:/ {print $2}' || true)
        fi
        echo -e "Respuesta DNS: ${C_BOLD}${google_dns:-Sin respuesta o dig no disponible}${C_RESET}"

        echo -e "\n${C_CYAN}Probando resolución local del sistema...${C_RESET}"
        local local_res=""
        local_res=$(getent ahosts "$current_dom" 2>/dev/null | awk '{print $1}' | head -n1 || echo "")
        echo -e "Resolución local: ${C_BOLD}${local_res:-No resuelve}${C_RESET}"

        if [[ "$local_res" == "$vps_ip" || "$google_dns" == *"$vps_ip"* ]]; then
            echo -e "\n${C_GREEN}✔ El dominio resuelve correctamente hacia esta VPS.${C_RESET}"
        else
            echo -e "\n${C_YELLOW}[AVISO] Si acabas de apuntar el dominio, recuerda que la propagación mundial"
            echo -e "puede tardar entre 2 y 15 minutos.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# 6. Eliminar Dominio
# ------------------------------------------------------------------------------
delete_domain() {
    clear
    local current_dom
    current_dom=$(get_current_domain)
    if [[ -z "$current_dom" ]]; then
        echo -e "${C_YELLOW}No hay ningún dominio configurado actualmente.${C_RESET}"
    else
        echo -e "\n${C_BOLD}${C_RED}¿Está seguro de eliminar el dominio '${current_dom}'?${C_RESET}"
        echo -e "El sistema volverá a mostrar la IP pública en el menú y las fichas."
        local conf_del=""
        read -r -p "Confirmar eliminación [s/N]: " conf_del || true
        if [[ "${conf_del:-}" =~ ^[sS]$ ]]; then
            rm -f "$DOMAIN_FILE"
            echo -e "${C_GREEN}✔ Dominio eliminado. El sistema ha vuelto a modo IP.${C_RESET}"
        else
            echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        fi
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# Bucle Principal Interactivo y Parámetros CLI
# ------------------------------------------------------------------------------
main_menu() {
    while true; do
        clear
        local active_dom
        active_dom=$(get_current_domain)
        local dom_badge="${C_GRAY}(Sin dominio - Modo IP)${C_RESET}"
        if [[ -n "$active_dom" ]]; then
            dom_badge="${C_GREEN}${C_BOLD}${active_dom}${C_RESET}"
        fi

        echo -e "${C_CYAN}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET} ${C_BOLD}             GESTIÓN Y CREACIÓN DE DOMINIOS / HOST             ${C_RESET}${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"
        echo -e " Host activo: ${dom_badge}"
        echo -e "${C_GRAY}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} Crear subdominio con Cloudflare API (Automático)"
        echo -e "  ${C_YELLOW}[2]${C_RESET} Vincular dominio dinámico DuckDNS (Gratuito *.duckdns.org)"
        echo -e "  ${C_YELLOW}[3]${C_RESET} Generar dominio gratuito instantáneo (1-Click sslip.io)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} Asignar / Cambiar dominio manualmente (Tu propio dominio)"
        echo -e "  ${C_YELLOW}[5]${C_RESET} Comprobar estado y diagnóstico DNS del dominio"
        echo -e "  ${C_YELLOW}[6]${C_RESET} Eliminar dominio actual y volver a IP pública"
        echo -e "  ${C_RED}[0]${C_RESET} Volver al Menú Principal"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        local opt_dom=""
        read -r -p "Seleccione una opción [0-6]: " opt_dom || true

        case "${opt_dom:-}" in
            1) setup_cloudflare ;;
            2) setup_duckdns ;;
            3) setup_instant_domain ;;
            4) setup_manual_domain ;;
            5) check_dns_status ;;
            6) delete_domain ;;
            0) break ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

case "${1:-}" in
    --show)
        cur=$(get_current_domain)
        if [[ -n "$cur" ]]; then
            echo "$cur"
        else
            get_public_ip
        fi
        ;;
    --check)
        check_dns_status
        ;;
    --set)
        if [[ -z "${2:-}" ]]; then
            echo -e "${C_RED}Uso: ssh-domain --set <dominio>${C_RESET}"
            exit 1
        fi
        save_domain "$2"
        ;;
    --instant)
        v_ip=$(get_public_ip)
        if [[ -z "$v_ip" ]]; then
            echo -e "${C_RED}[ERROR] No se pudo detectar la IP pública.${C_RESET}"
            exit 1
        fi
        i_dash="${v_ip//./-}"
        inst_dom="vps-${i_dash}.sslip.io"
        save_domain "$inst_dom"
        ;;
    --unset)
        rm -f "$DOMAIN_FILE"
        echo -e "${C_GREEN}✔ Dominio eliminado. El servidor ha vuelto a modo IP pública.${C_RESET}"
        ;;
    *)
        main_menu
        ;;
esac

