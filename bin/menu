#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/menu
# Panel de Control Interactivo con Estética Hacker / SysAdmin Moderna.
# Rediseñado 100% para pantallas móviles (41 columnas exactas).
# Atajos globales: menu, tin, vps
# ==============================================================================
set -euo pipefail

# ------------------------------------------------------------------------------
# Configuración de Colores ANSI
# ------------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_BOLD="\033[1m"
    C_GRAY="\033[0;90m"
else
    C_RESET=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_BOLD=""
    C_GRAY=""
fi

press_enter() {
    echo ""
    read -r -p " Presione [Enter] para continuar..." _ || true
}

run_bin() {
    local bin_name="$1"
    shift
    if [[ -x "/usr/local/bin/${bin_name}" ]]; then
        "/usr/local/bin/${bin_name}" "$@"
    elif [[ -f "${BASH_SOURCE[0]%/*}/${bin_name}" ]]; then
        bash "${BASH_SOURCE[0]%/*}/${bin_name}" "$@"
    else
        "$bin_name" "$@"
    fi
}

# ------------------------------------------------------------------------------
# Funciones de Telemetría del Sistema
# ------------------------------------------------------------------------------
get_public_ip() {
    local ip
    ip=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    echo "$ip"
}

get_ram_info() {
    local mem_data total_m used_m
    if command -v free >/dev/null 2>&1; then
        mem_data=$(free -m | awk '/Mem:/ {print $2, $3}')
        total_m=$(echo "$mem_data" | awk '{print $1}')
        used_m=$(echo "$mem_data" | awk '{print $2}')
        if [[ -n "$total_m" && "$total_m" -gt 0 ]]; then
            echo "${used_m}M/${total_m}M"
            return
        fi
    fi
    echo "N/A"
}

get_ram_bar() {
    local mem_data total_m used_m pct filled empty
    if command -v free >/dev/null 2>&1; then
        mem_data=$(free -m | awk '/Mem:/ {print $2, $3}')
        total_m=$(echo "$mem_data" | awk '{print $1}')
        used_m=$(echo "$mem_data" | awk '{print $2}')
        if [[ -n "$total_m" && "$total_m" -gt 0 ]]; then
            pct=$(( used_m * 100 / total_m ))
            filled=$(( pct / 20 ))
            if [[ $filled -gt 5 ]]; then filled=5; fi
            empty=$(( 5 - filled ))
            local bar="["
            for ((i=0; i<filled; i++)); do bar+="█"; done
            for ((i=0; i<empty; i++)); do bar+="░"; done
            bar+="]"
            echo "$bar"
            return
        fi
    fi
    echo "[░░░░░]"
}

get_cpu_usage() {
    if command -v top >/dev/null 2>&1; then
        local cpu
        cpu=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2 + $4}' || echo "N/A")
        if [[ -n "$cpu" && "$cpu" != "N/A" ]]; then
            echo "${cpu}%"
            return
        fi
    fi
    echo "N/A"
}

get_disk_usage() {
    if command -v df >/dev/null 2>&1; then
        local d
        d=$(df -h / 2>/dev/null | awk 'NR==2 {print $5}')
        if [[ -n "$d" ]]; then
            echo "$d"
            return
        fi
    fi
    echo "N/A"
}

get_uptime_formatted() {
    if [[ -f /proc/uptime ]]; then
        local up_sec days hours mins
        up_sec=$(cut -d. -f1 /proc/uptime)
        days=$(( up_sec / 86400 ))
        hours=$(( (up_sec % 86400) / 3600 ))
        mins=$(( (up_sec % 3600) / 60 ))
        if [[ $days -gt 0 ]]; then
            echo "${days}d ${hours}h"
        else
            echo "${hours}h ${mins}m"
        fi
    else
        echo "N/A"
    fi
}

check_service_badge() {
    local sname="$1"
    if systemctl is-active --quiet "$sname" 2>/dev/null; then
        echo -e "${C_GREEN}✔${C_RESET}"
    else
        echo -e "${C_RED}✖${C_RESET}"
    fi
}

get_user_stats() {
    local pass_file="${PASSWD_FILE:-/etc/passwd}"
    local total=0 online=0 expired=0
    local now_epoch
    now_epoch=$(date +%s)

    # Cargar conexiones activas de Dropbear y OpenSSH
    local -A active_users=()
    # 1. Por UID
    for p in $(pgrep -f "dropbear|sshd" 2>/dev/null || true); do
        [[ -d "/proc/$p" ]] || continue
        local p_uid
        p_uid=$(awk '/^Uid:/ {print $2}' "/proc/$p/status" 2>/dev/null || true)
        if [[ -n "$p_uid" && "$p_uid" -ge 1000 ]]; then
            local u_name
            u_name=$(id -nu "$p_uid" 2>/dev/null || true)
            [[ -n "$u_name" ]] && active_users["$u_name"]=1
        fi
    done

    # 2. Por logs de Dropbear (procesos corriendo como root)
    local db_pids=($(pgrep -x dropbear 2>/dev/null || true))
    if [[ ${#db_pids[@]} -gt 0 ]]; then
        local logs=""
        if command -v journalctl >/dev/null 2>&1; then
            logs=$(journalctl -u dropbear -n 500 --no-pager 2>/dev/null || true)
        fi
        if [[ -f /var/log/auth.log ]]; then
            local al
            al=$(tail -n 500 /var/log/auth.log 2>/dev/null | grep -i "dropbear" || true)
            logs="${logs}"$'\n'"${al}"
        fi
        while read -r line; do
            if [[ "$line" =~ dropbear\[([0-9]+)\]:.*auth\ succeeded\ for\ \'([^\']+)\' ]]; then
                local pid="${BASH_REMATCH[1]}"
                local user="${BASH_REMATCH[2]}"
                if [[ -d "/proc/$pid" ]]; then
                    active_users["$user"]=1
                fi
            fi
        done <<< "$logs"
    fi

    if [[ -r "$pass_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            local u="${line%%:*}"
            [[ -z "$u" ]] && continue
            local rest="${line#*:}"
            rest="${rest#*:}"
            local uid="${rest%%:*}"

            local is_user=false
            if [[ "$line" =~ LIM[:_=-]?([0-9]+) ]]; then
                is_user=true
            elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]]; then
                if [[ "$u" != "nobody" && "$u" != "nogroup" && "$u" != "ubuntu" && "$u" != "debian" ]]; then
                    is_user=true
                fi
            fi

            if [[ "$is_user" == true ]]; then
                total=$((total + 1))
                if [[ -n "${active_users["$u"]:-}" ]]; then
                    online=$((online + 1))
                fi

                if command -v chage >/dev/null 2>&1; then
                    local exp_raw
                    exp_raw=$(chage -l "$u" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
                    if [[ -n "$exp_raw" && "$exp_raw" != "never" && "$exp_raw" != "nunca" ]]; then
                        local exp_epoch
                        exp_epoch=$(date -d "$exp_raw" +%s 2>/dev/null || true)
                        if [[ -n "$exp_epoch" && "$now_epoch" -gt "$exp_epoch" ]]; then
                            expired=$((expired + 1))
                        fi
                    fi
                fi
            fi
        done < "$pass_file"
    fi

    echo "$total $online $expired"
}

# ------------------------------------------------------------------------------
# Renderizado del Dashboard Principal (41 Columnas - Mobile First)
# ------------------------------------------------------------------------------
draw_dashboard() {
    clear
    local pub_ip ram_txt ram_bar cpu_load disk_txt uptime_txt
    pub_ip=$(get_public_ip)
    ram_txt=$(get_ram_info)
    ram_bar=$(get_ram_bar)
    cpu_load=$(get_cpu_usage)
    disk_txt=$(get_disk_usage)
    uptime_txt=$(get_uptime_formatted)

    local s_ssh s_drop s_ws s_lim
    s_ssh=$(check_service_badge "ssh")
    s_drop=$(check_service_badge "dropbear")
    s_ws=$(check_service_badge "ssh-wsproxy")
    s_lim=$(check_service_badge "ssh-limiter")

    local u_total=0 u_online=0 u_exp=0
    read -r u_total u_online u_exp < <(get_user_stats)

    local os_pretty="Linux"
    if [[ -f /etc/os-release ]]; then
        os_pretty=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d= -f2 | tr -d '"' | cut -d' ' -f1-2)
    fi

    local current_ver="1.8.4"
    if [[ -f /etc/vps-ssh-limiter/version ]]; then
        current_ver=$(tr -d '[:space:]' < /etc/vps-ssh-limiter/version)
    fi

    local remote_ver=""
    remote_ver=$(curl -fsSL -m 2.5 "https://raw.githubusercontent.com/sendeiser/tin-script/main/version?v=$(date +%s)" 2>/dev/null | tr -d '[:space:]' || true)

    local active_dom=""
    if [[ -f /etc/vps-ssh-limiter/domain && -s /etc/vps-ssh-limiter/domain ]]; then
        active_dom=$(tr -d '[:space:]' < /etc/vps-ssh-limiter/domain)
    fi

    local host_disp="$pub_ip"
    if [[ -n "$active_dom" ]]; then
        host_disp="$active_dom"
    fi

    local srv_total_b=0 srv_total_fmt="0 B"
    if [[ -r /proc/net/dev ]]; then
        local rx=0 tx=0
        while read -r iface rx_b _ _ _ _ _ _ _ tx_b _; do
            if [[ "$iface" != "lo:" && "$iface" =~ :$ ]]; then
                rx=$(( rx + rx_b ))
                tx=$(( tx + tx_b ))
            fi
        done < /proc/net/dev
        srv_total_b=$(( rx + tx ))
        if [[ $srv_total_b -ge 1073741824 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
        elif [[ $srv_total_b -ge 1048576 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.2f MB", b / 1048576 }')
        elif [[ $srv_total_b -ge 1024 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.1f KB", b / 1024 }')
        fi
    fi

    local ver_badge="${C_GREEN}[v${current_ver} - ACTUALIZADO]${C_RESET}"
    local opt_9_txt="${C_YELLOW}${C_BOLD}[9]${C_RESET}  ${C_BOLD}► ACTUALIZAR SCRIPT${C_RESET}"

    if [[ "$remote_ver" =~ ^[0-9]+(\.[0-9]+)*$ ]] && [[ "$remote_ver" != "$current_ver" ]]; then
        ver_badge="${C_YELLOW}${C_BOLD}[v${current_ver} -> ¡v${remote_ver} DISPONIBLE!]${C_RESET}"
        opt_9_txt="${C_GREEN}${C_BOLD}[9]${C_RESET}  ${C_GREEN}${C_BOLD}► ACTUALIZAR SCRIPT ★${C_RESET}"
    fi

    echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}║${C_RESET}     ${C_BOLD}${C_WHITE}★ VPS-SSH-LIMITER MANAGER ★${C_RESET}       ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
    echo -e " ${C_BOLD}S.O.   :${C_RESET} ${os_pretty} ($(uname -m))"
    echo -e " ${C_BOLD}Host/IP:${C_RESET} ${C_GREEN}${host_disp}${C_RESET}"
    echo -e " ${C_BOLD}Uptime :${C_RESET} ${uptime_txt} | ${C_BOLD}Disco:${C_RESET} ${disk_txt}"
    echo -e " ${C_BOLD}RAM    :${C_RESET} ${C_CYAN}${ram_bar}${C_RESET} ${ram_txt} | ${C_BOLD}CPU:${C_RESET} ${cpu_load}"
    echo -e " ${C_BOLD}Versión:${C_RESET} ${ver_badge}"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
    echo -e " ${C_BOLD}SERVICIOS:${C_RESET} SSH:${s_ssh} Drop:${s_drop} WS:${s_ws} Lim:${s_lim}"
    echo -e " ${C_BOLD}CUENTAS  :${C_RESET} Tot:${C_BOLD}${u_total}${C_RESET} | On:${C_GREEN}${u_online}${C_RESET} | Exp:${C_RED}${u_exp}${C_RESET}"
    echo -e " ${C_BOLD}TRÁFICO  :${C_RESET} ${C_GREEN}${srv_total_fmt}${C_RESET} Transferidos"
    echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
    echo -e " ${C_YELLOW}${C_BOLD}[1]${C_RESET}  ${C_BOLD}► GESTIÓN DE USUARIOS${C_RESET}"
    echo -e " ${C_YELLOW}${C_BOLD}[2]${C_RESET}  ${C_BOLD}► MONITOR DE CONEXIONES Y DATOS${C_RESET}"
    echo -e " ${C_GREEN}${C_BOLD}[3]${C_RESET}  ${C_BOLD}${C_GREEN}► BANNERS Y BIENVENIDA${C_RESET}"
    echo -e " ${C_YELLOW}${C_BOLD}[4]${C_RESET}  ${C_BOLD}► DEMONIO LIMITADOR (SYSTEMD)${C_RESET}"
    echo -e " ${C_YELLOW}${C_BOLD}[5]${C_RESET}  ${C_BOLD}► PROTOCOLOS Y PUERTOS${C_RESET}"
    echo -e " ${C_YELLOW}${C_BOLD}[6]${C_RESET}  ${C_BOLD}► OPTIMIZACIÓN Y SISTEMA${C_RESET}"
    echo -e " ${C_CYAN}${C_BOLD}[7]${C_RESET}  ${C_BOLD}${C_CYAN}► DOMINIOS Y HOSTS 100% GRATIS${C_RESET}"
    echo -e " ${C_CYAN}${C_BOLD}[8]${C_RESET}  ${C_BOLD}${C_CYAN}► GUÍA & ASISTENTE HTTP CUSTOM${C_RESET}"
    echo -e " $opt_9_txt"
    echo -e " ${C_YELLOW}${C_BOLD}[10]${C_RESET} ${C_BOLD}► DESINSTALAR SCRIPT${C_RESET}"
    echo -e " ${C_RED}${C_BOLD}[0]${C_RESET}  ${C_BOLD}► SALIR DEL PANEL${C_RESET}"
    echo -e "${C_CYAN}═════════════════════════════════════════${C_RESET}"
}

# ------------------------------------------------------------------------------
# SUBMENÚ 1: GESTIÓN DE USUARIOS
# ------------------------------------------------------------------------------
menu_users() {
    while true; do
        clear
        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}        ${C_BOLD}${C_WHITE}★ GESTIÓN DE USUARIOS ★${C_RESET}        ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 📋 Ver lista y consumo de cuentas"
        echo -e "  ${C_YELLOW}[2]${C_RESET} ➕ Crear nuevo usuario túnel"
        echo -e "  ${C_YELLOW}[3]${C_RESET} ✏️  Renovar / Modificar usuario"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 🔒 Bloquear / Desbloquear usuario"
        echo -e "  ${C_YELLOW}[5]${C_RESET} ⚡ Expulsar sesiones activas"
        echo -e "  ${C_YELLOW}[6]${C_RESET} ❌ Eliminar usuario del sistema"
        echo -e "  ${C_YELLOW}[7]${C_RESET} 🔍 Ver detalles de una cuenta"
        echo -e "  ${C_YELLOW}[8]${C_RESET} 📱 Ficha cliente (HTTP Custom)"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_user=""
        read -r -p " Seleccione una opción [0-8]: " opt_user || true

        case "${opt_user:-}" in
            1)
                clear
                run_bin ssh-online
                press_enter
                ;;
            2)
                echo -e "\n${C_BOLD}${C_CYAN}--- CREAR NUEVO USUARIO TÚNEL ---${C_RESET}"
                local u_name="" u_pass="" u_days="" u_limit=""
                read -r -p " Nombre de usuario: " u_name || true
                read -r -p " Contraseña: " u_pass || true
                read -r -p " Días de validez (ej: 30): " u_days || true
                read -r -p " Límite de conexiones (ej: 2): " u_limit || true

                if [[ -z "${u_name:-}" || -z "${u_pass:-}" || -z "${u_days:-}" || -z "${u_limit:-}" ]]; then
                    echo -e "${C_RED}[ERROR] Todos los campos son obligatorios.${C_RESET}"
                else
                    run_bin ssh-useradd "$u_name" "$u_pass" "$u_days" "$u_limit" || true
                fi
                press_enter
                ;;
            3)
                echo -e "\n${C_BOLD}${C_CYAN}--- RENOVAR / MODIFICAR USUARIO ---${C_RESET}"
                local u_name=""
                read -r -p " Usuario a modificar: " u_name || true
                if [[ -z "${u_name:-}" ]]; then
                    echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                elif ! id "$u_name" >/dev/null 2>&1; then
                    echo -e "${C_RED}[ERROR] El usuario '$u_name' no existe.${C_RESET}"
                else
                    echo -e "Deje en blanco los campos que NO desee cambiar:"
                    local m_days="" m_limit="" m_pass=""
                    read -r -p " Días adicionales a renovar (ej: 30): " m_days || true
                    read -r -p " Nuevo límite de conexiones (ej: 3): " m_limit || true
                    read -r -p " Nueva contraseña: " m_pass || true

                    local cmd_args=("$u_name")
                    if [[ -n "${m_days:-}" ]]; then cmd_args+=(--days "$m_days"); fi
                    if [[ -n "${m_limit:-}" ]]; then cmd_args+=(--limit "$m_limit"); fi
                    if [[ -n "${m_pass:-}" ]]; then cmd_args+=(--password "$m_pass"); fi

                    run_bin ssh-usermod "${cmd_args[@]}" || true
                fi
                press_enter
                ;;
            4)
                echo -e "\n${C_BOLD}${C_CYAN}--- BLOQUEAR / DESBLOQUEAR USUARIO ---${C_RESET}"
                local u_name=""
                read -r -p " Usuario: " u_name || true
                if [[ -z "${u_name:-}" ]]; then
                    echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                elif ! id "$u_name" >/dev/null 2>&1; then
                    echo -e "${C_RED}[ERROR] El usuario '$u_name' no existe.${C_RESET}"
                else
                    run_bin ssh-userlock "$u_name" status
                    echo -e "Acción: [1] Bloquear  [2] Desbloquear  [0] Cancelar"
                    local lock_opt=""
                    read -r -p " Opción: " lock_opt || true
                    if [[ "${lock_opt:-}" == "1" ]]; then
                        run_bin ssh-userlock "$u_name" lock
                    elif [[ "${lock_opt:-}" == "2" ]]; then
                        run_bin ssh-userlock "$u_name" unlock
                    fi
                fi
                press_enter
                ;;
            5)
                echo -e "\n${C_BOLD}${C_CYAN}--- EXPULSAR SESIONES ACTIVAS ---${C_RESET}"
                local u_name=""
                read -r -p " Usuario a desconectar: " u_name || true
                if [[ -n "${u_name:-}" ]]; then
                    run_bin ssh-killuser "$u_name" || true
                fi
                press_enter
                ;;
            6)
                echo -e "\n${C_BOLD}${C_RED}--- ELIMINAR USUARIO DEL SISTEMA ---${C_RESET}"
                local u_name=""
                read -r -p " Nombre de usuario a eliminar: " u_name || true
                if [[ -n "${u_name:-}" ]]; then
                    local confirm=""
                    read -r -p " ¿Está seguro de eliminar '$u_name'? [s/N]: " confirm || true
                    if [[ "${confirm:-}" =~ ^[sS]$ ]]; then
                        run_bin ssh-userdel "$u_name" || true
                    else
                        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                    fi
                fi
                press_enter
                ;;
            7)
                echo -e "\n${C_BOLD}${C_CYAN}--- DETALLES DE CUENTA ---${C_RESET}"
                local u_name=""
                read -r -p " Usuario a consultar: " u_name || true
                if [[ -n "${u_name:-}" ]]; then
                    if id "$u_name" >/dev/null 2>&1; then
                        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
                        id "$u_name"
                        chage -l "$u_name" 2>/dev/null || true
                        run_bin ssh-userlock "$u_name" status
                        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
                    else
                        echo -e "${C_RED}[ERROR] El usuario '$u_name' no existe.${C_RESET}"
                    fi
                fi
                press_enter
                ;;
            8)
                echo -e "\n${C_BOLD}${C_CYAN}--- GENERAR FICHA HTTP CUSTOM ---${C_RESET}"
                local u_name="" u_pass=""
                read -r -p " Usuario: " u_name || true
                if [[ -z "${u_name:-}" ]]; then
                    echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                elif ! id "$u_name" >/dev/null 2>&1; then
                    echo -e "${C_RED}[ERROR] El usuario '$u_name' no existe.${C_RESET}"
                else
                    read -r -p " Contraseña (opcional): " u_pass || true
                    clear
                    run_bin ssh-httpcustom "$u_name" "${u_pass:-********}" || true
                fi
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 2: MONITOR DE CONEXIONES Y DATOS
# ------------------------------------------------------------------------------
menu_monitor() {
    while true; do
        clear
        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}       ${C_BOLD}${C_WHITE}★ MONITOR DE CONEXIONES ★${C_RESET}       ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 📋 Ver conexiones y datos ahora"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🔄 Monitor en vivo (Refresco 2s)"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🖥️  Modo horizontal ancho (PC)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} ⚡ Expulsar excedentes ahora"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_mon=""
        read -r -p " Seleccione una opción [0-4]: " opt_mon || true

        case "${opt_mon:-}" in
            1)
                clear
                run_bin ssh-online
                press_enter
                ;;
            2)
                clear
                echo -e "${C_CYAN}Iniciando monitor continuo. Presione ${C_BOLD}[Ctrl+C]${C_RESET} o ${C_BOLD}[q]${C_RESET} para volver.${C_RESET}\n"
                sleep 1
                while true; do
                    clear
                    run_bin ssh-online
                    echo -e "${C_GRAY}Refrescando en 2 segundos... (Presione 'q' para salir)${C_RESET}"
                    local key_press=""
                    read -t 2 -n 1 key_press || true
                    if [[ "${key_press:-}" == "q" || "${key_press:-}" == "Q" ]]; then
                        break
                    fi
                done
                ;;
            3)
                clear
                run_bin ssh-online --wide
                press_enter
                ;;
            4)
                echo -e "\n${C_BOLD}${C_CYAN}--- MITIGACIÓN MASIVA DE EXCEDENTES ---${C_RESET}"
                run_bin ssh-killuser --all-exceeded || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 3: DEMONIO LIMITADOR
# ------------------------------------------------------------------------------
menu_limiter() {
    while true; do
        clear
        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}        ${C_BOLD}${C_WHITE}★ DEMONIO LIMITADOR ★${C_RESET}          ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 📊 Ver estado del servicio"
        echo -e "  ${C_YELLOW}[2]${C_RESET} ▶️  Iniciar / Habilitar"
        echo -e "  ${C_YELLOW}[3]${C_RESET} ⏹️  Detener limitador"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 🔄 Reiniciar limitador"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 📜 Ver registros en vivo"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_lim=""
        read -r -p " Seleccione una opción [0-5]: " opt_lim || true

        case "${opt_lim:-}" in
            1)
                echo -e "\n${C_BOLD}Estado actual de ssh-limiter.service:${C_RESET}\n"
                systemctl status ssh-limiter --no-pager || true
                press_enter
                ;;
            2)
                systemctl enable --now ssh-limiter
                echo -e "${C_GREEN}✔ Servicio ssh-limiter iniciado.${C_RESET}"
                sleep 1.5
                ;;
            3)
                systemctl stop ssh-limiter
                echo -e "${C_YELLOW}✔ Servicio ssh-limiter detenido.${C_RESET}"
                sleep 1.5
                ;;
            4)
                systemctl restart ssh-limiter
                echo -e "${C_GREEN}✔ Servicio ssh-limiter reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            5)
                clear
                echo -e "${C_CYAN}Mostrando registros en vivo de ssh-limiter. Presione ${C_BOLD}[Ctrl+C]${C_RESET} para volver.${C_RESET}\n"
                journalctl -u ssh-limiter -n 30 -f || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 4: PROTOCOLOS Y PUERTOS (INCLUYE WEBSOCKET PROXY PUERTO 80)
# ------------------------------------------------------------------------------
menu_wsproxy() {
    while true; do
        clear
        local ws_active="${C_RED}[OFF]${C_RESET}"
        if systemctl is-active --quiet ssh-wsproxy 2>/dev/null; then
            ws_active="${C_GREEN}[ON]${C_RESET}"
        fi

        local l_port="80" t_port="143"
        if [[ -f /etc/vps-ssh-limiter/wsproxy.conf ]]; then
            l_port=$(grep "^LISTEN_PORT=" /etc/vps-ssh-limiter/wsproxy.conf 2>/dev/null | cut -d= -f2 || echo "80")
            t_port=$(grep "^TARGET_PORT=" /etc/vps-ssh-limiter/wsproxy.conf 2>/dev/null | cut -d= -f2 || echo "143")
        fi

        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}       ${C_BOLD}${C_WHITE}★ WEBSOCKET PROXY (80) ★${C_RESET}        ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e " Estado : ${ws_active}"
        echo -e " Escucha: ${C_YELLOW}0.0.0.0:${l_port}${C_RESET} -> ${C_GREEN}127.0.0.1:${t_port}${C_RESET}"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} ▶️  Iniciar WebSocket Proxy"
        echo -e "  ${C_YELLOW}[2]${C_RESET} ⏹️  Detener WebSocket Proxy"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🔄 Reiniciar WebSocket Proxy"
        echo -e "  ${C_YELLOW}[4]${C_RESET} ⚙️  Cambiar puerto escucha (${l_port})"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 🎯 Cambiar puerto destino (${t_port})"
        echo -e "  ${C_YELLOW}[6]${C_RESET} 📜 Ver registros en vivo"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al submenú de puertos"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_ws=""
        read -r -p " Seleccione una opción [0-6]: " opt_ws || true

        case "${opt_ws:-}" in
            1)
                systemctl enable --now ssh-wsproxy 2>/dev/null || systemctl start ssh-wsproxy
                echo -e "${C_GREEN}✔ WebSocket Proxy iniciado en el puerto ${l_port}.${C_RESET}"
                sleep 1.5
                ;;
            2)
                systemctl stop ssh-wsproxy
                echo -e "${C_YELLOW}✔ WebSocket Proxy detenido.${C_RESET}"
                sleep 1.5
                ;;
            3)
                systemctl restart ssh-wsproxy
                echo -e "${C_GREEN}✔ WebSocket Proxy reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            4)
                echo -e "\n${C_CYAN}--- CONFIGURAR PUERTO DE ESCUCHA ---${C_RESET}"
                echo -e "Puerto actual: ${C_YELLOW}${l_port}${C_RESET} (Recomendado HTTP Custom: 80)"
                local new_lp=""
                read -r -p " Nuevo puerto de escucha: " new_lp || true
                if [[ -n "${new_lp:-}" && "$new_lp" =~ ^[0-9]+$ ]]; then
                    mkdir -p /etc/vps-ssh-limiter
                    cat > /etc/vps-ssh-limiter/wsproxy.conf <<EOF
LISTEN_PORT=${new_lp}
TARGET_HOST=127.0.0.1
TARGET_PORT=${t_port}
EOF
                    systemctl restart ssh-wsproxy 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puerto cambiado a ${new_lp} y servicio reiniciado.${C_RESET}"
                fi
                press_enter
                ;;
            5)
                echo -e "\n${C_CYAN}--- CONFIGURAR PUERTO DESTINO (INTERNO) ---${C_RESET}"
                echo -e "Puerto actual destino: ${C_GREEN}${t_port}${C_RESET} (143 = Dropbear, 22 = OpenSSH)"
                local new_tp=""
                read -r -p " Nuevo puerto destino (143 o 22): " new_tp || true
                if [[ -n "${new_tp:-}" && "$new_tp" =~ ^[0-9]+$ ]]; then
                    mkdir -p /etc/vps-ssh-limiter
                    cat > /etc/vps-ssh-limiter/wsproxy.conf <<EOF
LISTEN_PORT=${l_port}
TARGET_HOST=127.0.0.1
TARGET_PORT=${new_tp}
EOF
                    systemctl restart ssh-wsproxy 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puerto destino cambiado a ${new_tp} y servicio reiniciado.${C_RESET}"
                fi
                press_enter
                ;;
            6)
                clear
                echo -e "${C_CYAN}Mostrando registros en vivo de ssh-wsproxy. Presione ${C_BOLD}[Ctrl+C]${C_RESET} para volver.${C_RESET}\n"
                journalctl -u ssh-wsproxy -n 30 -f || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

menu_ports() {
    while true; do
        clear
        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}        ${C_BOLD}${C_WHITE}★ PUERTOS Y PROTOCOLOS ★${C_RESET}       ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 🔍 Ver puertos activos"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🚪 Configurar puertos de Dropbear"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🌐 WebSocket Proxy (Puerto 80)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 🔄 Reiniciar Dropbear"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 🔄 Reiniciar OpenSSH"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_ports=""
        read -r -p " Seleccione una opción [0-5]: " opt_ports || true

        case "${opt_ports:-}" in
            1)
                echo -e "\n${C_BOLD}Puertos en escucha:${C_RESET}\n"
                ss -tulpn 2>/dev/null | grep -E 'sshd|dropbear|python|wsproxy' || netstat -tulpn 2>/dev/null | grep -E 'sshd|dropbear|python|wsproxy' || echo "No se detectaron puertos en escucha."
                press_enter
                ;;
            2)
                echo -e "\n${C_BOLD}${C_CYAN}--- CONFIGURAR PUERTOS DROPBEAR ---${C_RESET}"
                echo -e "Configuración actual en /etc/default/dropbear:"
                grep -E 'DROPBEAR_PORT|DROPBEAR_EXTRA_ARGS' /etc/default/dropbear 2>/dev/null || true
                echo ""
                local main_p="" extra_p=""
                read -r -p " Puerto principal (ej: 143): " main_p || true
                read -r -p " Puertos adicionales (ej: 90 109 443): " extra_p || true

                if [[ -n "${main_p:-}" ]]; then
                    sed -i "s/^DROPBEAR_PORT=.*/DROPBEAR_PORT=$main_p/" /etc/default/dropbear
                    local extra_flags=""
                    for p in ${extra_p:-}; do
                        extra_flags+="-p $p "
                    done
                    if [[ -f /etc/vps-ssh-limiter/banner.net ]]; then
                        extra_flags+="-b /etc/vps-ssh-limiter/banner.net "
                    fi
                    extra_flags=$(echo "$extra_flags" | xargs)
                    sed -i "s|^DROPBEAR_EXTRA_ARGS=.*|DROPBEAR_EXTRA_ARGS=\"$extra_flags\"|" /etc/default/dropbear
                    systemctl restart dropbear 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puertos de Dropbear actualizados.${C_RESET}"
                fi
                press_enter
                ;;
            3)
                menu_wsproxy
                ;;
            4)
                systemctl restart dropbear
                echo -e "${C_GREEN}✔ Dropbear reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            5)
                systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
                echo -e "${C_GREEN}✔ OpenSSH reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 5: OPTIMIZACIÓN Y SISTEMA
# ------------------------------------------------------------------------------
menu_tools() {
    while true; do
        clear
        echo -e "${C_CYAN}╔═══════════════════════════════════════╗${C_RESET}"
        echo -e "${C_CYAN}║${C_RESET}       ${C_BOLD}${C_WHITE}★ OPTIMIZACIÓN Y SISTEMA ★${C_RESET}      ${C_CYAN}║${C_RESET}"
        echo -e "${C_CYAN}╚═══════════════════════════════════════╝${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 🧹 Limpiar RAM y Buffers"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🚀 Acelerador TCP BBR"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 💻 Hardware y Procesador"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────${C_RESET}"
        local opt_tool=""
        read -r -p " Seleccione una opción [0-3]: " opt_tool || true

        case "${opt_tool:-}" in
            1)
                echo -e "\n${C_CYAN}Liberando memoria caché y buffers del kernel...${C_RESET}"
                sync
                echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
                echo -e "${C_GREEN}✔ Memoria RAM optimizada exitosamente.${C_RESET}"
                press_enter
                ;;
            2)
                echo -e "\n${C_BOLD}${C_CYAN}--- ACELERADOR DE RED TCP BBR ---${C_RESET}"
                local current_cc=""
                current_cc=$(sysctl net.ipv4.tcp_congestion_control 2>/dev/null || true)
                echo -e "Control de congestión actual: ${C_YELLOW}$current_cc${C_RESET}"
                if [[ "$current_cc" =~ bbr ]]; then
                    echo -e "${C_GREEN}✔ El algoritmo TCP BBR ya se encuentra activo en el kernel.${C_RESET}"
                else
                    local act_bbr=""
                    read -r -p " ¿Desea activar TCP BBR? [s/N]: " act_bbr || true
                    if [[ "${act_bbr:-}" =~ ^[sS]$ ]]; then
                        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                        sysctl -p >/dev/null 2>&1 || true
                        echo -e "${C_GREEN}✔ TCP BBR activado exitosamente.${C_RESET}"
                    fi
                fi
                press_enter
                ;;
            3)
                clear
                echo -e "${C_BOLD}Información del Hardware y Procesador:${C_RESET}\n"
                lscpu 2>/dev/null | grep -E 'Model name|Socket|Thread|NUMA|CPU\(s\)|Architecture' || uname -a
                echo ""
                echo -e "${C_BOLD}Memoria detallada:${C_RESET}"
                free -h || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 6: ACTUALIZACIÓN AUTOMÁTICA
# ------------------------------------------------------------------------------
menu_update() {
    clear
    if [[ -x /usr/local/bin/ssh-update ]]; then
        /usr/local/bin/ssh-update --reload-menu
    elif [[ -f "${BASH_SOURCE[0]%/*}/ssh-update" ]]; then
        bash "${BASH_SOURCE[0]%/*}/ssh-update" --reload-menu
    else
        echo -e "${C_CYAN}Descargando e instalando última versión del repositorio...${C_RESET}"
        curl -fsSL "https://raw.githubusercontent.com/sendeiser/tin-script/main/install.sh?v=$(date +%s)" | bash
        press_enter
        exec /usr/local/bin/menu
    fi
}

# ------------------------------------------------------------------------------
# SUBMENÚ 7: DESINSTALACIÓN
# ------------------------------------------------------------------------------
menu_uninstall() {
    clear
    echo -e "\n${C_BOLD}${C_RED}╔═══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_BOLD}${C_RED}║   DESINSTALACIÓN DE VPS-SSH-LIMITER   ║${C_RESET}"
    echo -e "${C_BOLD}${C_RED}╚═══════════════════════════════════════╝${C_RESET}\n"
    echo -e "${C_YELLOW}Esta acción detendrá los servicios y eliminará los binarios y atajos ('menu', 'tin', 'vps')."
    echo -e "Los usuarios existentes NO serán borrados.${C_RESET}\n"

    local conf_del=""
    read -r -p " ¿Está seguro de desinstalar? [s/N]: " conf_del || true
    if [[ "${conf_del:-}" =~ ^[sS]$ ]]; then
        if [[ -f /usr/local/bin/install.sh ]]; then
            /usr/local/bin/install.sh --uninstall
        else
            curl -fsSL "https://raw.githubusercontent.com/sendeiser/tin-script/main/install.sh?v=$(date +%s)" | bash -s -- --uninstall
        fi
        exit 0
    else
        echo -e "${C_CYAN}Desinstalación cancelada.${C_RESET}"
        press_enter
    fi
}

# ------------------------------------------------------------------------------
# Bucle Principal del Menú
# ------------------------------------------------------------------------------
if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Debe ejecutar con permisos de superusuario: ${C_BOLD}sudo menu${C_RESET}" >&2
    exit 1
fi

menu_banner() {
    run_bin ssh-banner
}

while true; do
    draw_dashboard
    main_opt=""
    read -r -p " Ingrese una opción [0-10]: " main_opt || true

    case "${main_opt:-}" in
        1) menu_users ;;
        2) menu_monitor ;;
        3) menu_banner ;;
        4) menu_limiter ;;
        5) menu_ports ;;
        6) menu_tools ;;
        7) run_bin ssh-domain ;;
        8) run_bin ssh-httpcustom ;;
        9) menu_update ;;
        10) menu_uninstall ;;
        0)
            clear
            echo -e "${C_CYAN}Gracias por utilizar ${C_BOLD}vps-ssh-limiter${C_RESET}${C_CYAN}. ¡Hasta pronto!${C_RESET}\n"
            exit 0
            ;;
        *)
            echo -e "${C_RED} Opción inválida.${C_RESET}"
            sleep 1
            ;;
    esac
done
