#!/usr/bin/env bash
# ==============================================================================
# vps-ssh-limiter: bin/menu
# Panel de Control Interactivo con Diseño Telemetría Integral ("Se Ve Todo")
# Inspirado en autoscript-vip con adaptación profesional y bordes exactos a 62 cols.
# Atajos globales: menu, tin, vps
# ==============================================================================
set -euo pipefail

# ------------------------------------------------------------------------------
# Configuración de Colores ANSI
# ------------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"

    # Paleta Minimalista (Moderna, limpia y de alto contraste)
    C_BORDER="\033[0;36m"     # Slate Cyan sutil para bordes limpios
    C_TITLE="\033[1;37m"      # Blanco puro destacado
    C_BRAND="\033[1;36m"      # Cyan eléctrico para la marca
    C_LABEL="\033[1;36m"      # Cyan eléctrico de alta visibilidad en pantallas móviles
    C_VAL="\033[1;37m"        # Blanco puro brillante para valores
    C_NUM="\033[1;33m"        # Ámbar cálido suave para números de opción [01]
    C_TEXT="\033[1;37m"       # Blanco puro brillante para texto de opciones
    C_ON="\033[1;32m"         # Verde esmeralda minimalista [ON]
    C_OFF="\033[0;31m"        # Rojo apagado [OFF]

    # Compatibilidad con submenús existentes
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_GRAY="\033[0;36m"       # Slate cyan sutil para líneas divisorias en lugar de gris apagado
    BG_BLUE=""
    BG_PINK=""
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_BORDER=""
    C_TITLE=""
    C_BRAND=""
    C_LABEL=""
    C_VAL=""
    C_NUM=""
    C_TEXT=""
    C_ON=""
    C_OFF=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_GRAY=""
    BG_BLUE=""
    BG_PINK=""
fi

press_enter() {
    echo ""
    read -r -p " Presione [Enter] para continuar..." _ || true
}

run_bin() {
    local bin_name="$1"
    shift
    if [[ -x "/usr/local/bin/${bin_name}" ]]; then
        "/usr/local/bin/${bin_name}" "$@"
    elif [[ -f "${BASH_SOURCE[0]%/*}/${bin_name}" ]]; then
        bash "${BASH_SOURCE[0]%/*}/${bin_name}" "$@"
    else
        "$bin_name" "$@"
    fi
}

# ------------------------------------------------------------------------------
# Funciones de Telemetría del Sistema
# ------------------------------------------------------------------------------
get_public_ip() {
    local ip
    ip=$(curl -s4 -m 1.5 https://api.ipify.org 2>/dev/null || \
         curl -s4 -m 1.5 https://icanhazip.com 2>/dev/null || \
         ip route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n1 || \
         hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    echo "$ip"
}

get_server_domain() {
    if [[ -f /etc/vps-ssh-limiter/domain && -s /etc/vps-ssh-limiter/domain ]]; then
        tr -d '[:space:]' < /etc/vps-ssh-limiter/domain
    else
        get_public_ip
    fi
}

get_ram_info() {
    local mem_data total_m used_m pct
    if command -v free >/dev/null 2>&1; then
        mem_data=$(free -m | awk '/Mem:/ {print $2, $3}')
        total_m=$(echo "$mem_data" | awk '{print $1}')
        used_m=$(echo "$mem_data" | awk '{print $2}')
        if [[ -n "$total_m" && "$total_m" -gt 0 ]]; then
            pct=$(( used_m * 100 / total_m ))
            echo "${used_m} / ${total_m} MB (${pct}%)"
            return
        fi
    fi
    echo "N/A"
}

get_cpu_usage() {
    if command -v top >/dev/null 2>&1; then
        local cpu
        cpu=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2 + $4}' || true)
        if [[ -n "$cpu" && "$cpu" != "N/A" ]]; then
            echo "${cpu} %"
            return
        fi
    fi
    echo "N/A"
}

get_core_count() {
    local cores=1
    if [[ -f /proc/cpuinfo ]]; then
        cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo "1")
    elif command -v nproc >/dev/null 2>&1; then
        cores=$(nproc 2>/dev/null || echo "1")
    fi
    echo "${cores} Cores"
}

get_uptime_formatted() {
    if [[ -f /proc/uptime ]]; then
        local up_sec days hours mins
        up_sec=$(cut -d. -f1 /proc/uptime)
        days=$(( up_sec / 86400 ))
        hours=$(( (up_sec % 86400) / 3600 ))
        mins=$(( (up_sec % 3600) / 60 ))
        if [[ $days -gt 0 ]]; then
            echo "${days} days, ${hours} hours"
        else
            echo "${hours} hours, ${mins} mins"
        fi
    else
        echo "N/A"
    fi
}

get_os_info() {
    local os="Linux"
    if [[ -f /etc/os-release ]]; then
        os=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d= -f2 | tr -d '"' | cut -d' ' -f1-3)
    fi
    local arch
    arch=$(uname -m 2>/dev/null || echo "x86_64")
    echo "${os} (${arch})"
}

is_active() {
    systemctl is-active --quiet "$1" 2>/dev/null
}

check_service_badge() {
    local sname="$1"
    if is_active "$sname"; then
        echo -e "${C_ON}[ON]${C_RESET}"
    else
        echo -e "${C_OFF}[OFF]${C_RESET}"
    fi
}

check_service_any_badge() {
    for s in "$@"; do
        if is_active "$s"; then
            echo -e "${C_ON}[ON]${C_RESET}"
            return
        fi
    done
    echo -e "${C_OFF}[OFF]${C_RESET}"
}

get_user_stats() {
    local pass_file="${PASSWD_FILE:-/etc/passwd}"
    local total=0 online=0 expired=0
    local now_epoch
    now_epoch=$(date +%s)

    local -A active_users=()
    for p in $(pgrep -f "dropbear|sshd" 2>/dev/null || true); do
        [[ -d "/proc/$p" ]] || continue
        local p_uid
        p_uid=$(awk '/^Uid:/ {print $2}' "/proc/$p/status" 2>/dev/null || true)
        if [[ -n "$p_uid" && "$p_uid" -ge 1000 ]]; then
            local u_name
            u_name=$(id -nu "$p_uid" 2>/dev/null || true)
            [[ -n "$u_name" ]] && active_users["$u_name"]=1
        fi
    done

    local db_pids=($(pgrep -x dropbear 2>/dev/null || true))
    if [[ ${#db_pids[@]} -gt 0 ]]; then
        local logs=""
        if command -v journalctl >/dev/null 2>&1; then
            logs=$(journalctl -u dropbear -n 300 --no-pager 2>/dev/null || true)
        fi
        if [[ -f /var/log/auth.log ]]; then
            local al
            al=$(tail -n 300 /var/log/auth.log 2>/dev/null | grep -i "dropbear" || true)
            logs="${logs}"$'\n'"${al}"
        fi
        while read -r line; do
            if [[ "$line" =~ dropbear\[([0-9]+)\]:.*auth\ succeeded\ for\ \'([^\']+)\' ]]; then
                local pid="${BASH_REMATCH[1]}"
                local user="${BASH_REMATCH[2]}"
                if [[ -d "/proc/$pid" ]]; then
                    active_users["$user"]=1
                fi
            fi
        done <<< "$logs"
    fi

    if [[ -r "$pass_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            local u="${line%%:*}"
            [[ -z "$u" ]] && continue
            local rest="${line#*:}"
            rest="${rest#*:}"
            local uid="${rest%%:*}"

            local is_user=false
            if [[ "$line" =~ LIM[:_=-]?([0-9]+) ]]; then
                is_user=true
            elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]]; then
                if [[ "$u" != "nobody" && "$u" != "nogroup" && "$u" != "ubuntu" && "$u" != "debian" ]]; then
                    is_user=true
                fi
            fi

            if [[ "$is_user" == true ]]; then
                total=$((total + 1))
                if [[ -n "${active_users["$u"]:-}" ]]; then
                    online=$((online + 1))
                fi

                if command -v chage >/dev/null 2>&1; then
                    local exp_raw
                    exp_raw=$(chage -l "$u" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
                    if [[ -n "$exp_raw" && "$exp_raw" != "never" && "$exp_raw" != "nunca" ]]; then
                        local exp_epoch
                        exp_epoch=$(date -d "$exp_raw" +%s 2>/dev/null || true)
                        if [[ -n "$exp_epoch" && "$now_epoch" -gt "$exp_epoch" ]]; then
                            expired=$((expired + 1))
                        fi
                    fi
                fi
            fi
        done < "$pass_file"
    fi

    echo "$total $online $expired"
}

get_traffic_stats() {
    local srv_total_b=0 srv_total_fmt="0 B"
    if [[ -r /proc/net/dev ]]; then
        local rx=0 tx=0
        while read -r iface rx_b _ _ _ _ _ _ _ tx_b _; do
            if [[ "$iface" != "lo:" && "$iface" =~ :$ ]]; then
                rx=$(( rx + rx_b ))
                tx=$(( tx + tx_b ))
            fi
        done < /proc/net/dev
        srv_total_b=$(( rx + tx ))
        if [[ $srv_total_b -ge 1073741824 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.2f GB", b / 1073741824 }')
        elif [[ $srv_total_b -ge 1048576 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.2f MB", b / 1048576 }')
        elif [[ $srv_total_b -ge 1024 ]]; then
            srv_total_fmt=$(awk -v b="$srv_total_b" 'BEGIN { printf "%.1f KB", b / 1024 }')
        fi
    fi
    echo "$srv_total_fmt"
}

# ------------------------------------------------------------------------------
# Renderizado del Dashboard Principal ("Se Ve Todo" - 62 Cols)
# ------------------------------------------------------------------------------
draw_dashboard() {
    clear
    local pub_ip domain_val ram_txt cpu_load cores_cnt uptime_txt os_txt date_val time_val
    pub_ip=$(get_public_ip)
    domain_val=$(get_server_domain)
    ram_txt=$(get_ram_info)
    cpu_load=$(get_cpu_usage)
    cores_cnt=$(get_core_count)
    uptime_txt=$(get_uptime_formatted)
    os_txt=$(get_os_info)
    date_val=$(date +'%d-%m-%Y')
    time_val=$(date +'%H:%M:%S')

    local s_ssh s_drop s_ws s_udp s_lim s_tun s_f2b s_cron
    s_ssh=$(check_service_any_badge ssh sshd)
    s_drop=$(check_service_badge dropbear)
    s_ws=$(check_service_badge ssh-wsproxy)
    s_udp=$(check_service_badge badvpn-udpgw)
    s_lim=$(check_service_badge ssh-limiter)
    s_tun=$(check_service_badge ssh)
    s_f2b=$(check_service_badge fail2ban)
    s_cron=$(check_service_badge cron)

    local u_total=0 u_online=0 u_exp=0
    read -r u_total u_online u_exp < <(get_user_stats)
    local traffic_txt
    traffic_txt=$(get_traffic_stats)

    local current_ver="2.2.3"
    if [[ -f /etc/vps-ssh-limiter/version ]]; then
        current_ver=$(tr -d '[:space:]' < /etc/vps-ssh-limiter/version)
    fi

    # 1. Tarjeta de Telemetría Compacta (8 líneas total)
    echo -e " ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
    printf " ${C_BORDER}│${C_RESET}  %b%b⚡ TIN SCRIPTS%b %b•%b %bVPS MANAGER%b             %bv%-5s%b %b[ONLINE]%b  ${C_BORDER}│${C_RESET}\n" \
        "$C_BRAND" "$C_BOLD" "$C_RESET" "$C_LABEL" "$C_RESET" "$C_TITLE" "$C_RESET" "$C_LABEL" "$current_ver" "$C_RESET" "$C_ON" "$C_RESET"
    echo -e " ${C_BORDER}├─────────────────────────────┬─────────────────────────────┤${C_RESET}"
    printf " ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_LABEL" "OS" "$C_RESET" "$C_VAL" "${os_txt:0:18}" "$C_RESET" \
        "$C_LABEL" "IP" "$C_RESET" "$C_VAL" "${pub_ip:0:18}" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_LABEL" "Host" "$C_RESET" "$C_VAL" "${domain_val:0:18}" "$C_RESET" \
        "$C_LABEL" "Uptime" "$C_RESET" "$C_VAL" "${uptime_txt:0:18}" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_LABEL" "RAM" "$C_RESET" "$C_VAL" "${ram_txt:0:18}" "$C_RESET" \
        "$C_LABEL" "Cuentas" "$C_RESET" "$C_VAL" "${u_total} Tot (${u_online} On)" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET} %b%-7s%b: %b%-18s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_LABEL" "CPU" "$C_RESET" "$C_VAL" "${cpu_load} (${cores_cnt})" "$C_RESET" \
        "$C_LABEL" "Tráfico" "$C_RESET" "$C_VAL" "${traffic_txt:0:18}" "$C_RESET"
    echo -e " ${C_BORDER}╰─────────────────────────────┴─────────────────────────────╯${C_RESET}"

    # 2. Rejilla de Servicios en Tiempo Real (4 Columnas)
    echo -e " ${C_BORDER}╭──────────────┬──────────────┬──────────────┬──────────────╮${C_RESET}"
    printf " ${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET}\n" \
        "$C_TEXT" "SSH" "$C_RESET" "$s_ssh" \
        "$C_TEXT" "DROPBEAR" "$C_RESET" "$s_drop" \
        "$C_TEXT" "WS-80" "$C_RESET" "$s_ws" \
        "$C_TEXT" "UDPGW" "$C_RESET" "$s_udp"
    echo -e " ${C_BORDER}├──────────────┼──────────────┼──────────────┼──────────────┤${C_RESET}"
    printf " ${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET} %b%-8s%b %b${C_BORDER}│${C_RESET}\n" \
        "$C_TEXT" "LIMITER" "$C_RESET" "$s_lim" \
        "$C_TEXT" "TUNNEL" "$C_RESET" "$s_tun" \
        "$C_TEXT" "FAIL2BAN" "$C_RESET" "$s_f2b" \
        "$C_TEXT" "CRON" "$C_RESET" "$s_cron"
    echo -e " ${C_BORDER}╰──────────────┴──────────────┴──────────────┴──────────────╯${C_RESET}"

    # 3. Rejilla de Opciones del Menú (3 Columnas)
    echo -e " ${C_BORDER}╭───────────────────┬───────────────────┬───────────────────╮${C_RESET}"
    printf " ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_NUM" "[01]" "$C_RESET" "$C_TEXT" "USUARIOS SSH" "$C_RESET" \
        "$C_NUM" "[06]" "$C_RESET" "$C_TEXT" "BANNERS/TEXT" "$C_RESET" \
        "$C_NUM" "[11]" "$C_RESET" "$C_TEXT" "DOMINIO/DNS" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_NUM" "[02]" "$C_RESET" "$C_TEXT" "CREAR TRIAL" "$C_RESET" \
        "$C_NUM" "[07]" "$C_RESET" "$C_TEXT" "RESTART TODO" "$C_RESET" \
        "$C_NUM" "[12]" "$C_RESET" "$C_TEXT" "TEST VELOCID" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_NUM" "[03]" "$C_RESET" "$C_TEXT" "UDPGW 7300" "$C_RESET" \
        "$C_NUM" "[08]" "$C_RESET" "$C_TEXT" "LIMITADOR" "$C_RESET" \
        "$C_NUM" "[13]" "$C_RESET" "$C_TEXT" "ACTUALIZAR" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_NUM" "[04]" "$C_RESET" "$C_TEXT" "MONITOR VIVO" "$C_RESET" \
        "$C_NUM" "[09]" "$C_RESET" "$C_TEXT" "PUERTOS/RED" "$C_RESET" \
        "$C_NUM" "[14]" "$C_RESET" "$C_TEXT" "DESINSTALAR" "$C_RESET"
    printf " ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET} %b%-4s%b %b%-12s%b ${C_BORDER}│${C_RESET}\n" \
        "$C_NUM" "[05]" "$C_RESET" "$C_TEXT" "FICHA CLIENT" "$C_RESET" \
        "$C_NUM" "[10]" "$C_RESET" "$C_TEXT" "LIMPIAR CACH" "$C_RESET" \
        "$C_NUM" "[00]" "$C_RESET" "$C_TEXT" "SALIR PANEL" "$C_RESET"
    echo -e " ${C_BORDER}╰───────────────────┴───────────────────┴───────────────────╯${C_RESET}"
    echo -e ""
}

# ------------------------------------------------------------------------------
# Selector Interactivo de Usuarios Túnel por Número
# ------------------------------------------------------------------------------
select_tunnel_user() {
    local action_title="${1:-SELECCIONAR USUARIO}"
    local pass_file="/etc/passwd"
    local -a u_list=()

    if [[ -r "$pass_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            local u="${line%%:*}"
            [[ -z "$u" ]] && continue
            local rest="${line#*:}"
            rest="${rest#*:}"
            local uid="${rest%%:*}"

            local is_user=false
            if [[ "$line" =~ LIM[:_=-]?([0-9]+) ]]; then
                is_user=true
            elif [[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 && "$uid" -lt 65534 ]]; then
                if [[ "$u" != "nobody" && "$u" != "nogroup" && "$u" != "ubuntu" && "$u" != "debian" ]]; then
                    is_user=true
                fi
            fi

            if [[ "$is_user" == true ]]; then
                u_list+=("$u")
            fi
        done < "$pass_file"
    fi

    if [[ ${#u_list[@]} -eq 0 ]]; then
        echo -e "\n${C_YELLOW}[AVISO] No hay usuarios túnel registrados en el sistema.${C_RESET}"
        local manual_u=""
        read -r -p " ¿Desea ingresar el nombre manualmente? [s/N]: " manual_u || true
        if [[ "${manual_u:-}" =~ ^[sS]$ ]]; then
            local u_man=""
            read -r -p " Nombre de usuario: " u_man || true
            if [[ -n "${u_man:-}" ]] && id "$u_man" >/dev/null 2>&1; then
                SELECTED_USER="$u_man"
                return 0
            else
                echo -e "${C_RED}[ERROR] El usuario no existe en el sistema.${C_RESET}"
                return 1
            fi
        fi
        return 1
    fi

    echo -e "\n ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
    printf " ${C_BORDER}│${C_RESET}  %b%b%-55s%b  ${C_BORDER}│${C_RESET}\n" "$C_TITLE" "$C_BOLD" "$action_title" "$C_RESET"
    echo -e " ${C_BORDER}├───────────────────────────────────────────────────────────┤${C_RESET}"

    local now_epoch
    now_epoch=$(date +%s)
    local i=1
    for u in "${u_list[@]}"; do
        local st="ACTIVO"
        local inf="Sin expiración"

        if passwd -S "$u" 2>/dev/null | grep -q " L "; then
            st="BLOQUEADO"
            inf="Suspendido"
        elif command -v chage >/dev/null 2>&1; then
            local exp_raw
            exp_raw=$(chage -l "$u" 2>/dev/null | grep -i "^Account expires" | cut -d: -f2- | xargs || true)
            if [[ -n "$exp_raw" && "$exp_raw" != "never" && "$exp_raw" != "nunca" ]]; then
                local exp_epoch
                exp_epoch=$(date -d "$exp_raw" +%s 2>/dev/null || true)
                if [[ -n "$exp_epoch" ]]; then
                    if [[ "$now_epoch" -gt "$exp_epoch" ]]; then
                        st="EXPIRADO"
                        inf="Expirado"
                    else
                        local diff_days=$(( (exp_epoch - now_epoch) / 86400 ))
                        inf="${diff_days} días"
                    fi
                fi
            fi
        fi

        local badge_col="$C_ON"
        local badge_txt="[ACTIVO]   "
        if [[ "$st" == "BLOQUEADO" ]]; then
            badge_col="$C_RED"
            badge_txt="[BLOQUEADO]"
        elif [[ "$st" == "EXPIRADO" ]]; then
            badge_col="$C_OFF"
            badge_txt="[EXPIRADO] "
        fi

        printf " ${C_BORDER}│${C_RESET}  %b[%02d]%b %b%-18s%b %b%-11s%b %b%-20s%b ${C_BORDER}│${C_RESET}\n" \
            "$C_NUM" "$i" "$C_RESET" \
            "$C_TITLE" "${u:0:18}" "$C_RESET" \
            "$badge_col" "$badge_txt" "$C_RESET" \
            "$C_LABEL" "${inf:0:20}" "$C_RESET"
        ((i++))
    done

    echo -e " ${C_BORDER}╰───────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "  ${C_NUM}[M]${C_RESET} ${C_TITLE}Ingresar nombre manualmente${C_RESET}"
    echo -e "  ${C_RED}[0]${C_RESET} ${C_TITLE}Cancelar operación${C_RESET}\n"

    local sel=""
    read -r -p "  ❱❱❱ Seleccione una opción [1-${#u_list[@]} / M / 0]: " sel || true
    if [[ "$sel" == "0" || -z "$sel" ]]; then
        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
        return 1
    fi

    if [[ "$sel" =~ ^[mM]$ ]]; then
        local man_user=""
        read -r -p " Ingrese el nombre de usuario: " man_user || true
        if [[ -n "${man_user:-}" ]] && id "$man_user" >/dev/null 2>&1; then
            SELECTED_USER="$man_user"
            return 0
        else
            echo -e "${C_RED}[ERROR] El usuario '$man_user' no existe en el sistema.${C_RESET}"
            return 1
        fi
    fi

    if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#u_list[@]} )); then
        SELECTED_USER="${u_list[$((sel - 1))]}"
        return 0
    else
        echo -e "${C_RED}[ERROR] Selección inválida.${C_RESET}"
        return 1
    fi
}

# ------------------------------------------------------------------------------
# SUBMENÚ 1: GESTIÓN DE USUARIOS
# ------------------------------------------------------------------------------
menu_users() {
    while true; do
        clear
        echo -e " ${C_BORDER}╭───────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e " ${C_BORDER}│${C_RESET}               ${C_BOLD}${C_WHITE}★ GESTIÓN DE USUARIOS SSH ★${C_RESET}                ${C_BORDER}│${C_RESET}"
        echo -e " ${C_BORDER}╰───────────────────────────────────────────────────────────╯${C_RESET}"
        echo -e "  ${C_NUM}[1]${C_RESET} 📋 Ver lista y consumo de cuentas"
        echo -e "  ${C_NUM}[2]${C_RESET} ➕ Crear nuevo usuario túnel permanente"
        echo -e "  ${C_NUM}[3]${C_RESET} ⏱️  Crear cuenta trial rápida (Test)"
        echo -e "  ${C_NUM}[4]${C_RESET} ✏️  Renovar / Modificar usuario"
        echo -e "  ${C_NUM}[5]${C_RESET} 🔒 Bloquear / Desbloquear usuario"
        echo -e "  ${C_NUM}[6]${C_RESET} ⚡ Expulsar sesiones activas"
        echo -e "  ${C_NUM}[7]${C_RESET} ❌ Eliminar usuario del sistema"
        echo -e "  ${C_NUM}[8]${C_RESET} 🔍 Ver detalles de una cuenta"
        echo -e "  ${C_NUM}[9]${C_RESET} 📱 Ficha cliente (HTTP Custom)"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e " ${C_BORDER}─────────────────────────────────────────────────────────────${C_RESET}"
        local opt_user=""
        read -r -p "  ❱❱❱ Seleccione una opción [0-9]: " opt_user || true

        case "${opt_user:-}" in
            1)
                clear
                run_bin ssh-online
                press_enter
                ;;
            2)
                echo -e "\n${C_BOLD}${C_CYAN}--- CREAR NUEVO USUARIO TÚNEL ---${C_RESET}"
                local u_name="" u_pass="" u_days="" u_limit=""
                read -r -p " Nombre de usuario: " u_name || true
                read -r -p " Contraseña: " u_pass || true
                read -r -p " Días de validez (ej: 30): " u_days || true
                read -r -p " Límite de conexiones (ej: 2): " u_limit || true

                if [[ -z "${u_name:-}" || -z "${u_pass:-}" || -z "${u_days:-}" || -z "${u_limit:-}" ]]; then
                    echo -e "${C_RED}[ERROR] Todos los campos son obligatorios.${C_RESET}"
                else
                    run_bin ssh-useradd "$u_name" "$u_pass" "$u_days" "$u_limit" || true
                fi
                press_enter
                ;;
            3)
                run_bin ssh-trial
                ;;
            4)
                if select_tunnel_user "✏️  RENOVAR / MODIFICAR USUARIO"; then
                    local u_name="$SELECTED_USER"
                    echo -e "\n${C_LABEL}Modificando usuario:${C_RESET} ${C_TITLE}${u_name}${C_RESET}"
                    echo -e "Deje en blanco los campos que NO desee cambiar:"
                    local m_days="" m_limit="" m_pass=""
                    read -r -p " Días adicionales a renovar (ej: 30): " m_days || true
                    read -r -p " Nuevo límite de conexiones (ej: 3): " m_limit || true
                    read -r -p " Nueva contraseña: " m_pass || true

                    local cmd_args=("$u_name")
                    if [[ -n "${m_days:-}" ]]; then cmd_args+=(--days "$m_days"); fi
                    if [[ -n "${m_limit:-}" ]]; then cmd_args+=(--limit "$m_limit"); fi
                    if [[ -n "${m_pass:-}" ]]; then cmd_args+=(--password "$m_pass"); fi

                    run_bin ssh-usermod "${cmd_args[@]}" || true
                fi
                press_enter
                ;;
            5)
                if select_tunnel_user "🔒 BLOQUEAR / DESBLOQUEAR USUARIO"; then
                    local u_name="$SELECTED_USER"
                    echo -e ""
                    run_bin ssh-userlock "$u_name" status
                    echo -e "Acción: [1] Bloquear  [2] Desbloquear  [0] Cancelar"
                    local lock_opt=""
                    read -r -p " Opción: " lock_opt || true
                    if [[ "${lock_opt:-}" == "1" ]]; then
                        run_bin ssh-userlock "$u_name" lock
                    elif [[ "${lock_opt:-}" == "2" ]]; then
                        run_bin ssh-userlock "$u_name" unlock
                    fi
                fi
                press_enter
                ;;
            6)
                if select_tunnel_user "⚡ EXPULSAR SESIONES ACTIVAS"; then
                    local u_name="$SELECTED_USER"
                    run_bin ssh-killuser "$u_name" || true
                fi
                press_enter
                ;;
            7)
                if select_tunnel_user "❌ ELIMINAR USUARIO DEL SISTEMA"; then
                    local u_name="$SELECTED_USER"
                    local confirm=""
                    read -r -p " ¿Está seguro de eliminar a '$u_name'? [s/N]: " confirm || true
                    if [[ "${confirm:-}" =~ ^[sS]$ ]]; then
                        run_bin ssh-userdel "$u_name" || true
                    else
                        echo -e "${C_YELLOW}Operación cancelada.${C_RESET}"
                    fi
                fi
                press_enter
                ;;
            8)
                if select_tunnel_user "🔍 DETALLES DE CUENTA"; then
                    local u_name="$SELECTED_USER"
                    echo -e " ${C_BORDER}─────────────────────────────────────────────────────────────${C_RESET}"
                    id "$u_name"
                    chage -l "$u_name" 2>/dev/null || true
                    run_bin ssh-userlock "$u_name" status
                    echo -e " ${C_BORDER}─────────────────────────────────────────────────────────────${C_RESET}"
                fi
                press_enter
                ;;
            9)
                if select_tunnel_user "📱 GENERAR FICHA HTTP CUSTOM"; then
                    local u_name="$SELECTED_USER"
                    local u_pass=""
                    read -r -p " Contraseña (opcional para mostrar en ficha): " u_pass || true
                    clear
                    run_bin ssh-httpcustom "$u_name" "${u_pass:-********}" || true
                fi
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 2: MONITOR DE CONEXIONES Y DATOS
# ------------------------------------------------------------------------------
menu_monitor() {
    while true; do
        clear
        echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}       ${C_BOLD}${C_WHITE}★ MONITOR DE CONEXIONES Y DATOS EN VIVO ★${C_RESET}          ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 📋 Ver conexiones y datos ahora"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🔄 Monitor continuo en vivo (Refresco 2s)"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🖥️  Modo horizontal ancho (Terminal PC)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} ⚡ Expulsar usuarios con límites excedidos"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────────────────────────${C_RESET}"
        local opt_mon=""
        read -r -p " Seleccione una opción [0-4]: " opt_mon || true

        case "${opt_mon:-}" in
            1)
                clear
                run_bin ssh-online
                press_enter
                ;;
            2)
                clear
                echo -e "${C_CYAN}Iniciando monitor continuo. Presione ${C_BOLD}[q]${C_RESET} o ${C_BOLD}[Ctrl+C]${C_RESET} para volver.${C_RESET}\n"
                sleep 1
                while true; do
                    clear
                    run_bin ssh-online
                    echo -e "${C_GRAY}Refrescando en 2 segundos... (Presione 'q' para salir)${C_RESET}"
                    local key_press=""
                    read -t 2 -n 1 key_press || true
                    if [[ "${key_press:-}" == "q" || "${key_press:-}" == "Q" ]]; then
                        break
                    fi
                done
                ;;
            3)
                clear
                run_bin ssh-online --wide
                press_enter
                ;;
            4)
                echo -e "\n${C_BOLD}${C_CYAN}--- MITIGACIÓN MASIVA DE EXCEDENTES ---${C_RESET}"
                run_bin ssh-killuser --all-exceeded || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 3: DEMONIO LIMITADOR
# ------------------------------------------------------------------------------
menu_limiter() {
    while true; do
        clear
        echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}            ${C_BOLD}${C_WHITE}★ DEMONIO LIMITADOR SYSTEMD ★${C_RESET}                  ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 📊 Ver estado del servicio (systemctl status)"
        echo -e "  ${C_YELLOW}[2]${C_RESET} ▶️  Iniciar y habilitar autoarranque"
        echo -e "  ${C_YELLOW}[3]${C_RESET} ⏹️  Detener limitador"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 🔄 Reiniciar limitador"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 📜 Ver registros en vivo (journalctl)"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────────────────────────${C_RESET}"
        local opt_lim=""
        read -r -p " Seleccione una opción [0-5]: " opt_lim || true

        case "${opt_lim:-}" in
            1)
                echo -e "\n${C_BOLD}Estado actual de ssh-limiter.service:${C_RESET}\n"
                systemctl status ssh-limiter --no-pager || true
                press_enter
                ;;
            2)
                systemctl enable --now ssh-limiter
                echo -e "${C_GREEN}✔ Servicio ssh-limiter iniciado y habilitado.${C_RESET}"
                sleep 1.5
                ;;
            3)
                systemctl stop ssh-limiter
                echo -e "${C_YELLOW}✔ Servicio ssh-limiter detenido.${C_RESET}"
                sleep 1.5
                ;;
            4)
                systemctl restart ssh-limiter
                echo -e "${C_GREEN}✔ Servicio ssh-limiter reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            5)
                clear
                echo -e "${C_CYAN}Mostrando registros en vivo de ssh-limiter. Presione ${C_BOLD}[Ctrl+C]${C_RESET} para volver.${C_RESET}\n"
                journalctl -u ssh-limiter -n 30 -f || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# SUBMENÚ 4: PROTOCOLOS Y PUERTOS (INCLUYE WEBSOCKET PROXY PUERTO 80)
# ------------------------------------------------------------------------------
menu_wsproxy() {
    while true; do
        clear
        local ws_active="${C_RED}[OFF]${C_RESET}"
        if systemctl is-active --quiet ssh-wsproxy 2>/dev/null; then
            ws_active="${C_GREEN}[ON]${C_RESET}"
        fi

        local l_port="80" t_port="22"
        if [[ -f /etc/vps-ssh-limiter/wsproxy.conf ]]; then
            l_port=$(grep "^LISTEN_PORT=" /etc/vps-ssh-limiter/wsproxy.conf 2>/dev/null | cut -d= -f2 || echo "80")
            t_port=$(grep "^TARGET_PORT=" /etc/vps-ssh-limiter/wsproxy.conf 2>/dev/null | cut -d= -f2 || echo "22")
        fi

        echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}       ${C_BOLD}${C_WHITE}★ WEBSOCKET PROXY PARA HTTP CUSTOM (80) ★${C_RESET}          ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}"
        echo -e " Estado : ${ws_active}"
        echo -e " Escucha: ${C_YELLOW}0.0.0.0:${l_port}${C_RESET} -> ${C_GREEN}127.0.0.1:${t_port}${C_RESET}"
        echo -e "${C_GRAY}─────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} ▶️  Iniciar WebSocket Proxy"
        echo -e "  ${C_YELLOW}[2]${C_RESET} ⏹️  Detener WebSocket Proxy"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🔄 Reiniciar WebSocket Proxy"
        echo -e "  ${C_YELLOW}[4]${C_RESET} ⚙️  Cambiar puerto escucha (${l_port})"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 🎯 Cambiar puerto destino (${t_port})"
        echo -e "  ${C_YELLOW}[6]${C_RESET} 📜 Ver registros en vivo"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al submenú de puertos"
        echo -e "${C_GRAY}─────────────────────────────────────────────────────────────${C_RESET}"
        local opt_ws=""
        read -r -p " Seleccione una opción [0-6]: " opt_ws || true

        case "${opt_ws:-}" in
            1)
                systemctl enable --now ssh-wsproxy 2>/dev/null || systemctl start ssh-wsproxy
                echo -e "${C_GREEN}✔ WebSocket Proxy iniciado en el puerto ${l_port}.${C_RESET}"
                sleep 1.5
                ;;
            2)
                systemctl stop ssh-wsproxy
                echo -e "${C_YELLOW}✔ WebSocket Proxy detenido.${C_RESET}"
                sleep 1.5
                ;;
            3)
                systemctl restart ssh-wsproxy
                echo -e "${C_GREEN}✔ WebSocket Proxy reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            4)
                echo -e "\n${C_CYAN}--- CONFIGURAR PUERTO DE ESCUCHA ---${C_RESET}"
                echo -e "Puerto actual: ${C_YELLOW}${l_port}${C_RESET} (Recomendado HTTP Custom: 80 o 8080)"
                local new_lp=""
                read -r -p " Nuevo puerto de escucha: " new_lp || true
                if [[ -n "${new_lp:-}" && "$new_lp" =~ ^[0-9]+$ ]]; then
                    mkdir -p /etc/vps-ssh-limiter
                    cat > /etc/vps-ssh-limiter/wsproxy.conf <<EOF
LISTEN_PORT=${new_lp}
TARGET_HOST=127.0.0.1
TARGET_PORT=${t_port}
EOF
                    systemctl restart ssh-wsproxy 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puerto cambiado a ${new_lp} y servicio reiniciado.${C_RESET}"
                fi
                press_enter
                ;;
            5)
                echo -e "\n${C_CYAN}--- CONFIGURAR PUERTO DESTINO (INTERNO) ---${C_RESET}"
                echo -e "Puerto actual destino: ${C_GREEN}${t_port}${C_RESET} (22 = OpenSSH, 143/90 = Dropbear)"
                local new_tp=""
                read -r -p " Nuevo puerto destino (22, 143 o 90): " new_tp || true
                if [[ -n "${new_tp:-}" && "$new_tp" =~ ^[0-9]+$ ]]; then
                    mkdir -p /etc/vps-ssh-limiter
                    cat > /etc/vps-ssh-limiter/wsproxy.conf <<EOF
LISTEN_PORT=${l_port}
TARGET_HOST=127.0.0.1
TARGET_PORT=${new_tp}
EOF
                    systemctl restart ssh-wsproxy 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puerto destino cambiado a ${new_tp} y servicio reiniciado.${C_RESET}"
                fi
                press_enter
                ;;
            6)
                clear
                echo -e "${C_CYAN}Mostrando registros en vivo de ssh-wsproxy. Presione ${C_BOLD}[Ctrl+C]${C_RESET} para volver.${C_RESET}\n"
                journalctl -u ssh-wsproxy -n 30 -f || true
                press_enter
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

menu_ports() {
    while true; do
        clear
        echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}              ${C_BOLD}${C_WHITE}★ PUERTOS Y PROTOCOLOS DE RED ★${C_RESET}              ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}"
        echo -e "  ${C_YELLOW}[1]${C_RESET} 🔍 Ver puertos y sockets activos en el sistema"
        echo -e "  ${C_YELLOW}[2]${C_RESET} 🚪 Configurar puertos de Dropbear (90, 109)"
        echo -e "  ${C_YELLOW}[3]${C_RESET} 🌐 WebSocket Proxy (Puerto 80)"
        echo -e "  ${C_YELLOW}[4]${C_RESET} 🎮 BadVPN UDP Gateway (Puerto 7300)"
        echo -e "  ${C_YELLOW}[5]${C_RESET} 🔄 Reiniciar Dropbear"
        echo -e "  ${C_YELLOW}[6]${C_RESET} 🔄 Reiniciar OpenSSH"
        echo -e "  ${C_RED}[0]${C_RESET} ↩️  Volver al Menú Principal"
        echo -e "${C_GRAY}─────────────────────────────────────────────────────────────${C_RESET}"
        local opt_ports=""
        read -r -p " Seleccione una opción [0-6]: " opt_ports || true

        case "${opt_ports:-}" in
            1)
                echo -e "\n${C_BOLD}Puertos en escucha en el servidor:${C_RESET}\n"
                ss -tulpn 2>/dev/null | grep -E 'sshd|dropbear|python|wsproxy|badvpn' || \
                netstat -tulpn 2>/dev/null | grep -E 'sshd|dropbear|python|wsproxy|badvpn' || \
                echo "No se pudieron listar los sockets activos."
                press_enter
                ;;
            2)
                echo -e "\n${C_BOLD}${C_CYAN}--- CONFIGURAR PUERTOS DROPBEAR ---${C_RESET}"
                echo -e "Configuración actual en /etc/default/dropbear:"
                grep -E 'DROPBEAR_PORT|DROPBEAR_EXTRA_ARGS' /etc/default/dropbear 2>/dev/null || true
                echo ""
                local main_p="" extra_p=""
                read -r -p " Puerto principal (ej: 90): " main_p || true
                read -r -p " Puertos adicionales (ej: 109 443): " extra_p || true

                if [[ -n "${main_p:-}" ]]; then
                    sed -i "s/^DROPBEAR_PORT=.*/DROPBEAR_PORT=$main_p/" /etc/default/dropbear
                    local extra_flags=""
                    for p in ${extra_p:-}; do
                        extra_flags+="-p $p "
                    done
                    if [[ -f /etc/vps-ssh-limiter/banner.net ]]; then
                        extra_flags+="-b /etc/vps-ssh-limiter/banner.net "
                    fi
                    extra_flags=$(echo "$extra_flags" | xargs)
                    sed -i "s|^DROPBEAR_EXTRA_ARGS=.*|DROPBEAR_EXTRA_ARGS=\"$extra_flags\"|" /etc/default/dropbear
                    systemctl restart dropbear 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
                    echo -e "${C_GREEN}✔ Puertos de Dropbear actualizados.${C_RESET}"
                fi
                press_enter
                ;;
            3)
                menu_wsproxy
                ;;
            4)
                run_bin ssh-udpgw
                ;;
            5)
                systemctl restart dropbear 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
                echo -e "${C_GREEN}✔ Dropbear reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            6)
                systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
                echo -e "${C_GREEN}✔ OpenSSH reiniciado.${C_RESET}"
                sleep 1.5
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}Opción inválida.${C_RESET}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# ACCIONES RÁPIDAS DEL MENÚ
# ------------------------------------------------------------------------------
restart_all_services() {
    clear
    echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}           ${C_BOLD}${C_WHITE}★ REINICIANDO TODOS LOS SERVICIOS ★${C_RESET}             ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}\n"
    
    local svcs=(ssh sshd dropbear ssh-wsproxy badvpn-udpgw ssh-limiter cron fail2ban)
    for s in "${svcs[@]}"; do
        if systemctl list-unit-files "${s}.service" >/dev/null 2>&1 || is_active "$s"; then
            echo -ne " ● Reiniciando ${C_YELLOW}${s}${C_RESET}..."
            if systemctl restart "$s" 2>/dev/null; then
                echo -e " ${C_GREEN}[OK]${C_RESET}"
            else
                echo -e " ${C_RED}[FALLÓ]${C_RESET}"
            fi
        fi
    done
    echo -e "\n${C_GREEN}${C_BOLD}✔ Proceso de reinicio general completado con éxito.${C_RESET}"
    press_enter
}

menu_cache() {
    clear
    echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}            ${C_BOLD}${C_WHITE}★ LIMPIEZA DE MEMORIA RAM Y CACHÉ ★${C_RESET}            ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}\n"
    echo -e " ${C_CYAN}Liberando memoria caché y buffers del kernel...${C_RESET}"
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    if command -v journalctl >/dev/null 2>&1; then
        echo -e " ${C_CYAN}Purgando registros antiguos de journald...${C_RESET}"
        journalctl --vacuum-time=3d >/dev/null 2>&1 || true
    fi
    echo -e "\n${C_GREEN}${C_BOLD}✔ Memoria RAM optimizada y espacio en disco liberado.${C_RESET}"
    press_enter
}

run_speedtest() {
    clear
    echo -e "${C_CYAN}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}           ${C_BOLD}${C_WHITE}★ TEST DE VELOCIDAD Y RED DEL SERVIDOR ★${C_RESET}        ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰═══════════════════════════════════════════════════════════╯${C_RESET}\n"
    
    if command -v speedtest >/dev/null 2>&1; then
        speedtest
    elif command -v speedtest-cli >/dev/null 2>&1; then
        speedtest-cli --simple
    else
        echo -e " ${C_BOLD}1. Latencia de conexión (Ping a Cloudflare DNS):${C_RESET}"
        ping -c 4 1.1.1.1 2>/dev/null || ping -c 4 8.8.8.8 2>/dev/null || true
        echo -e "\n ${C_BOLD}2. Descarga de prueba (Throughput directo):${C_RESET}"
        curl -s -w ' Velocidad estimada: %{speed_download} B/s | Tiempo total: %{time_total} seg\n' -o /dev/null http://speedtest.tele2.net/10MB.zip || true
    fi
    press_enter
}

# ------------------------------------------------------------------------------
# SUBMENÚ 6: ACTUALIZACIÓN AUTOMÁTICA
# ------------------------------------------------------------------------------
menu_update() {
    clear
    if [[ -x /usr/local/bin/ssh-update ]]; then
        /usr/local/bin/ssh-update --reload-menu
    elif [[ -f "${BASH_SOURCE[0]%/*}/ssh-update" ]]; then
        bash "${BASH_SOURCE[0]%/*}/ssh-update" --reload-menu
    else
        echo -e "${C_CYAN}Descargando e instalando última versión del repositorio...${C_RESET}"
        curl -fsSL "https://raw.githubusercontent.com/sendeiser/tin-script/main/install.sh?v=$(date +%s)" | bash
        press_enter
        exec /usr/local/bin/menu
    fi
}

# ------------------------------------------------------------------------------
# SUBMENÚ 7: DESINSTALACIÓN
# ------------------------------------------------------------------------------
menu_uninstall() {
    clear
    echo -e "\n${C_BOLD}${C_RED}╭═══════════════════════════════════════════════════════════╮${C_RESET}"
    echo -e "${C_BOLD}${C_RED}│             DESINSTALACIÓN DE VPS-SSH-LIMITER             │${C_RESET}"
    echo -e "${C_BOLD}${C_RED}╰═══════════════════════════════════════════════════════════╯${C_RESET}\n"
    echo -e "${C_YELLOW}Esta acción detendrá los servicios y eliminará los binarios y atajos ('menu', 'tin', 'vps')."
    echo -e "Los usuarios existentes NO serán borrados.${C_RESET}\n"

    local conf_del=""
    read -r -p " ¿Está seguro de desinstalar? [s/N]: " conf_del || true
    if [[ "${conf_del:-}" =~ ^[sS]$ ]]; then
        if [[ -f /usr/local/bin/install.sh ]]; then
            /usr/local/bin/install.sh --uninstall
        else
            curl -fsSL "https://raw.githubusercontent.com/sendeiser/tin-script/main/install.sh?v=$(date +%s)" | bash -s -- --uninstall
        fi
        exit 0
    else
        echo -e "${C_CYAN}Desinstalación cancelada.${C_RESET}"
        press_enter
    fi
}

# ------------------------------------------------------------------------------
# Bucle Principal del Menú
# ------------------------------------------------------------------------------
if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "${C_RED}[ERROR]${C_RESET} Debe ejecutar con permisos de superusuario: ${C_BOLD}sudo menu${C_RESET}" >&2
    exit 1
fi

while true; do
    draw_dashboard
    main_opt=""
    read -r -p "  ❱❱❱ Seleccione una opción [0-14]: " main_opt || true

    case "${main_opt:-}" in
        1 | 01) menu_users ;;
        2 | 02) run_bin ssh-trial ;;
        3 | 03) run_bin ssh-udpgw ;;
        4 | 04) menu_monitor ;;
        5 | 05) run_bin ssh-httpcustom ;;
        6 | 06) run_bin ssh-banner ;;
        7 | 07) restart_all_services ;;
        8 | 08) menu_limiter ;;
        9 | 09) menu_ports ;;
        10) menu_cache ;;
        11) run_bin ssh-domain ;;
        12) run_speedtest ;;
        13) menu_update ;;
        14) menu_uninstall ;;
        0 | 00)
            clear
            echo -e "${C_CYAN}Gracias por utilizar ${C_BOLD}vps-ssh-limiter${C_RESET}${C_CYAN}. ¡Hasta pronto!${C_RESET}\n"
            exit 0
            ;;
        x | menu)
            continue
            ;;
        *)
            echo -e "${C_RED} Opción inválida.${C_RESET}"
            sleep 1
            ;;
    esac
done
